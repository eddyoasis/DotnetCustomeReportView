@using Microsoft.AspNetCore.WebUtilities
@using DataWarehousePower.Authorization
@using Microsoft.AspNetCore.Authorization
@using System.Text.Json
@inject IAuthorizationService AuthorizationService
@model DataWarehousePower.Models.DataFileBrowserViewModel
@{
    ViewData["Title"] = "Data Files";
    ViewData["MainContainerClass"] = "container report-page-container";
    var departmentLookup = ViewData["DepartmentLookup"] as Dictionary<int, string> ?? new Dictionary<int, string>();
    var selectedDataFile = Model.SelectedDataFile;
    var canManageReports = (await AuthorizationService.AuthorizeAsync(User, DepartmentAuthorizationPolicies.ReportManageAccess)).Succeeded;

    string BuildDataFileUrl(int dataFileId, string? overrideSchemaTemplate = null, bool includeFilters = true)
    {
        string baseUrl = Url.Action("Index", "DataFile", new { id = dataFileId }) ?? $"/DataFile/Index/{dataFileId}";

        Dictionary<string, string?> queryValues = new(StringComparer.OrdinalIgnoreCase);
        string schemaTemplate = overrideSchemaTemplate ?? Model.SchemaTemplate;
        if (!string.IsNullOrWhiteSpace(schemaTemplate))
        {
            queryValues["schemaTemplate"] = schemaTemplate;
        }

        if (includeFilters)
        {
            if (!string.IsNullOrWhiteSpace(Model.Filter.Search))
            {
                queryValues["search"] = Model.Filter.Search;
            }

            if (Model.Filter.IsActive.HasValue)
            {
                queryValues["isActive"] = Model.Filter.IsActive.Value.ToString().ToLowerInvariant();
            }

            if (!string.IsNullOrWhiteSpace(Model.ClientCode))
            {
                queryValues["clientCode"] = Model.ClientCode;
            }

            if (Model.FilterDateFrom.HasValue)
            {
                queryValues["dateFrom"] = Model.FilterDateFrom.Value.ToString("yyyy-MM-dd");
            }

            if (Model.FilterDateTo.HasValue)
            {
                queryValues["dateTo"] = Model.FilterDateTo.Value.ToString("yyyy-MM-dd");
            }
        }

        return queryValues.Count == 0 ? baseUrl : QueryHelpers.AddQueryString(baseUrl, queryValues);
    }

    string GetDepartmentLabel(string? departments)
    {
        if (string.IsNullOrWhiteSpace(departments))
        {
            return "All";
        }

        var tokens = departments.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var displayNames = tokens
            .Select(token => int.TryParse(token, out int id)
                ? (departmentLookup.TryGetValue(id, out var name) ? name : $"Unknown ({id})")
                : token)
            .ToList();

        return string.Join(", ", displayNames);
    }
}

<div class="row">
    <div class="col-md-2 pe-0">
        <div class="card shadow-sm h-100 d-flex flex-column">
            <div class="card-header fw-semibold small">Data Files</div>
            <div class="p-2 border-bottom">
                <form asp-action="Index" method="get" class="row g-2">
                    <div class="col-12">
                        <input id="report-sidebar-filter"
                               type="text"
                               class="form-control form-control-sm"
                               maxlength="128"
                               placeholder="Filter data files"
                               autocomplete="off" />
                    </div>
                </form>
            </div>
            <div class="flex-grow-1 overflow-auto">
                <ul class="list-group list-group-flush">
                    @foreach (var dataFile in Model.DataFiles)
                    {
                        <li class="report-sidebar-item list-group-item list-group-item-action p-2 @(selectedDataFile?.Id == dataFile.Id ? "active" : "")"
                            data-report-name="@dataFile.DataFileName">
                            <a href="@BuildDataFileUrl(dataFile.Id)"
                               class="text-decoration-none d-block @(selectedDataFile?.Id == dataFile.Id ? "text-white" : "")" 
                               style="font-size:.85rem;">
                                @dataFile.DataFileName
                            </a>
                        </li>
                    }
                </ul>
                <div id="report-sidebar-empty" class="text-muted small px-2 py-2 d-none">No matching data files.</div>
            </div>
        </div>
    </div>

    <div class="col-md-10">
        @if (selectedDataFile is null)
        {
            <div class="alert alert-info">No data file is selected.</div>
        }
        else
        {
            <div class="mb-2 d-flex justify-content-between align-items-start gap-3 flex-wrap">
                <div>
                    <h4 class="mb-1">@selectedDataFile.DataFileName</h4>
                    <div class="text-muted small">Browse the source definition, columns, and allowed departments.</div>
                </div>
                <div class="d-flex gap-2">
                    <a asp-controller="DataFileManage" asp-action="Edit" asp-route-id="@selectedDataFile.Id" class="btn btn-outline-secondary btn-sm">Manage</a>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body py-2 px-3">
                    <label for="schema-template-select" class="form-label small fw-semibold mb-1">Schema Template</label>
                    <div class="d-flex gap-2 align-items-center flex-nowrap flex-wrap">
                        <select id="schema-template-select" class="d-none" aria-hidden="true">
                            <option value="">Default</option>
                            @foreach (var availableSchemaTemplate in Model.AvailableSchemaTemplates)
                            {
                                <option value="@availableSchemaTemplate" selected="@(availableSchemaTemplate.Equals(Model.SchemaTemplate, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@availableSchemaTemplate</option>
                            }
                        </select>

                        <div class="dropdown flex-grow-1">
                            <button id="schema-template-dropdown-toggle"
                                    class="btn btn-sm btn-outline-secondary dropdown-toggle w-100 text-start"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    data-bs-auto-close="outside"
                                    aria-expanded="false">
                                Default
                            </button>
                            <div class="dropdown-menu p-2 w-100" style="min-width: 260px;">
                                <input id="schema-template-search"
                                       type="text"
                                       class="form-control form-control-sm mb-2"
                                       maxlength="128"
                                       placeholder="Search schema template"
                                       autocomplete="off" />
                                <div id="schema-template-options" class="list-group list-group-flush" style="max-height: 220px; overflow-y: auto;"></div>
                            </div>
                        </div>

                        <button id="btn-schema-apply" type="button" class="btn btn-sm btn-outline-primary">Load</button>
                        <button id="btn-schema-clear" type="button" class="btn btn-sm btn-outline-secondary">Clear</button>
                        <button id="btn-schema-rename" type="button" class="btn btn-sm btn-outline-warning">Rename</button>
                        <button id="btn-schema-delete" type="button" class="btn btn-sm btn-outline-danger">Delete</button>

                        <input id="schema-template-new"
                               type="text"
                               class="form-control form-control-sm"
                               maxlength="128"
                               placeholder="Create new schema template"
                               style="max-width: 260px;" />
                        <button id="btn-schema-create" type="button" class="btn btn-sm btn-primary">Use New</button>
                    </div>
                    <div id="schema-template-error" class="text-danger small mt-1" style="display:none;"></div>
                </div>
            </div>

            <div hidden id="schema-template-status" class="alert alert-light border small py-2 px-3 mb-3">
                Preference scope:
                <strong>@(string.IsNullOrWhiteSpace(Model.SchemaTemplate) ? "Default" : Model.SchemaTemplate)</strong>
            </div>

            @if (!Model.HasAppliedFilters)
            {
                <div class="alert alert-info border small py-2 px-3 mb-3">
                    Select a client code and click Apply to load report data.
                </div>
            }

            <div class="card mb-3 shadow-sm">
                <div class="card-header fw-semibold">Date Filters</div>
                <div class="card-body">
                    <form id="datafile-filter-form" method="get" action="@Url.Action("Index", "DataFile", new { id = selectedDataFile.Id })" class="row g-3 align-items-end">
                        <input type="hidden" id="filter-schema-template" name="schemaTemplate" value="@Model.SchemaTemplate" />
                        @if (!string.IsNullOrWhiteSpace(Model.Filter.Search))
                        {
                            <input type="hidden" name="search" value="@Model.Filter.Search" />
                        }
                        @if (Model.Filter.IsActive.HasValue)
                        {
                            <input type="hidden" name="isActive" value="@Model.Filter.IsActive.Value.ToString().ToLowerInvariant()" />
                        }

                        <div class="col-md-3 d-flex flex-column gap-1">
                            <label for="filter-client-code" class="form-label small fw-semibold">ClientCode</label>
                            <select id="filter-client-code"
                                    name="clientCode"
                                    class="form-select form-select-sm"
                                    required>
                                <option value="">All client codes</option>
                                @foreach (var availableClientCode in Model.AvailableClientCodes)
                                {
                                    <option value="@availableClientCode" selected="@(availableClientCode.Equals(Model.ClientCode, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@availableClientCode</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-3 d-flex flex-column gap-1">
                            <label for="filter-date-from" class="form-label small fw-semibold">DateFrom</label>
                            <input id="filter-date-from"
                                   name="dateFrom"
                                   type="date"
                                   class="form-control form-control-sm"
                                   value="@((Model.FilterDateFrom ?? DateTime.Today).ToString("yyyy-MM-dd"))" />
                        </div>

                        <div class="col-md-3 d-flex flex-column gap-1">
                            <label for="filter-date-to" class="form-label small fw-semibold">DateTo</label>
                            <input id="filter-date-to"
                                   name="dateTo"
                                   type="date"
                                   class="form-control form-control-sm"
                                   value="@((Model.FilterDateTo ?? DateTime.Today).ToString("yyyy-MM-dd"))" />
                        </div>

                        <div class="col-md-3 d-flex gap-2 align-self-end">
                            <button id="btn-filter-apply" type="submit" class="btn btn-sm btn-primary w-100">Apply</button>
                            <a class="btn btn-sm btn-outline-secondary w-100"
                               href="@BuildDataFileUrl(selectedDataFile.Id, null, false)">Clear</a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-lg-12">
                    <div class="card shadow-sm mb-3">
                        <div class="card-header fw-semibold d-flex align-items-center justify-content-between">
                            <span>Export</span>
                            <button class="btn btn-sm btn-link p-0 text-decoration-none text-muted"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#export-card-body"
                                    aria-expanded="false"
                                    aria-controls="export-card-body">
                                &#9660;
                            </button>
                        </div>
                        <div id="export-card-body" class="collapse">
                        <div class="card-body">
                            <div class="row g-2 align-items-end">
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold" for="export-format-csv">Formats</label>
                                    <div id="export-format" class="d-flex flex-column gap-1">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="export-format-csv" value="csv" checked />
                                            <label class="form-check-label" for="export-format-csv">CSV</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="export-format-excel" value="excel" />
                                            <label class="form-check-label" for="export-format-excel">Excel (.xlsx)</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="export-format-pdf" value="pdf" />
                                            <label class="form-check-label" for="export-format-pdf">PDF</label>
                                        </div>
                                    </div>
                                    <div class="form-text">Select one or more formats.</div>
                                </div>
                                <div class="col-md-8 d-flex gap-2">
                                    <button id="btn-export" type="button" class="btn btn-sm btn-success">Export as Password ZIP</button>
                                    <a id="schedule-datafile-link" 
                                        asp-action="ScheduleDataFile" 
                                        asp-route-id="@selectedDataFile.Id" 
                                        asp-route-schemaTemplate="@Model.SchemaTemplate"
                                           asp-route-clientCode="@Model.ClientCode"
                                           class="btn btn-outline-primary btn-sm">Schedule Data File</a>
                                    <span id="export-status" class="small align-self-center"></span>
                                </div>
                            </div>
                            <div class="text-muted small mt-2">
                                Choose one or more formats, set a strong password, and download the data file as a protected ZIP.
                            </div>
                        </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div hidden class="col-lg-5">
                            <div class="card shadow-sm mb-3">
                                <div class="card-header fw-semibold">Data File Details</div>
                                <div class="card-body">
                                    <dl class="row mb-0 small">
                                        <dt class="col-5">Source Database</dt>
                                        <dd class="col-7">@(string.IsNullOrWhiteSpace(selectedDataFile.SourceDatabase) ? "-" : selectedDataFile.SourceDatabase)</dd>

                                        <dt class="col-5">Source Table</dt>
                                        <dd class="col-7">@(string.IsNullOrWhiteSpace(selectedDataFile.SourceTable) ? "-" : selectedDataFile.SourceTable)</dd>

                                        <dt class="col-5">Source SP</dt>
                                        <dd class="col-7">@(string.IsNullOrWhiteSpace(selectedDataFile.SourceSP) ? "-" : selectedDataFile.SourceSP)</dd>

                                        <dt class="col-5">Departments</dt>
                                        <dd class="col-7">@GetDepartmentLabel(selectedDataFile.Departments)</dd>

                                        <dt class="col-5">Created</dt>
                                        <dd class="col-7">@selectedDataFile.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

                                        <dt class="col-5">Modified</dt>
                                        <dd class="col-7">@(selectedDataFile.ModifiedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</dd>
                                    </dl>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-12">
                            <div class="card mb-4 shadow-sm @(Model.SchemaTemplate == "" ? "disabled-div" : "")" aria-disabled=@(Model.SchemaTemplate == "")>
                                <div class="card-header fw-semibold d-flex align-items-center justify-content-between">
                                    Column Customiser
                                    <span class="text-muted">
                                        (Please create or select any template other than Default to adjust column)
                                    </span>
                                    <button class="btn btn-sm btn-link p-0 text-decoration-none text-muted"
                                            type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#column-customiser-card-body"
                                            aria-expanded="false"
                                            aria-controls="column-customiser-card-body">
                                        &#9660;
                                    </button>
                                </div>
                                <div id="column-customiser-card-body" class="collapse">
                                <div class="card-body">
                                    <p class="text-muted small mb-3">
                                        Drag chips to reorder &nbsp;|&nbsp;
                                        The <span class="badge bg-light text-secondary border" style="font-size:.7rem;">grey badge</span>
                                        shows the original column name &nbsp;→&nbsp; type in the box to rename it &nbsp;|&nbsp;
                                        Use the checkbox to show/hide. Toggle auto-save on/off as needed, or click <strong>Save &amp; Apply</strong>.
                                    </p>

                                    <ul id="sortable-columns" class="list-unstyled d-flex flex-wrap gap-2 mb-3" style="min-height:48px;">
                                        @{
                                            var visible = Model.DisplayColumns.Where(c => c.IsVisible).OrderBy(c => c.Order).ToList();
                                            var hiddenCols = Model.AvailableColumns
                                            .Where(sys => !visible.Any(v => v.Key == sys.Key))
                                            .Select(sys => new DataWarehousePower.Models.ColumnDefinition
                                            {
                                                Key = sys.Key,
                                                DefaultLabel = sys.DefaultLabel,
                                                DisplayLabel = sys.DefaultLabel,
                                                IsVisible = false,
                                                Order = 999
                                            });
                                            var allChips = visible.Concat(hiddenCols).ToList();
                                        }
                                        @foreach (var col in allChips)
                                        {
                                            <li class="chip border rounded px-2 py-1 bg-white shadow-sm d-flex align-items-center gap-2 @(col.IsVisible ? "" : "opacity-50")"
                                                data-key="@col.Key"
                                                data-default-label="@col.DefaultLabel"
                                                draggable="true"
                                                style="cursor:grab; user-select:none;">
                                                <span class="drag-handle text-muted" style="cursor:grab;">&#9776;</span>
                                                <span class="badge bg-light text-secondary border"
                                                      style="font-size:.7rem; white-space:nowrap;"
                                                      title="Original column name">@col.DefaultLabel</span>
                                                <span class="text-muted" style="font-size:.8rem;">→</span>
                                                <input type="text"
                                                       class="form-control form-control-sm label-input border-0 p-0"
                                                       style="width:110px; background:transparent;"
                                                       value="@col.DisplayLabel"
                                                       maxlength="100"
                                                       placeholder="@col.DefaultLabel"
                                                       title="Display name (original: @col.DefaultLabel)"
                                                       aria-label="Display label for @col.DefaultLabel" />
                                                <input type="checkbox"
                                                       class="form-check-input m-0 col-visible-toggle"
                                                @(col.IsVisible ? "checked" : "")
                                                       title="Show / hide column"
                                                       aria-label="Show @col.DefaultLabel" />
                                            </li>
                                        }
                                    </ul>

                                    <div id="label-error" class="text-danger small mb-2" style="display:none;"></div>
                                    <div class="d-flex gap-2 flex-wrap">
                                        <button id="btn-apply" type="button" class="btn btn-primary btn-sm">Save &amp; Apply</button>
                                        <button id="btn-reset" type="button" class="btn btn-outline-secondary btn-sm">Reset to Defaults</button>
                                        <div class="form-check form-switch align-self-center ms-2">
                                            <input id="auto-save-toggle" class="form-check-input" type="checkbox" />
                                            <label class="form-check-label small" for="auto-save-toggle">Auto-save</label>
                                        </div>
                                        <span id="save-status" class="small align-self-center ms-1"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                </div>
            </div>

            <form id="preview-antiforgery-form" class="d-none">
                @Html.AntiForgeryToken()
            </form>

            <div class="modal fade" id="export-password-modal" tabindex="-1" aria-labelledby="export-password-title" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="export-password-title">Export Password</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <label for="export-password-input" class="form-label small fw-semibold">ZIP Password</label>
                            <input id="export-password-input"
                                   type="password"
                                   class="form-control"
                                   maxlength="128"
                                   autocomplete="new-password"
                                   placeholder="Enter strong password" />
                            <div class="form-text">
                                Minimum 8 characters with uppercase, lowercase, number, and symbol.
                            </div>
                            <div id="export-password-error" class="text-danger small mt-2" style="display:none;"></div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button id="btn-export-confirm" type="button" class="btn btn-success">Export</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="col-md-12">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
            <div class="small text-muted">
                @if (!string.IsNullOrWhiteSpace(Model.ClientCode))
                {
                    <span id="preview-data-summary">No data loaded yet.</span>
                }
                else
                {
                    <span id="preview-data-summary">Select a client code and click Apply to view data.</span>
                }
            </div>
            <div class="d-flex align-items-center gap-2">
                <label for="preview-page-size" class="small text-muted mb-0">Rows per page</label>
                <select id="preview-page-size" class="form-select form-select-sm" style="width: 92px;">
                    <option value="10" selected>10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
                <button hidden id="btn-preview-data" type="button" class="btn btn-outline-primary btn-sm">Refresh</button>
                <span id="preview-status" class="small text-muted">Loading latest preview data.</span>
            </div>
        </div>

        <div id="preview-table-container" class="table-responsive shadow-sm position-relative" aria-busy="false">
            <table class="table table-bordered table-hover align-middle" id="report-table">
                <colgroup id="table-colgroup"></colgroup>
                <thead class="table-dark">
                    <tr id="table-header-row"></tr>
                </thead>
                <tbody id="table-body" style="font-size: 0.85rem;">
                    <tr>
                        <td id="preview-table-placeholder" class="text-muted text-center py-4">No data loaded yet.</td>
                    </tr>
                </tbody>
            </table>
            <div id="preview-loading-overlay" class="preview-loading-overlay d-none" role="status" aria-live="polite">
                <div class="d-flex align-items-center gap-2 bg-white border rounded px-3 py-2 shadow-sm">
                    <div class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></div>
                    <span class="small text-muted">Loading data...</span>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-2 flex-wrap gap-2">
            <div id="preview-page-info" class="small text-muted">Page 1 of 1</div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <form id="preview-page-jump-form" class="d-flex align-items-center gap-2">
                    <label for="preview-page-jump" class="small text-muted mb-0">Go to</label>
                    <input id="preview-page-jump"
                           type="number"
                           class="form-control form-control-sm"
                           style="width: 88px;"
                           min="1"
                           value="1" />
                    <button id="preview-page-jump-btn" type="submit" class="btn btn-sm btn-outline-secondary">Go</button>
                </form>

                <div class="btn-group" role="group" aria-label="Preview pagination">
                    <button id="preview-page-first" type="button" class="btn btn-sm btn-outline-secondary" disabled>First</button>
                    <button id="preview-page-prev" type="button" class="btn btn-sm btn-outline-secondary" disabled>Previous</button>
                    <button id="preview-page-next" type="button" class="btn btn-sm btn-outline-secondary" disabled>Next</button>
                    <button id="preview-page-last" type="button" class="btn btn-sm btn-outline-secondary" disabled>Last</button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .disabled-div {
        pointer-events: none; /* blocks clicks, links, buttons inside */
        opacity: 0.5; /* faded look */
        user-select: none; /* prevents text selection */
    }

    #report-table {
        table-layout: fixed;
        width: 100%;
    }

    #report-table th,
    #report-table td {
        overflow-wrap: anywhere;
        word-break: break-word;
        white-space: normal;
    }

    #preview-table-container.preview-loading {
        pointer-events: none;
        user-select: none;
    }

    .preview-loading-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.55);
        z-index: 10;
    }
</style>

@section Scripts {
@if (selectedDataFile is not null)
{
    <script>
        (function () {
            const reportId = @selectedDataFile.Id;
            const previewUrl = '@Url.Action("Preview", "DataFileManage")';
            const savePreferencesUrl = '@Url.Action("SavePreferences", "DataFile", new { id = selectedDataFile.Id })';
            const updateSchemaTemplateUrl = '@Url.Action("UpdateSchemaTemplate", "DataFile", new { id = selectedDataFile.Id })';
            const deleteSchemaTemplateUrl = '@Url.Action("DeleteSchemaTemplate", "DataFile", new { id = selectedDataFile.Id })';
            const sourceDatabase = @Html.Raw(JsonSerializer.Serialize(selectedDataFile.SourceDatabase));
            const sourceTable = @Html.Raw(JsonSerializer.Serialize(selectedDataFile.SourceTable));
            const sourceSP = @Html.Raw(JsonSerializer.Serialize(selectedDataFile.SourceSP));
            const previewColumns = @Html.Raw(JsonSerializer.Serialize(
                selectedDataFile.Columns
                    .OrderBy(column => column.DisplayOrder)
                    .Select(column => new
                    {
                        propertyName = column.PropertyName,
                        defaultLabel = column.DefaultLabel,
                        mappingParameter = column.MappingParameter,
                        mappingParameterFilter = column.MappingParameterFilter
                    })
                    .ToList()));
            const initialSchemaTemplate = @Html.Raw(JsonSerializer.Serialize(Model.SchemaTemplate));
            const initialPreferenceId = @Html.Raw(JsonSerializer.Serialize(Model.ActivePreferenceId));
            const schemaTemplatePreferenceIds = @Html.Raw(JsonSerializer.Serialize(Model.SchemaTemplatePreferenceIds));
            const shouldAutoLoadPreview = @Html.Raw(JsonSerializer.Serialize(Model.HasAppliedFilters));
