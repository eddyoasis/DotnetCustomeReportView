            const previewTableContainer = document.getElementById('preview-table-container');
            const previewLoadingOverlay = document.getElementById('preview-loading-overlay');
            const pageInfo = document.getElementById('preview-page-info');
            const pageJumpForm = document.getElementById('preview-page-jump-form');
            const pageJumpInput = document.getElementById('preview-page-jump');
            const pageJumpButton = document.getElementById('preview-page-jump-btn');
            const pageFirstButton = document.getElementById('preview-page-first');
            const pagePrevButton = document.getElementById('preview-page-prev');
            const pageNextButton = document.getElementById('preview-page-next');
            const pageLastButton = document.getElementById('preview-page-last');
            const reportSidebarFilter = document.getElementById('report-sidebar-filter');
            const reportSidebarEmpty = document.getElementById('report-sidebar-empty');
            const schemaTemplateSearchInput = document.getElementById('schema-template-search');
            const schemaTemplateDropdownToggle = document.getElementById('schema-template-dropdown-toggle');
            const schemaTemplateOptions = document.getElementById('schema-template-options');
            const schemaTemplateSelect = document.getElementById('schema-template-select');
            const schemaTemplateNewInput = document.getElementById('schema-template-new');
            const schemaApplyButton = document.getElementById('btn-schema-apply');
            const schemaClearButton = document.getElementById('btn-schema-clear');
            const schemaRenameButton = document.getElementById('btn-schema-rename');
            const schemaDeleteButton = document.getElementById('btn-schema-delete');
            const schemaCreateButton = document.getElementById('btn-schema-create');
            const schemaTemplateError = document.getElementById('schema-template-error');
            const schemaTemplateStatus = document.getElementById('schema-template-status');
            const sortable = document.getElementById('sortable-columns');
            const autoSaveToggle = document.getElementById('auto-save-toggle');
            const saveStatus = document.getElementById('save-status');
            const labelError = document.getElementById('label-error');
            const exportUrl = '@Url.Action("Export", "DataFile", new { id = selectedDataFile.Id })';
            const exportButton = document.getElementById('btn-export');
            const exportFormatContainer = document.getElementById('export-format');
            const exportStatus = document.getElementById('export-status');
            const filterForm = document.getElementById('datafile-filter-form');
            const filterClientCodeInput = document.getElementById('filter-client-code');
            const filterDateFromInput = document.getElementById('filter-date-from');
            const filterDateToInput = document.getElementById('filter-date-to');
            const scheduleDataFileLink = document.getElementById('schedule-datafile-link');
            const exportPasswordModalElement = document.getElementById('export-password-modal');
            const exportPasswordInput = document.getElementById('export-password-input');
            const exportPasswordError = document.getElementById('export-password-error');
            const exportConfirmButton = document.getElementById('btn-export-confirm');
            const exportPasswordModal = new bootstrap.Modal(exportPasswordModalElement);

            let activePreferenceId = initialPreferenceId;
            let autoSaveTimer = null;
            let isAutoSaveEnabled = false;
            let previewRows = [];
            let previewTotalRows = 0;
            let previewCurrentPage = 1;
            const autoSaveStorageKey = `datafile:${reportId}:columnAutoSave`;

            try {
                const persistedAutoSave = localStorage.getItem(autoSaveStorageKey);
                if (persistedAutoSave !== null) {
                    isAutoSaveEnabled = persistedAutoSave === 'true';
                }
            } catch {
                // Ignore storage access issues and keep the default setting.
            }

            if (autoSaveToggle) {
                autoSaveToggle.checked = isAutoSaveEnabled;
                autoSaveToggle.addEventListener('change', () => {
                    isAutoSaveEnabled = autoSaveToggle.checked;

                    if (!isAutoSaveEnabled && autoSaveTimer) {
                        clearTimeout(autoSaveTimer);
                        autoSaveTimer = null;
                    }

                    try {
                        localStorage.setItem(autoSaveStorageKey, String(isAutoSaveEnabled));
                    } catch {
                        // Ignore storage access issues.
                    }
                });
            }

            function esc(value) {
                return String(value)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;');
            }

            function getCurrentPreviewPageSize() {
                const parsed = Number.parseInt(pageSizeInput?.value || '10', 10);
                if (parsed === 10 || parsed === 25 || parsed === 50 || parsed === 100) {
                    return parsed;
                }

                return 10;
            }

            function renderPreviewPlaceholder(message) {
                head.innerHTML = '';
                body.innerHTML = '';
                if (colgroup) {
                    colgroup.innerHTML = '';
                }

                const row = document.createElement('tr');
                const cell = document.createElement('td');
                cell.className = 'text-muted text-center py-4';
                cell.colSpan = 1;
                cell.textContent = message;
                row.appendChild(cell);
                body.appendChild(row);

                if (summary) {
                    summary.textContent = message;
                }

                if (pageInfo) {
                    pageInfo.textContent = 'Page 1 of 1';
                }

                if (pagePrevButton) {
                    pagePrevButton.disabled = true;
                }

                if (pageNextButton) {
                    pageNextButton.disabled = true;
                }

                if (pageFirstButton) {
                    pageFirstButton.disabled = true;
                }

                if (pageLastButton) {
                    pageLastButton.disabled = true;
                }

                if (pageJumpInput) {
                    pageJumpInput.value = '1';
                    pageJumpInput.min = '1';
                    pageJumpInput.max = '1';
                    pageJumpInput.disabled = true;
                }

                if (pageJumpButton) {
                    pageJumpButton.disabled = true;
                }
            }

            function getColumnsFromChips() {
                if (!sortable) {
                    return [];
                }

                return [...sortable.querySelectorAll('li.chip')]
                    .map((chip, index) => ({
                        key: chip.dataset.key || '',
                        isVisible: chip.querySelector('.col-visible-toggle')?.checked ?? true,
                        order: index + 1,
                        displayLabel: chip.querySelector('.label-input')?.value.trim() || chip.dataset.defaultLabel || ''
                    }))
                    .filter(column => column.key.length > 0);
            }

            function renderPreviewTable(columnDefinitions, rows) {
                head.innerHTML = '';
                body.innerHTML = '';

                if (!Array.isArray(columnDefinitions) || columnDefinitions.length === 0) {
                    renderPreviewPlaceholder('No visible columns are selected in this schema template.');
                    return;
                }

                if (colgroup) {
                    const widthPercent = (100 / columnDefinitions.length).toFixed(4);
                    colgroup.innerHTML = columnDefinitions
                        .map(() => `<col style="width:${widthPercent}%">`)
                        .join('');
                }

                columnDefinitions.forEach(column => {
                    const th = document.createElement('th');
                    th.textContent = column.label;
                    head.appendChild(th);
                });

                (Array.isArray(rows) ? rows : []).forEach(row => {
                    const tr = document.createElement('tr');
                    columnDefinitions.forEach(column => {
                        const td = document.createElement('td');
                        const value = row?.[column.key];
                        td.textContent = value === null || value === undefined ? '' : String(value);
                        tr.appendChild(td);
                    });
                    body.appendChild(tr);
                });
            }

            function renderPreviewFromCurrentState() {
                const visibleColumns = getColumnsFromChips()
                    .filter(column => column.isVisible)
                    .sort((left, right) => left.order - right.order);

                if (!visibleColumns.length) {
                    renderPreviewPlaceholder('No visible columns are selected in this schema template.');
                    setPreviewStatus('No visible columns are selected in this schema template.', true);
                    return;
                }

                const pageSize = getCurrentPreviewPageSize();
                const totalRows = previewTotalRows;
                const totalPages = Math.max(1, Math.ceil(totalRows / pageSize));
                previewCurrentPage = Math.min(Math.max(1, previewCurrentPage), totalPages);

                const startIndex = totalRows === 0 ? 0 : (previewCurrentPage - 1) * pageSize;
                const endIndex = totalRows === 0 ? 0 : Math.min(startIndex + previewRows.length, totalRows);
                const pageRows = previewRows;

                renderPreviewTable(
                    visibleColumns.map(column => ({ key: column.key, label: column.displayLabel })),
                    pageRows);

                if (totalRows === 0 || pageRows.length === 0) {
                    renderPreviewPlaceholder('No rows were returned for the selected source.');
                }

                if (summary) {
                    if (totalRows > 0 && pageRows.length > 0) {
                        const startRow = startIndex + 1;
                        const endRow = endIndex;
                        summary.textContent = `Showing ${startRow} to ${endRow} of ${totalRows} records`;
                    } else {
                        summary.textContent = 'No data loaded yet.';
                    }
                }

                if (pageInfo) {
                    pageInfo.textContent = `Page ${previewCurrentPage} of ${totalPages}`;
                }

                if (pageFirstButton) {
                    pageFirstButton.disabled = previewCurrentPage <= 1;
                }

                if (pagePrevButton) {
                    pagePrevButton.disabled = previewCurrentPage <= 1;
                }

                if (pageNextButton) {
                    pageNextButton.disabled = previewCurrentPage >= totalPages;
                }

                if (pageLastButton) {
                    pageLastButton.disabled = previewCurrentPage >= totalPages;
                }

                if (pageJumpInput) {
                    pageJumpInput.min = '1';
                    pageJumpInput.max = String(totalPages);
                    pageJumpInput.value = String(previewCurrentPage);
                    pageJumpInput.disabled = totalRows === 0;
                }

                if (pageJumpButton) {
                    pageJumpButton.disabled = totalRows === 0;
                }
            }

            function setPreviewStatus(message, isError) {
                status.textContent = message;
                status.classList.toggle('text-danger', !!isError);
                status.classList.toggle('text-muted', !isError);
            }

            function setPreviewLoading(isLoading) {
                if (previewTableContainer) {
                    previewTableContainer.classList.toggle('preview-loading', !!isLoading);
                    previewTableContainer.setAttribute('aria-busy', isLoading ? 'true' : 'false');
                }

                if (previewLoadingOverlay) {
                    previewLoadingOverlay.classList.toggle('d-none', !isLoading);
                }
            }

            function filterSidebarReports() {
                if (!reportSidebarFilter) {
                    return;
                }

                const query = reportSidebarFilter.value.trim().toLocaleLowerCase();
                const reportItems = [...document.querySelectorAll('.report-sidebar-item')];
                let visibleCount = 0;

                reportItems.forEach(item => {
                    const reportName = (item.getAttribute('data-report-name') || '').toLocaleLowerCase();
                    const isVisible = !query || reportName.includes(query);
                    item.classList.toggle('d-none', !isVisible);
                    if (isVisible) {
                        visibleCount += 1;
                    }
                });

                if (reportSidebarEmpty) {
                    reportSidebarEmpty.classList.toggle('d-none', visibleCount > 0);
                }
            }

            function clearSchemaTemplateError() {
                if (!schemaTemplateError) {
                    return;
                }

                schemaTemplateError.textContent = '';
                schemaTemplateError.style.display = 'none';
            }

            function showSchemaTemplateError(message) {
                if (!schemaTemplateError) {
                    return;
                }

                schemaTemplateError.textContent = message;
                schemaTemplateError.style.display = 'block';
            }

            function hideSchemaTemplateError() {
                clearSchemaTemplateError();
            }

            function getPreferenceIdForSchemaTemplate(schemaTemplate) {
                const normalized = schemaTemplate.trim();
                if (!normalized) {
                    return null;
                }

                const exactKey = Object.keys(schemaTemplatePreferenceIds).find(key =>
                    key.localeCompare(normalized, undefined, { sensitivity: 'accent' }) === 0);

                return typeof exactKey === 'string' ? schemaTemplatePreferenceIds[exactKey] : null;
            }

            function syncSchemaTemplateUi(value) {
                const normalizedValue = value.trim();

                if (schemaTemplateSelect) {
                    schemaTemplateSelect.value = normalizedValue;
                }
                if (schemaTemplateNewInput) {
                    schemaTemplateNewInput.value = normalizedValue;
                }

                activePreferenceId = getPreferenceIdForSchemaTemplate(normalizedValue);

                if (schemaTemplateDropdownToggle) {
                    schemaTemplateDropdownToggle.textContent = normalizedValue || 'Default';
                }

                renderSchemaTemplateOptions(schemaTemplateSearchInput?.value || '');

                if (schemaTemplateStatus) {
                    schemaTemplateStatus.innerHTML = `Preference scope: <strong>${esc(normalizedValue || 'Default')}</strong>`;
                }

                syncScheduleLink();
            }

            function upsertSchemaTemplateOption(value, preferenceId) {
                const normalizedValue = value.trim();
                if (!normalizedValue || !schemaTemplateSelect) {
                    return;
                }

                if (typeof preferenceId === 'number') {
                    Object.keys(schemaTemplatePreferenceIds)
                        .filter(key => key.localeCompare(normalizedValue, undefined, { sensitivity: 'accent' }) === 0 && key !== normalizedValue)
                        .forEach(key => delete schemaTemplatePreferenceIds[key]);
                    schemaTemplatePreferenceIds[normalizedValue] = preferenceId;
                }

                const existingOption = [...schemaTemplateSelect.options].find(option =>
                    option.value.localeCompare(normalizedValue, undefined, { sensitivity: 'accent' }) === 0);

                if (existingOption) {
                    existingOption.value = normalizedValue;
                    existingOption.textContent = normalizedValue;
                    return;
                }

                const newOption = document.createElement('option');
                newOption.value = normalizedValue;
                newOption.textContent = normalizedValue;
                schemaTemplateSelect.appendChild(newOption);
                renderSchemaTemplateOptions(schemaTemplateSearchInput?.value || '');
            }

            function removeSchemaTemplateOption(value) {
                const normalizedValue = value.trim();
                if (!normalizedValue || !schemaTemplateSelect) {
                    return;
                }

                const option = [...schemaTemplateSelect.options].find(item =>
                    item.value.localeCompare(normalizedValue, undefined, { sensitivity: 'accent' }) === 0);

                if (option) {
                    option.remove();
                }
            }

            function renderSchemaTemplateOptions(searchValue) {
                if (!schemaTemplateOptions || !schemaTemplateSelect) {
                    return;
                }

                const normalizedSearch = searchValue.trim().toLocaleLowerCase();
                const selectedValue = schemaTemplateSelect.value;
                schemaTemplateOptions.innerHTML = '';

                [...schemaTemplateSelect.options].forEach((option, index) => {
                    const isDefault = index === 0;
                    const isMatch = !normalizedSearch || option.text.toLocaleLowerCase().includes(normalizedSearch);
                    const isSelected = option.value.localeCompare(selectedValue, undefined, { sensitivity: 'accent' }) === 0;
                    if (!(isDefault || isMatch || isSelected)) {
                        return;
                    }

                    const optionButton = document.createElement('button');
                    optionButton.type = 'button';
                    optionButton.className = `list-group-item list-group-item-action py-1 px-2${isSelected ? ' active' : ''}`;
                    optionButton.textContent = option.text;
                    optionButton.addEventListener('click', () => {
                        hideSchemaTemplateError();
                        schemaTemplateSelect.value = option.value;
                        syncSchemaTemplateUi(option.value);
                        navigateToSchemaTemplate(option.value);
                    });
                    schemaTemplateOptions.appendChild(optionButton);
                });

                if (!schemaTemplateOptions.children.length) {
                    const empty = document.createElement('div');
                    empty.className = 'text-muted small px-2 py-1';
                    empty.textContent = 'No matches';
                    schemaTemplateOptions.appendChild(empty);
                }
            }

            function navigateToSchemaTemplate(value) {
                const trimmed = value.trim();
                const url = new URL(window.location.href);

                if (trimmed) {
                    url.searchParams.set('schemaTemplate', trimmed);
                } else {
                    url.searchParams.delete('schemaTemplate');
                }

                window.location.href = url.toString();
            }

            function syncScheduleLink() {
                if (!scheduleDataFileLink) {
                    return;
                }

                const scheduleUrl = new URL(scheduleDataFileLink.href, window.location.origin);
                const returnUrl = new URL(window.location.href);
                const activeSchemaTemplate = getActiveSchemaTemplate();

                if (activeSchemaTemplate) {
                    scheduleUrl.searchParams.set('schemaTemplate', activeSchemaTemplate);
                } else {
                    scheduleUrl.searchParams.delete('schemaTemplate');
                }

                if (filterClientCodeInput?.value) {
                    scheduleUrl.searchParams.set('clientCode', filterClientCodeInput.value);
                } else {
                    scheduleUrl.searchParams.delete('clientCode');
                }

                if (filterClientCodeInput?.value) {
                    returnUrl.searchParams.set('clientCode', filterClientCodeInput.value);
                } else {
                    returnUrl.searchParams.delete('clientCode');
                }

                if (filterDateFromInput?.value) {
                    returnUrl.searchParams.set('dateFrom', filterDateFromInput.value);
                } else {
                    returnUrl.searchParams.delete('dateFrom');
                }

                if (filterDateToInput?.value) {
                    returnUrl.searchParams.set('dateTo', filterDateToInput.value);
                } else {
                    returnUrl.searchParams.delete('dateTo');
                }

                scheduleUrl.searchParams.set('returnUrl', `${returnUrl.pathname}${returnUrl.search}`);
                scheduleDataFileLink.href = scheduleUrl.toString();
            }

            function buildColumnsFromChips(chips) {
                return chips.map((chip, index) => ({
                    key: chip.dataset.key,
                    isVisible: chip.querySelector('.col-visible-toggle').checked,
                    order: index + 1,
                    displayLabel: chip.querySelector('.label-input').value.trim() || chip.dataset.defaultLabel
                }));
            }

            async function saveColumnsAsync(isAutoSave) {
                if (!sortable) {
                    return;
                }

                labelError.style.display = 'none';
                const activeSchemaTemplate = schemaTemplateSelect?.value.trim() || '';
                const chips = [...sortable.querySelectorAll('li.chip')];

                let hasError = false;
                chips.forEach(chip => {
                    const input = chip.querySelector('.label-input');
                    const bad = chip.querySelector('.col-visible-toggle').checked && !input.value.trim();
                    input.classList.toggle('border', bad);
                    input.classList.toggle('border-danger', bad);
                    if (bad) {
                        hasError = true;
                    }
                });

                if (hasError) {
                    labelError.textContent = 'Column label cannot be blank.';
                    labelError.style.display = 'block';
                    return;
                }

                saveStatus.textContent = isAutoSave ? 'Auto-saving…' : 'Saving…';
                saveStatus.className = 'small align-self-center ms-1 text-muted';

                try {
                    const response = await fetch(savePreferencesUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            schemaTemplate: activeSchemaTemplate,
                            preferenceId: activePreferenceId,
                            columns: buildColumnsFromChips(chips)
                        })
                    });

                    const json = await response.json().catch(() => ({}));
                    if (response.ok && json.success) {
                        if (typeof json.preferenceId === 'number') {
                            activePreferenceId = json.preferenceId;
                            upsertSchemaTemplateOption(activeSchemaTemplate, json.preferenceId);
                        }

                        syncSchemaTemplateUi(activeSchemaTemplate);
                        saveStatus.textContent = isAutoSave ? '✓ Auto-saved' : '✓ Saved';
                        saveStatus.className = 'small align-self-center ms-1 text-success';
                        await loadPreviewData();
                        setTimeout(() => { saveStatus.textContent = ''; }, 3000);
                    } else {
                        saveStatus.textContent = '✗ ' + (json.error || 'Save failed');
                        saveStatus.className = 'small align-self-center ms-1 text-danger';
                    }
                } catch {
                    saveStatus.textContent = '✗ Network error';
                    saveStatus.className = 'small align-self-center ms-1 text-danger';
                }
            }

            function scheduleAutoSave() {
                if (!isAutoSaveEnabled) {
                    return;
                }

                if (autoSaveTimer) {
                    clearTimeout(autoSaveTimer);
                }

                autoSaveTimer = setTimeout(async () => {
                    autoSaveTimer = null;
                    await saveColumnsAsync(true);
                }, 500);
            }

            function getActiveSchemaTemplate() {
                const newSchemaTemplate = schemaTemplateNewInput?.value.trim() || '';
                if (newSchemaTemplate.length > 0) {
                    return newSchemaTemplate;
                }

                return schemaTemplateSelect?.value.trim() || '';
            }

            function getPasswordValidationError(password) {
                if (!password) {
                    return 'Password is required.';
                }

                if (password.length < 8) {
                    return 'Password must be at least 8 characters.';
                }

                const hasUpper = /[A-Z]/.test(password);
                const hasLower = /[a-z]/.test(password);
                const hasNumber = /\d/.test(password);
                const hasSymbol = /[^A-Za-z0-9]/.test(password);

                if (!(hasUpper && hasLower && hasNumber && hasSymbol)) {
                    return 'Password must include uppercase, lowercase, number, and symbol.';
                }

                return '';
            }

            function getSelectedExportFormats() {
                if (!exportFormatContainer) {
                    return [];
                }

                return [...exportFormatContainer.querySelectorAll('input[type="checkbox"]:checked')]
                    .map(input => input.value);
            }

            function showExportPasswordError(message) {
                if (!exportPasswordError) {
                    return;
                }

                exportPasswordError.textContent = message;
                exportPasswordError.style.display = 'block';
            }

            function hideExportPasswordError() {
                if (!exportPasswordError) {
                    return;
                }

                exportPasswordError.textContent = '';
                exportPasswordError.style.display = 'none';
            }

            async function exportDataFileAsync(formats, password) {
                if (!exportStatus || !exportButton) {
                    return;
                }

                exportStatus.textContent = 'Exporting...';
                exportStatus.className = 'small align-self-center text-muted';
                exportButton.disabled = true;

                try {
                    const response = await fetch(exportUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            format: formats[0] || null,
                            formats,
                            password,
                            schemaTemplate: getActiveSchemaTemplate(),
                            clientCode: filterClientCodeInput?.value || null,
                            dateFrom: filterDateFromInput?.value || null,
                            dateTo: filterDateToInput?.value || null
                        })
                    });

                    if (!response.ok) {
                        const errorBody = await response.json().catch(() => ({}));
                        exportStatus.textContent = 'Export failed: ' + (errorBody.error || response.statusText);
                        exportStatus.className = 'small align-self-center text-danger';
                        return;
                    }

                    const blob = await response.blob();
                    const downloadUrl = URL.createObjectURL(blob);
                    const anchor = document.createElement('a');
                    const contentDisposition = response.headers.get('content-disposition') || '';
                    const fileNameMatch = contentDisposition.match(/filename\*?=(?:UTF-8'')?"?([^";]+)"?/i);
                    const fileName = fileNameMatch ? decodeURIComponent(fileNameMatch[1]) : 'datafile_export.zip';

                    anchor.href = downloadUrl;
                    anchor.download = fileName;
                    document.body.appendChild(anchor);
                    anchor.click();
                    anchor.remove();
                    URL.revokeObjectURL(downloadUrl);

                    exportStatus.textContent = `ZIP download started (${formats.length} format${formats.length === 1 ? '' : 's'}).`;
                    exportStatus.className = 'small align-self-center text-success';
                } catch {
                    exportStatus.textContent = 'Network error during export.';
                    exportStatus.className = 'small align-self-center text-danger';
                } finally {
                    exportButton.disabled = false;
                }
            }

            function updateColumnChipVisibility(chip) {
                const isVisible = chip.querySelector('.col-visible-toggle').checked;
                chip.classList.toggle('opacity-50', !isVisible);
            }

            function loadColumnStateFromDefaults() {
                if (!sortable) {
                    return;
                }

                const chips = [...sortable.querySelectorAll('li.chip')];
                chips.forEach(chip => updateColumnChipVisibility(chip));
            }

            async function loadPreviewData(targetPage) {
                const dbName = (sourceDatabase || '').trim();
                const tableName = (sourceTable || '').trim();
                const procedureName = (sourceSP || '').trim();
                const requestedPage = Number.isFinite(Number(targetPage)) ? Math.max(1, Number(targetPage)) : previewCurrentPage;

                if (!dbName || ((!tableName && !procedureName) || (tableName && procedureName))) {
                    setPreviewStatus('Preview source is not configured correctly for this data file.', true);
                    previewRows = [];
                    previewTotalRows = 0;
                    previewCurrentPage = 1;
                    renderPreviewPlaceholder('Preview source is not configured correctly for this data file.');
                    return;
                }

                const previewRequestColumns = (Array.isArray(previewColumns) ? previewColumns : [])
                    .map(column => ({
                        propertyName: (column?.propertyName || '').toString().trim(),
                        defaultLabel: (column?.defaultLabel || '').toString().trim(),
                        mappingParameter: (column?.mappingParameter || '').toString().trim(),
                        mappingParameterFilter: (column?.mappingParameterFilter || '').toString().trim()
                    }))
                    .filter(column => column.propertyName);

                if (previewRequestColumns.length === 0) {
                    setPreviewStatus('No columns are available for preview.', true);
                    previewRows = [];
                    previewTotalRows = 0;
                    previewCurrentPage = 1;
                    renderPreviewPlaceholder('No columns are available for preview.');
                    return;
                }

                button.disabled = true;
                setPreviewLoading(true);
                setPreviewStatus('Loading preview...', false);

                const antiForgeryToken = document.querySelector('#preview-antiforgery-form input[name="__RequestVerificationToken"]')?.value || '';

                try {
                    const response = await fetch(previewUrl, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': antiForgeryToken
                        },
                        body: JSON.stringify({
                            sourceDatabase: dbName,
                            sourceTable: tableName,
                            sourceSP: procedureName,
                            clientCode: filterClientCodeInput?.value || null,
                            dateFrom: filterDateFromInput?.value || null,
                            dateTo: filterDateToInput?.value || null,
                            page: requestedPage,
                            take: getCurrentPreviewPageSize(),
                            columns: previewRequestColumns.map(column => ({
                                propertyName: column.propertyName,
                                mappingParameter: column.mappingParameter,
                                    mappingParameterFilter: column.mappingParameterFilter
                            }))
                        })
                    });

                    const payload = await response.json().catch(() => ({}));
                    if (!response.ok) {
                        setPreviewStatus(payload?.message || 'Failed to load preview data.', true);
                        previewRows = [];
                        previewTotalRows = 0;
                        previewCurrentPage = 1;
                        renderPreviewPlaceholder('Failed to load preview data.');
                        return;
                    }

                    if (payload.canExport) {
                        exportButton.removeAttribute('disabled');
                    } else {
                        exportButton.setAttribute('disabled', 'true');
                    }

                    previewRows = Array.isArray(payload?.rows) ? payload.rows : [];
                    previewTotalRows = Number.isFinite(Number(payload?.count))
                        ? Number(payload.count)
                        : previewRows.length;
                    const totalPages = Math.max(1, Math.ceil(previewTotalRows / getCurrentPreviewPageSize()));
                    previewCurrentPage = Math.min(requestedPage, totalPages);
                    renderPreviewFromCurrentState();

                    if (previewRows.length === 0) {
                        setPreviewStatus('No rows were returned for the selected source.', false);
                    } else if (previewTotalRows > previewRows.length) {
                        const startRow = ((previewCurrentPage - 1) * getCurrentPreviewPageSize()) + 1;
                        const endRow = Math.min(startRow + previewRows.length - 1, previewTotalRows);
                        setPreviewStatus(`Showing rows ${startRow}-${endRow} of ${previewTotalRows}.`, false);
                    } else {
                        setPreviewStatus(`Showing ${previewRows.length} row(s).`, false);
                    }
                } catch {
                    setPreviewStatus('Failed to load preview data.', true);
                    previewRows = [];
                    previewTotalRows = 0;
                    previewCurrentPage = 1;
                    renderPreviewPlaceholder('Failed to load preview data.');
                } finally {
                    button.disabled = false;
                    setPreviewLoading(false);
                }
            }

            if (reportSidebarFilter) {
                reportSidebarFilter.value = '';
                reportSidebarFilter.addEventListener('input', filterSidebarReports);
                filterSidebarReports();
            }

            if (schemaTemplateSearchInput) {
                schemaTemplateSearchInput.addEventListener('input', e => {
                    hideSchemaTemplateError();
                    const searchValue = e.target instanceof HTMLInputElement ? e.target.value : '';
                    renderSchemaTemplateOptions(searchValue);
                });
            }

            if (schemaApplyButton) {
                schemaApplyButton.addEventListener('click', () => {
                    hideSchemaTemplateError();
                    navigateToSchemaTemplate(getActiveSchemaTemplate());
                });
            }

            if (schemaClearButton) {
                schemaClearButton.addEventListener('click', () => {
                    hideSchemaTemplateError();
                    if (schemaTemplateSelect) {
                        schemaTemplateSelect.value = '';
                    }
                    if (schemaTemplateNewInput) {
                        schemaTemplateNewInput.value = '';
                    }
                    navigateToSchemaTemplate('');
                });
            }

            if (schemaCreateButton) {
                schemaCreateButton.addEventListener('click', async () => {
                    hideSchemaTemplateError();

                    const newSchemaTemplate = schemaTemplateNewInput?.value.trim() || '';
                    if (!newSchemaTemplate) {
                        showSchemaTemplateError('New schema template cannot be blank.');
                        return;
                    }

                    const existingOption = [...schemaTemplateSelect.options].find(option =>
                        option.value.localeCompare(newSchemaTemplate, undefined, { sensitivity: 'accent' }) === 0);

                    if (existingOption) {
                        schemaTemplateSelect.value = existingOption.value;
                        navigateToSchemaTemplate(existingOption.value);
                        return;
                    }

                    saveStatus.textContent = 'Creating scope…';
                    saveStatus.className = 'small align-self-center ms-1 text-muted';

                    try {
                        const response = await fetch(savePreferencesUrl, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ schemaTemplate: newSchemaTemplate, preferenceId: null, columns: buildColumnsFromChips([...sortable.querySelectorAll('li.chip')]) })
                        });

                        const json = await response.json().catch(() => ({}));
                        if (!response.ok || !json.success) {
                            showSchemaTemplateError(json.error || 'Failed to create schema template.');
                            saveStatus.textContent = '✗ ' + (json.error || 'Create failed');
                            saveStatus.className = 'small align-self-center ms-1 text-danger';
                            return;
                        }

                        if (typeof json.preferenceId === 'number') {
                            activePreferenceId = json.preferenceId;
                        }

                        upsertSchemaTemplateOption(newSchemaTemplate, activePreferenceId);
                        syncSchemaTemplateUi(newSchemaTemplate);
                        saveStatus.textContent = '✓ Scope created';
                        saveStatus.className = 'small align-self-center ms-1 text-success';
                        navigateToSchemaTemplate(newSchemaTemplate);
                    } catch {
                        showSchemaTemplateError('Network error while creating schema template.');
                        saveStatus.textContent = '✗ Network error';
                        saveStatus.className = 'small align-self-center ms-1 text-danger';
                    }
                });
            }

            if (schemaRenameButton) {
                schemaRenameButton.addEventListener('click', async () => {
                    hideSchemaTemplateError();

                    if (typeof activePreferenceId !== 'number') {
                        showSchemaTemplateError('Save this schema template first before renaming.');
                        return;
                    }

                    const currentSchemaTemplate = schemaTemplateSelect?.value.trim() || '';
                    const newSchemaTemplate = schemaTemplateNewInput?.value.trim() || '';
                    if (!newSchemaTemplate) {
                        showSchemaTemplateError('New schema template cannot be blank.');
                        return;
                    }

                    const existingId = getPreferenceIdForSchemaTemplate(newSchemaTemplate);
                    if (typeof existingId === 'number' && existingId !== activePreferenceId) {
                        showSchemaTemplateError('Schema template already exists.');
                        return;
                    }

                    saveStatus.textContent = 'Renaming…';
                    saveStatus.className = 'small align-self-center ms-1 text-muted';

                    try {
                        const response = await fetch(updateSchemaTemplateUrl, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ preferenceId: activePreferenceId, newSchemaTemplate: newSchemaTemplate })
                        });

                        const json = await response.json().catch(() => ({}));
                        if (!response.ok || !json.success) {
                            showSchemaTemplateError(json.error || 'Failed to rename schema template.');
                            saveStatus.textContent = '✗ ' + (json.error || 'Rename failed');
                            saveStatus.className = 'small align-self-center ms-1 text-danger';
                            return;
                        }

                        if (currentSchemaTemplate) {
                            delete schemaTemplatePreferenceIds[currentSchemaTemplate];
                            removeSchemaTemplateOption(currentSchemaTemplate);
                        }

                        activePreferenceId = json.preferenceId;
                        upsertSchemaTemplateOption(json.schemaTemplate, activePreferenceId);
                        syncSchemaTemplateUi(json.schemaTemplate);
                        saveStatus.textContent = '✓ Renamed';
                        saveStatus.className = 'small align-self-center ms-1 text-success';
                        navigateToSchemaTemplate(json.schemaTemplate);
                    } catch {
                        showSchemaTemplateError('Network error while renaming schema template.');
                        saveStatus.textContent = '✗ Network error';
                        saveStatus.className = 'small align-self-center ms-1 text-danger';
                    }
                });
            }

            if (schemaDeleteButton) {
                schemaDeleteButton.addEventListener('click', async () => {
                    hideSchemaTemplateError();

                    if (typeof activePreferenceId !== 'number') {
                        showSchemaTemplateError('No saved schema template scope selected.');
                        return;
                    }

                    const selectedSchemaTemplate = schemaTemplateSelect?.value.trim() || '';
                    if (!selectedSchemaTemplate) {
                        showSchemaTemplateError('Default scope cannot be deleted.');
                        return;
                    }

                    if (!window.confirm(`Delete preference scope "${selectedSchemaTemplate}"?`)) {
                        return;
                    }

                    saveStatus.textContent = 'Deleting…';
                    saveStatus.className = 'small align-self-center ms-1 text-muted';

                    try {
                        const response = await fetch(deleteSchemaTemplateUrl, {
                            method: 'DELETE',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ preferenceId: activePreferenceId })
                        });

                        const json = await response.json().catch(() => ({}));
                        if (!response.ok || !json.success) {
                            showSchemaTemplateError(json.error || 'Failed to delete schema template.');
                            saveStatus.textContent = '✗ ' + (json.error || 'Delete failed');
                            saveStatus.className = 'small align-self-center ms-1 text-danger';
                            return;
                        }

                        delete schemaTemplatePreferenceIds[selectedSchemaTemplate];
                        removeSchemaTemplateOption(selectedSchemaTemplate);
                        activePreferenceId = null;
                        saveStatus.textContent = '✓ Deleted';
                        saveStatus.className = 'small align-self-center ms-1 text-success';
                        navigateToSchemaTemplate('');
                    } catch {
                        showSchemaTemplateError('Network error while deleting schema template.');
                        saveStatus.textContent = '✗ Network error';
                        saveStatus.className = 'small align-self-center ms-1 text-danger';
                    }
                });
            }

            if (schemaTemplateNewInput) {
                schemaTemplateNewInput.addEventListener('keydown', async e => {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        schemaCreateButton?.click();
                    }
                });
            }

            if (sortable) {
                let dragSrc = null;

                sortable.addEventListener('dragstart', e => {
                    dragSrc = e.target.closest('li.chip');
                    if (dragSrc) {
                        e.dataTransfer.effectAllowed = 'move';
                    }
                });

                sortable.addEventListener('dragover', e => {
                    e.preventDefault();
                    const target = e.target.closest('li.chip');
                    if (target && target !== dragSrc) {
                        const mid = target.getBoundingClientRect().left + target.getBoundingClientRect().width / 2;
                        sortable.insertBefore(dragSrc, e.clientX < mid ? target : target.nextSibling);
                    }
                });

                sortable.addEventListener('dragend', () => {
                    dragSrc = null;
                    scheduleAutoSave();
                });

                sortable.addEventListener('change', e => {
                    const chk = e.target.closest('.col-visible-toggle');
                    if (!chk) return;
                    chk.closest('li.chip').classList.toggle('opacity-50', !chk.checked);
                    renderPreviewFromCurrentState();
                    scheduleAutoSave();
                });

                sortable.addEventListener('input', e => {
                    const labelInput = e.target.closest('.label-input');
                    if (!labelInput) return;
                    renderPreviewFromCurrentState();
                    scheduleAutoSave();
                });
            }

            document.getElementById('btn-apply')?.addEventListener('click', async () => {
                await saveColumnsAsync(false);
            });

            document.getElementById('btn-reset')?.addEventListener('click', async () => {
                const activeSchemaTemplate = getActiveSchemaTemplate();
                const defaultOrderByKey = defaultColumnState.reduce((acc, column) => {
                    acc[column.key] = column.order;
                    return acc;
                }, {});

                const chips = [...sortable.querySelectorAll('li.chip')];
                chips.forEach(chip => {
                    chip.querySelector('.label-input').value = chip.dataset.defaultLabel;
                    chip.querySelector('.col-visible-toggle').checked = true;
                    chip.classList.remove('opacity-50');
                    chip.querySelector('.label-input').classList.remove('border', 'border-danger');
                });

                const chipsByKey = chips.reduce((acc, chip) => {
                    acc[chip.dataset.key] = chip;
                    return acc;
                }, {});

                const sortedKeys = Object.keys(chipsByKey)
                    .sort((left, right) => {
                        const leftOrder = defaultOrderByKey[left] ?? Number.MAX_SAFE_INTEGER;
                        const rightOrder = defaultOrderByKey[right] ?? Number.MAX_SAFE_INTEGER;
                        return leftOrder - rightOrder;
                    });

                sortedKeys.forEach(key => {
                    const chip = chipsByKey[key];
                    if (chip) {
                        sortable.appendChild(chip);
                    }
                });

                const defaultColumns = sortedKeys.map((key, index) => {
                    const chip = chipsByKey[key];
                    return {
                        key,
                        isVisible: true,
                        order: defaultOrderByKey[key] ?? index + 1,
                        displayLabel: chip?.dataset.defaultLabel || key
                    };
                });

                saveStatus.textContent = 'Resetting…';
                saveStatus.className = 'small align-self-center ms-1 text-muted';

                try {
                    const response = await fetch(savePreferencesUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ schemaTemplate: activeSchemaTemplate, preferenceId: activePreferenceId, columns: defaultColumns })
                    });

                    const json = await response.json().catch(() => ({}));
                    if (response.ok && json.success) {
                        if (typeof json.preferenceId === 'number') {
                            activePreferenceId = json.preferenceId;
                            upsertSchemaTemplateOption(activeSchemaTemplate, json.preferenceId);
                        }

                        syncSchemaTemplateUi(activeSchemaTemplate);
                        saveStatus.textContent = '✓ Reset & saved';
                        saveStatus.className = 'small align-self-center ms-1 text-success';
                        await loadPreviewData();
                        setTimeout(() => { saveStatus.textContent = ''; }, 3000);
                    }
                } catch {
                    // silent
                }
            });

            document.getElementById('btn-preview-data')?.addEventListener('click', loadPreviewData);
            pageSizeInput?.addEventListener('change', () => {
                previewCurrentPage = 1;
                loadPreviewData(1);
            });
            pageFirstButton?.addEventListener('click', () => {
                if (previewCurrentPage <= 1) {
                    return;
                }

                loadPreviewData(1);
            });
            pagePrevButton?.addEventListener('click', () => {
                if (previewCurrentPage <= 1) {
                    return;
                }

                loadPreviewData(previewCurrentPage - 1);
            });
            pageNextButton?.addEventListener('click', () => {
                const totalPages = Math.max(1, Math.ceil(previewTotalRows / getCurrentPreviewPageSize()));
                if (previewCurrentPage >= totalPages) {
                    return;
                }

                loadPreviewData(previewCurrentPage + 1);
            });
            pageLastButton?.addEventListener('click', () => {
                const totalPages = Math.max(1, Math.ceil(previewTotalRows / getCurrentPreviewPageSize()));
                loadPreviewData(totalPages);
            });
            pageJumpForm?.addEventListener('submit', e => {
                e.preventDefault();

                const totalPages = Math.max(1, Math.ceil(previewTotalRows / getCurrentPreviewPageSize()));
                const parsed = Number.parseInt(pageJumpInput?.value || '1', 10);
                const targetPage = Number.isFinite(parsed) ? Math.min(Math.max(1, parsed), totalPages) : 1;

                loadPreviewData(targetPage);
            });

            exportButton?.addEventListener('click', () => {
                const selectedFormats = getSelectedExportFormats();
                if (!selectedFormats.length) {
                    exportStatus.textContent = 'Select at least one format.';
                    exportStatus.className = 'small align-self-center text-danger';
                    return;
                }

                hideExportPasswordError();
                if (exportPasswordInput) {
                    exportPasswordInput.value = '';
                }
                exportPasswordModal?.show();
                exportPasswordInput?.focus();
            });

            exportConfirmButton?.addEventListener('click', async () => {
                const password = (exportPasswordInput?.value || '').trim();
                const passwordValidationError = getPasswordValidationError(password);

                if (passwordValidationError) {
                    showExportPasswordError(passwordValidationError);
                    return;
                }

                hideExportPasswordError();
                exportPasswordModal?.hide();
                await exportDataFileAsync(getSelectedExportFormats(), password);
            });

            exportPasswordInput?.addEventListener('keydown', async e => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    exportConfirmButton?.click();
                }
            });

            filterDateFromInput?.addEventListener('change', syncScheduleLink);
            filterDateToInput?.addEventListener('change', syncScheduleLink);
            filterClientCodeInput?.addEventListener('change', () => {
                filterClientCodeInput.setCustomValidity('');
                syncScheduleLink();
            });

            filterForm?.addEventListener('submit', e => {
                if (filterClientCodeInput?.value) {
                    filterClientCodeInput.setCustomValidity('');
                    return;
                }

                e.preventDefault();
                filterClientCodeInput?.setCustomValidity('ClientCode is required.');
                filterClientCodeInput?.reportValidity();
                filterClientCodeInput?.focus();
            });

            if (schemaTemplateSearchInput) {
                schemaTemplateSearchInput.addEventListener('input', e => {
                    hideSchemaTemplateError();
                    const searchValue = e.target instanceof HTMLInputElement ? e.target.value : '';
                    renderSchemaTemplateOptions(searchValue);
                });
            }

            if (reportSidebarFilter) {
                reportSidebarFilter.value = '';
                reportSidebarFilter.addEventListener('input', filterSidebarReports);
                filterSidebarReports();
            }

            schemaTemplateSelect && renderSchemaTemplateOptions('');
            syncSchemaTemplateUi(initialSchemaTemplate);
            syncScheduleLink();

            if (sortable) {
                loadColumnStateFromDefaults();
            }

            if (shouldAutoLoadPreview) {
                loadPreviewData(1);
            }

            const exportCollapseEl = document.getElementById('export-card-body');
            const exportCollapseToggle = exportCollapseEl?.previousElementSibling?.querySelector('[data-bs-target="#export-card-body"]');
            if (exportCollapseEl && exportCollapseToggle) {
                exportCollapseEl.addEventListener('hide.bs.collapse', () => { exportCollapseToggle.innerHTML = '&#9660;'; });
                exportCollapseEl.addEventListener('show.bs.collapse', () => { exportCollapseToggle.innerHTML = '&#9650;'; });
            }

            const columnCustomiserCollapseEl = document.getElementById('column-customiser-card-body');
            const columnCustomiserCollapseToggle = columnCustomiserCollapseEl?.previousElementSibling?.querySelector('[data-bs-target="#column-customiser-card-body"]');
            if (columnCustomiserCollapseEl && columnCustomiserCollapseToggle) {
                columnCustomiserCollapseEl.addEventListener('hide.bs.collapse', () => { columnCustomiserCollapseToggle.innerHTML = '&#9660;'; });
                columnCustomiserCollapseEl.addEventListener('show.bs.collapse', () => { columnCustomiserCollapseToggle.innerHTML = '&#9650;'; });
            }
        })();
    </script>
}
}