@using DataWarehousePower.Authorization
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = "No Data Files";
    bool canManageReports = (await AuthorizationService.AuthorizeAsync(User, DepartmentAuthorizationPolicies.ReportManageAccess)).Succeeded;
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
        <div class="card shadow-sm border-0 mt-4">
            <div class="card-body p-4 text-center">
                <h2 class="h4 mb-2">No data files are available</h2>
                <p class="text-muted mb-4">
                    There are currently no active data file definitions configured for your access.
                </p>
                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to Home</a>
                    @if (canManageReports)
                    {
                        <a asp-controller="DataFileManage" asp-action="Index" class="btn btn-outline-secondary">Manage Data Files</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>