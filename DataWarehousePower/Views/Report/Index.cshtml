@model DataWarehousePower.Models.ReportViewModel
@{
    ViewData["Title"] = Model.ReportName;
}

<div class="row">

    <!-- ── Sidebar: report list ─────────────────────────────────── -->
    <div class="col-md-2 pe-0">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold small">Reports</div>
            <ul class="list-group list-group-flush">
                @foreach (var r in Model.AllReports)
                {
                    <li class="list-group-item list-group-item-action p-2 @(r.Id == Model.ReportId ? "active" : "")">
                                <a href="@Url.Action("Index", "Report", new
                                         {
                                             id = r.Id,
                                             clientCode = Model.ClientCode,
                                             filterClientCode = Model.FilterClientCode,
                                             dateFrom = Model.FilterDateFrom?.ToString("yyyy-MM-dd"),
                                             dateTo = Model.FilterDateTo?.ToString("yyyy-MM-dd")
                                         })"
                           class="text-decoration-none @(r.Id == Model.ReportId ? "text-white" : "")"
                           style="font-size:.85rem;">
                            @r.ReportName
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>

    <!-- ── Main content ─────────────────────────────────────────── -->
    <div class="col-md-10">

        <div class="d-flex flex-column flex-lg-row align-items-lg-end justify-content-between gap-3 mb-3">
            <div>
                <h4 class="mb-1">@Model.ReportName</h4>
                <div class="text-muted small">Choose a client code to load and save a separate column layout.</div>
            </div>
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2 px-3">
                    <label for="client-code-select" class="form-label small fw-semibold mb-1">Client Code</label>
                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex gap-2 align-items-center">
                            <select id="client-code-select" class="d-none" aria-hidden="true">
                                <option value="">Default</option>
                                @foreach (var availableClientCode in Model.AvailableClientCodes)
                                {
                                    <option value="@availableClientCode" selected="@(availableClientCode.Equals(Model.ClientCode, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@availableClientCode</option>
                                }
                            </select>

                            <div class="dropdown flex-grow-1">
                                <button id="client-code-dropdown-toggle"
                                        class="btn btn-sm btn-outline-secondary dropdown-toggle w-100 text-start"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        data-bs-auto-close="outside"
                                        aria-expanded="false">
                                    Default
                                </button>
                                <div class="dropdown-menu p-2 w-100" style="min-width: 260px;">
                                    <input id="client-code-search"
                                           type="text"
                                           class="form-control form-control-sm mb-2"
                                           maxlength="128"
                                           placeholder="Search client code"
                                           autocomplete="off" />
                                    <div id="client-code-options" class="list-group list-group-flush" style="max-height: 220px; overflow-y: auto;"></div>
                                </div>
                            </div>

                            <button id="btn-client-apply" type="button" class="btn btn-sm btn-outline-primary">Load</button>
                            <button id="btn-client-clear" type="button" class="btn btn-sm btn-outline-secondary">Clear</button>
                        </div>
                        <div class="d-flex gap-2 align-items-center">
                            <input id="client-code-new"
                                   type="text"
                                   class="form-control form-control-sm"
                                   maxlength="128"
                                   placeholder="Create new client code" />
                            <button id="btn-client-create" type="button" class="btn btn-sm btn-primary">Use New</button>
                        </div>
                        <div id="client-code-error" class="text-danger small" style="display:none;"></div>
                    </div>
                </div>
            </div>
        </div>

        <div id="client-code-status" class="alert alert-light border small py-2 px-3 mb-3">
            Preference scope:
            <strong>@(string.IsNullOrWhiteSpace(Model.ClientCode) ? "Default" : Model.ClientCode)</strong>
        </div>

        <div class="card mb-3 shadow-sm">
            <div class="card-header fw-semibold">Data Filters</div>
            <div class="card-body">
                <form method="get" action="@Url.Action("Index", "Report", new { id = Model.ReportId })" class="row g-2 align-items-end">
                    <input type="hidden" name="clientCode" value="@Model.ClientCode" />

                    <div class="col-md-4">
                        <label for="filter-client-code" class="form-label small fw-semibold">ClientCode</label>
                        <input id="filter-client-code"
                               name="filterClientCode"
                               type="text"
                               class="form-control form-control-sm"
                               maxlength="128"
                               value="@Model.FilterClientCode"
                               placeholder="Enter client code" />
                    </div>

                    <div class="col-md-3">
                        <label for="filter-date-from" class="form-label small fw-semibold">DateFrom</label>
                        <input id="filter-date-from"
                               name="dateFrom"
                               type="date"
                               class="form-control form-control-sm"
                               value="@Model.FilterDateFrom?.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="col-md-3">
                        <label for="filter-date-to" class="form-label small fw-semibold">DateTo</label>
                        <input id="filter-date-to"
                               name="dateTo"
                               type="date"
                               class="form-control form-control-sm"
                               value="@Model.FilterDateTo?.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-sm btn-primary w-100">Apply</button>
                        <a class="btn btn-sm btn-outline-secondary w-100"
                           href="@Url.Action("Index", "Report", new { id = Model.ReportId, clientCode = Model.ClientCode })">Clear</a>
                    </div>
                </form>
            </div>
        </div>

        <!-- ════════ COLUMN CUSTOMISER ════════ -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header fw-semibold d-flex align-items-center gap-2">
                <span>Column Customiser</span>
                <span class="badge bg-secondary" style="font-size:.75rem;">drag · rename · toggle</span>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">
                    Drag chips to reorder &nbsp;|&nbsp;
                    The <span class="badge bg-light text-secondary border" style="font-size:.7rem;">grey badge</span>
                    shows the original column name &nbsp;→&nbsp; type in the box to rename it &nbsp;|&nbsp;
                    Use the checkbox to show/hide. Click <strong>Save &amp; Apply</strong> to persist.
                </p>

                <ul id="sortable-columns" class="list-unstyled d-flex flex-wrap gap-2 mb-3" style="min-height:48px;">
                    @{
                        var visible  = Model.DisplayColumns.Where(c => c.IsVisible).OrderBy(c => c.Order).ToList();
                        var hiddenCols = Model.AvailableColumns
                            .Where(sys => !visible.Any(v => v.Key == sys.Key))
                            .Select(sys => new DataWarehousePower.Models.ColumnDefinition
                            {
                                Key = sys.Key, DefaultLabel = sys.DefaultLabel,
                                DisplayLabel = sys.DefaultLabel, IsVisible = false, Order = 999
                            });
                        var allChips = visible.Concat(hiddenCols).ToList();
                    }
                    @foreach (var col in allChips)
                    {
                        <li class="chip border rounded px-2 py-1 bg-white shadow-sm d-flex align-items-center gap-2 @(col.IsVisible ? "" : "opacity-50")"
                            data-key="@col.Key"
                            data-default-label="@col.DefaultLabel"
                            draggable="true"
                            style="cursor:grab; user-select:none;">
                            <span class="drag-handle text-muted" style="cursor:grab;">&#9776;</span>
                            <span class="badge bg-light text-secondary border"
                                  style="font-size:.7rem; white-space:nowrap;"
                                  title="Original column name">@col.DefaultLabel</span>
                            <span class="text-muted" style="font-size:.8rem;">→</span>
                            <input type="text"
                                   class="form-control form-control-sm label-input border-0 p-0"
                                   style="width:110px; background:transparent;"
                                   value="@col.DisplayLabel"
                                   maxlength="100"
                                   placeholder="@col.DefaultLabel"
                                   title="Display name (original: @col.DefaultLabel)"
                                   aria-label="Display label for @col.DefaultLabel" />
                            <input type="checkbox"
                                   class="form-check-input m-0 col-visible-toggle"
                                   @(col.IsVisible ? "checked" : "")
                                   title="Show / hide column"
                                   aria-label="Show @col.DefaultLabel" />
                        </li>
                    }
                </ul>

                <div id="label-error" class="text-danger small mb-2" style="display:none;"></div>
                <div class="d-flex gap-2">
                    <button id="btn-apply" class="btn btn-primary btn-sm">Save &amp; Apply</button>
                    <button id="btn-reset" class="btn btn-outline-secondary btn-sm">Reset to Defaults</button>
                    <span   id="save-status" class="small align-self-center ms-1"></span>
                </div>
            </div>
        </div>

        <!-- ════════ DATA TABLE ════════ -->
        <div class="table-responsive shadow-sm">
            <table class="table table-bordered table-hover align-middle" id="report-table">
                <thead class="table-dark">
                    <tr id="table-header-row">
                        @foreach (var col in Model.DisplayColumns.Where(c => c.IsVisible).OrderBy(c => c.Order))
                        {
                            <th data-key="@col.Key">@col.DisplayLabel</th>
                        }
                    </tr>
                </thead>
                <tbody id="table-body">
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            @foreach (var col in Model.DisplayColumns.Where(c => c.IsVisible).OrderBy(c => c.Order))
                            {
                                <td>@(row.ContainsKey(col.Key) ? row[col.Key]?.ToString() : "")</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div><!-- /col -->
</div><!-- /row -->

@section Scripts {
<script>
const reportId = @Model.ReportId;
const initialClientCode = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ClientCode));
const clientCodeSearchInput = document.getElementById('client-code-search');
const clientCodeDropdownToggle = document.getElementById('client-code-dropdown-toggle');
const clientCodeOptions = document.getElementById('client-code-options');
const clientCodeSelect = document.getElementById('client-code-select');
const clientCodeNewInput = document.getElementById('client-code-new');
const clientApplyButton = document.getElementById('btn-client-apply');
const clientClearButton = document.getElementById('btn-client-clear');
const clientCreateButton = document.getElementById('btn-client-create');
const clientCodeError = document.getElementById('client-code-error');
const clientCodeStatus = document.getElementById('client-code-status');

// Embed all rows as JSON for client-side re-render
const allRows = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Rows));

clientApplyButton.addEventListener('click', () => {
    hideClientCodeError();
    navigateToClientCode(getActiveClientCode());
});

clientClearButton.addEventListener('click', () => {
    hideClientCodeError();
    clientCodeSelect.value = '';
    clientCodeNewInput.value = '';
    navigateToClientCode('');
});

clientCodeSearchInput.addEventListener('input', e => {
    hideClientCodeError();
    const searchValue = e.target instanceof HTMLInputElement ? e.target.value : '';
    renderClientCodeOptions(searchValue);
});

clientCreateButton.addEventListener('click', async () => {
    await applyNewClientCodeAsync();
});

clientCodeNewInput.addEventListener('keydown', async e => {
    if (e.key === 'Enter') {
        e.preventDefault();
        await applyNewClientCodeAsync();
    }
});

// ── Drag-and-drop ─────────────────────────────────────────────────────────────
const sortable = document.getElementById('sortable-columns');
let dragSrc = null;

sortable.addEventListener('dragstart', e => {
    dragSrc = e.target.closest('li.chip');
    if (dragSrc) e.dataTransfer.effectAllowed = 'move';
});
sortable.addEventListener('dragover', e => {
    e.preventDefault();
    const target = e.target.closest('li.chip');
    if (target && target !== dragSrc) {
        const mid = target.getBoundingClientRect().left + target.getBoundingClientRect().width / 2;
        sortable.insertBefore(dragSrc, e.clientX < mid ? target : target.nextSibling);
    }
});
sortable.addEventListener('dragend', () => { dragSrc = null; });

// ── Visibility toggle ─────────────────────────────────────────────────────────
sortable.addEventListener('change', e => {
    const chk = e.target.closest('.col-visible-toggle');
    if (!chk) return;
    chk.closest('li.chip').classList.toggle('opacity-50', !chk.checked);
});

// ── Save & Apply ─────────────────────────────────────────────────────────────
document.getElementById('btn-apply').addEventListener('click', async () => {
    const errorEl  = document.getElementById('label-error');
    const statusEl = document.getElementById('save-status');
    const activeClientCode = getActiveClientCode();
    errorEl.style.display = 'none';

    const chips = [...sortable.querySelectorAll('li.chip')];

    let hasError = false;
    chips.forEach(chip => {
        const input = chip.querySelector('.label-input');
        const bad   = chip.querySelector('.col-visible-toggle').checked && !input.value.trim();
        input.classList.toggle('border', bad);
        input.classList.toggle('border-danger', bad);
        if (bad) hasError = true;
    });

    if (hasError) {
        errorEl.textContent = 'Column label cannot be blank.';
        errorEl.style.display = 'block';
        return;
    }

    const columns = buildColumnsFromChips(chips);

    statusEl.textContent = 'Saving…';
    statusEl.className   = 'small align-self-center ms-1 text-muted';

    try {
        const resp = await fetch(`/Report/${reportId}/SavePreferences`, {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ clientCode: activeClientCode, columns })
        });
        const json = await resp.json();
        if (resp.ok && json.success) {
            upsertClientCodeOption(activeClientCode);
            syncClientCodeUi(activeClientCode);
            statusEl.textContent = '✓ Saved';
            statusEl.className   = 'small align-self-center ms-1 text-success';
            renderTable(columns);
            setTimeout(() => { statusEl.textContent = ''; }, 3000);
        } else {
            statusEl.textContent = '✗ ' + (json.error || 'Save failed');
            statusEl.className   = 'small align-self-center ms-1 text-danger';
        }
    } catch {
        statusEl.textContent = '✗ Network error';
        statusEl.className   = 'small align-self-center ms-1 text-danger';
    }
});

// ── Reset to defaults ─────────────────────────────────────────────────────────
document.getElementById('btn-reset').addEventListener('click', async () => {
    const statusEl = document.getElementById('save-status');
    const activeClientCode = getActiveClientCode();

    const chips = [...sortable.querySelectorAll('li.chip')];
    chips.forEach(chip => {
        chip.querySelector('.label-input').value = chip.dataset.defaultLabel;
        chip.querySelector('.col-visible-toggle').checked = true;
        chip.classList.remove('opacity-50');
        chip.querySelector('.label-input').classList.remove('border', 'border-danger');
    });

    // Restore original DB order (data-order attribute not needed — just re-sort by default label order)
    // Easiest: reload the page after saving defaults
    const defaultColumns = chips.map((chip, i) => ({
        key:          chip.dataset.key,
        isVisible:    true,
        order:        i + 1,
        displayLabel: chip.dataset.defaultLabel
    }));

    statusEl.textContent = 'Resetting…';
    statusEl.className   = 'small align-self-center ms-1 text-muted';

    try {
        const resp = await fetch(`/Report/${reportId}/SavePreferences`, {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ clientCode: activeClientCode, columns: defaultColumns })
        });
        const json = await resp.json();
        if (resp.ok && json.success) {
            upsertClientCodeOption(activeClientCode);
            syncClientCodeUi(activeClientCode);
            statusEl.textContent = '✓ Reset & saved';
            statusEl.className   = 'small align-self-center ms-1 text-success';
            renderTable(defaultColumns);
            setTimeout(() => { statusEl.textContent = ''; }, 3000);
        }
    } catch { /* silent */ }
});

// ── Re-render table ───────────────────────────────────────────────────────────
function renderTable(cols) {
    const vis = cols.filter(c => c.isVisible);

    document.getElementById('table-header-row').innerHTML =
        vis.map(c => `<th data-key="${esc(c.key)}">${esc(c.displayLabel)}</th>`).join('');

    document.getElementById('table-body').innerHTML =
        allRows.map(row => {
            const cells = vis.map(c => {
                // keys in allRows use original casing from DB
                const val = Object.entries(row).find(([k]) => k.toLowerCase() === c.key.toLowerCase())?.[1];
                return `<td>${val != null ? esc(String(val)) : ''}</td>`;
            }).join('');
            return `<tr>${cells}</tr>`;
        }).join('');
}

function esc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function navigateToClientCode(value) {
    const trimmed = value.trim();
    const url = new URL(window.location.href);

    if (trimmed) {
        url.searchParams.set('clientCode', trimmed);
    } else {
        url.searchParams.delete('clientCode');
    }

    window.location.href = url.toString();
}

function applyNewClientCode() {
    return applyNewClientCodeAsync();
}

async function applyNewClientCodeAsync() {
    hideClientCodeError();

    const newClientCode = clientCodeNewInput.value.trim();
    if (!newClientCode) {
        showClientCodeError('New client code cannot be blank.');
        return;
    }

    const existingOption = [...clientCodeSelect.options].find(option =>
        option.value.localeCompare(newClientCode, undefined, { sensitivity: 'accent' }) === 0);

    if (existingOption) {
        clientCodeSelect.value = existingOption.value;
        navigateToClientCode(existingOption.value);
        return;
    }

    const statusEl = document.getElementById('save-status');
    const chips = [...sortable.querySelectorAll('li.chip')];
    const columns = buildColumnsFromChips(chips);

    statusEl.textContent = 'Creating scope…';
    statusEl.className   = 'small align-self-center ms-1 text-muted';

    try {
        const response = await fetch(`/Report/${reportId}/SavePreferences`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ clientCode: newClientCode, columns })
        });

        const json = await response.json();
        if (!response.ok || !json.success) {
            showClientCodeError(json.error || 'Failed to create client code.');
            statusEl.textContent = '✗ ' + (json.error || 'Create failed');
            statusEl.className   = 'small align-self-center ms-1 text-danger';
            return;
        }

        upsertClientCodeOption(newClientCode);
        syncClientCodeUi(newClientCode);
        statusEl.textContent = '✓ Scope created';
        statusEl.className   = 'small align-self-center ms-1 text-success';
        navigateToClientCode(newClientCode);
    } catch {
        showClientCodeError('Network error while creating client code.');
        statusEl.textContent = '✗ Network error';
        statusEl.className   = 'small align-self-center ms-1 text-danger';
    }
}

function getActiveClientCode() {
    const newClientCode = clientCodeNewInput.value.trim();
    if (newClientCode.length > 0) {
        return newClientCode;
    }

    return clientCodeSelect.value.trim();
}

function buildColumnsFromChips(chips) {
    return chips.map((chip, i) => ({
        key:          chip.dataset.key,
        isVisible:    chip.querySelector('.col-visible-toggle').checked,
        order:        i + 1,
        displayLabel: chip.querySelector('.label-input').value.trim() || chip.dataset.defaultLabel
    }));
}

function upsertClientCodeOption(value) {
    const normalizedValue = value.trim();
    if (!normalizedValue) {
        return;
    }

    const existingOption = [...clientCodeSelect.options].find(option =>
        option.value.localeCompare(normalizedValue, undefined, { sensitivity: 'accent' }) === 0);

    if (existingOption) {
        existingOption.value = normalizedValue;
        existingOption.textContent = normalizedValue;
        return;
    }

    const newOption = document.createElement('option');
    newOption.value = normalizedValue;
    newOption.textContent = normalizedValue;
    clientCodeSelect.appendChild(newOption);
    renderClientCodeOptions(clientCodeSearchInput.value);
}

function syncClientCodeUi(value) {
    const normalizedValue = value.trim();
    clientCodeSelect.value = normalizedValue;
    clientCodeNewInput.value = normalizedValue;
    clientCodeDropdownToggle.textContent = normalizedValue || 'Default';
    renderClientCodeOptions(clientCodeSearchInput.value);

    const scopeLabel = normalizedValue || 'Default';
    clientCodeStatus.innerHTML = `Preference scope: <strong>${esc(scopeLabel)}</strong>`;
}

function renderClientCodeOptions(searchValue) {
    const normalizedSearch = searchValue.trim().toLocaleLowerCase();
    const selectedValue = clientCodeSelect.value;
    clientCodeOptions.innerHTML = '';

    [...clientCodeSelect.options].forEach((option, index) => {
        const isDefault = index === 0;
        const isMatch = !normalizedSearch || option.text.toLocaleLowerCase().includes(normalizedSearch);
        const isSelected = option.value.localeCompare(selectedValue, undefined, { sensitivity: 'accent' }) === 0;
        if (!(isDefault || isMatch || isSelected)) {
            return;
        }

        const optionButton = document.createElement('button');
        optionButton.type = 'button';
        optionButton.className = `list-group-item list-group-item-action py-1 px-2${isSelected ? ' active' : ''}`;
        optionButton.textContent = option.text;
        optionButton.addEventListener('click', () => {
            hideClientCodeError();
            clientCodeSelect.value = option.value;
            syncClientCodeUi(option.value);
            navigateToClientCode(option.value);
        });
        clientCodeOptions.appendChild(optionButton);
    });

    if (!clientCodeOptions.children.length) {
        const empty = document.createElement('div');
        empty.className = 'text-muted small px-2 py-1';
        empty.textContent = 'No matches';
        clientCodeOptions.appendChild(empty);
    }
}

function showClientCodeError(message) {
    clientCodeError.textContent = message;
    clientCodeError.style.display = 'block';
}

function hideClientCodeError() {
    clientCodeError.textContent = '';
    clientCodeError.style.display = 'none';
}

syncClientCodeUi(initialClientCode);
</script>
}
