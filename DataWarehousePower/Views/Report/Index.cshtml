@model DataWarehousePower.Models.ReportViewModel
@using Microsoft.AspNetCore.WebUtilities
@{
    ViewData["Title"] = Model.ReportName;
    ViewData["MainContainerClass"] = "container report-page-container";
    var visibleRuntimeParameters = Model.RuntimeParameters
        .Where(parameter => string.IsNullOrWhiteSpace(parameter.DefaultValue))
        .ToList();

    string BuildReportUrl(
        int reportId,
        int? page = null,
        int? pageSize = null,
        string? overrideSchemaTemplate = null,
        bool includeFilters = true,
        bool includeLoadData = false)
    {
        string baseUrl = Url.Action("Index", "Report", new { id = reportId }) ?? $"/Report/{reportId}";

        Dictionary<string, string?> queryValues = new(StringComparer.OrdinalIgnoreCase);
        string schemaTemplate = overrideSchemaTemplate ?? Model.SchemaTemplate;
        if (!string.IsNullOrWhiteSpace(schemaTemplate))
        {
            queryValues["schemaTemplate"] = schemaTemplate;
        }

        if (includeFilters)
        {
            if (!string.IsNullOrWhiteSpace(Model.ClientCode))
            {
                queryValues["clientCode"] = Model.ClientCode;
            }

            if (Model.FilterDateFrom.HasValue)
            {
                queryValues["dateFrom"] = Model.FilterDateFrom.Value.ToString("yyyy-MM-dd");
            }

            if (Model.FilterDateTo.HasValue)
            {
                queryValues["dateTo"] = Model.FilterDateTo.Value.ToString("yyyy-MM-dd");
            }

            foreach (var parameter in Model.RuntimeParameters)
            {
                if (!string.IsNullOrWhiteSpace(parameter.Value))
                {
                    queryValues[parameter.QueryKey] = parameter.Value;
                }
            }
        }

        if (includeLoadData)
        {
            queryValues["loadData"] = "true";
        }

        if (page.HasValue)
        {
            queryValues["page"] = page.Value.ToString();
        }

        if (pageSize.HasValue)
        {
            queryValues["pageSize"] = pageSize.Value.ToString();
        }

        return queryValues.Count == 0 ? baseUrl : QueryHelpers.AddQueryString(baseUrl, queryValues);
    }
}

<div class="row">

    <!-- ── Sidebar: report list ─────────────────────────────────── -->
    <div class="col-md-2 pe-0">
        <div class="card shadow-sm h-100 d-flex flex-column">
            <div class="card-header fw-semibold small">Reports</div>
            <div class="px-2 pt-2 pb-2 border-bottom">
                <input id="report-sidebar-filter"
                      type="text"
                       class="form-control form-control-sm"
                       maxlength="128"
                       placeholder="Filter reports"
                       autocomplete="off" />
            </div>
            <div class="flex-grow-1 overflow-auto">
            <ul class="list-group list-group-flush">
                @foreach (var r in Model.AllReports)
                {
                    var targetSchemaTemplate = !string.IsNullOrWhiteSpace(Model.SchemaTemplate)
                    && Model.ReportSchemaTemplatesByReportId.TryGetValue(r.Id, out var reportSchemaTemplates)
                    && reportSchemaTemplates.Any(code => code.Equals(Model.SchemaTemplate, StringComparison.OrdinalIgnoreCase))
                    ? Model.SchemaTemplate
                    : null;

                    <li class="report-sidebar-item list-group-item list-group-item-action p-2 @(r.Id == Model.ReportId ? "active" : "")"
                        data-report-name="@r.ReportName">
                        <div class="d-flex align-items-center gap-2">
                            <a href="@Url.Action("Index", "Report", new
                                             { id = r.Id })"
                               data-target-url="@BuildReportUrl(r.Id, null, null, targetSchemaTemplate)"
                               class="text-decoration-none flex-grow-1 @(r.Id == Model.ReportId ? "text-white" : "")"
                               style="font-size:.85rem;">
                                @r.ReportName
                            </a>
                            @* <a href="@Url.Action("Edit", "ReportManage", new { id = r.Id })"
                               class="btn btn-sm @(r.Id == Model.ReportId ? "btn-light text-primary" : "btn-outline-primary")"
                               title="Edit this report"
                               aria-label="Edit @r.ReportName">
                                Edit
                            </a> *@
                        </div>
                    </li>
                }
            </ul>
            <div id="report-sidebar-empty" class="text-muted small px-2 py-2 d-none">No matching reports.</div>
            </div>
        </div>
    </div>

    <!-- ── Main content ─────────────────────────────────────────── -->
    <div class="col-md-10">

        <div class="mb-2">
            <h4 class="mb-1">@Model.ReportName</h4>
            <div class="text-muted small">Choose a schema template to load and save a separate column layout.</div>
        </div>

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body py-2 px-3">
                <label for="client-code-select" class="form-label small fw-semibold mb-1">Schema Template</label>
                <div class="d-flex gap-2 align-items-center flex-nowrap">
                    <select id="client-code-select" class="d-none" aria-hidden="true">
                        <option value="">Default</option>
                        @foreach (var availableSchemaTemplate in Model.AvailableSchemaTemplates)
                        {
                            <option value="@availableSchemaTemplate" selected="@(availableSchemaTemplate.Equals(Model.SchemaTemplate, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@availableSchemaTemplate</option>
                        }
                    </select>

                    <div class="dropdown flex-grow-1">
                        <button id="client-code-dropdown-toggle"
                                class="btn btn-sm btn-outline-secondary dropdown-toggle w-100 text-start"
                                type="button"
                                data-bs-toggle="dropdown"
                                data-bs-auto-close="outside"
                                aria-expanded="false">
                            Default
                        </button>
                        <div class="dropdown-menu p-2 w-100" style="min-width: 260px;">
                            <input id="client-code-search"
                                   type="text"
                                   class="form-control form-control-sm mb-2"
                                   maxlength="128"
                                   placeholder="Search client code"
                                   autocomplete="off" />
                            <div id="client-code-options" class="list-group list-group-flush" style="max-height: 220px; overflow-y: auto;"></div>
                        </div>
                    </div>

                    <button id="btn-client-apply" type="button" class="btn btn-sm btn-outline-primary">Load</button>
                    <button id="btn-client-clear" type="button" class="btn btn-sm btn-outline-secondary">Clear</button>
                    <button id="btn-client-rename" type="button" class="btn btn-sm btn-outline-warning">Rename</button>
                    <button id="btn-client-delete" type="button" class="btn btn-sm btn-outline-danger">Delete</button>

                    <input id="client-code-new"
                           type="text"
                           class="form-control form-control-sm"
                           maxlength="128"
                           placeholder="Create new client code"
                           style="max-width: 260px;" />
                    <button id="btn-client-create" type="button" class="btn btn-sm btn-primary">Use New</button>
                </div>
                <div id="client-code-error" class="text-danger small mt-1" style="display:none;"></div>
            </div>
        </div>

        <div hidden id="client-code-status" class="alert alert-light border small py-2 px-3 mb-3">
            Preference scope:
            <strong>@(string.IsNullOrWhiteSpace(Model.SchemaTemplate) ? "Default" : Model.SchemaTemplate)</strong>
        </div>

        @if (!Model.HasAppliedFilters)
        {
            <div class="alert alert-info border small py-2 px-3 mb-3">
                Select a client code and click Apply to load report data.
            </div>
        }

        <div class="card mb-3 shadow-sm">
            <div class="card-header fw-semibold">Data Filters</div>
            <div class="card-body">
                <form id="report-filter-form" method="get" action="@Url.Action("Index", "Report", new { id = Model.ReportId })" class="row g-3 align-items-end">
                    <input type="hidden" id="filter-schema-template" name="schemaTemplate" value="@Model.SchemaTemplate" />
                    <input type="hidden" name="loadData" value="true" />
                    <input type="hidden" name="pageSize" value="@Model.PageSize" />

                    <div class="col-md-4 d-flex flex-column gap-1">
                        <label for="filter-client-code" class="form-label small fw-semibold">ClientCode</label>
                        <select id="filter-client-code"
                                name="clientCode"
                                class="form-select form-select-sm"
                                required>
                            <option value="">Select a client code</option>
                            @foreach (var availableClientCode in Model.AvailableClientCodes)
                            {
                                <option value="@availableClientCode" selected="@(availableClientCode.Equals(Model.ClientCode, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@availableClientCode</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3 d-flex flex-column gap-1">
                        <label for="filter-date-from" class="form-label small fw-semibold">DateFrom</label>
                        <input id="filter-date-from"
                               name="dateFrom"
                               type="date"
                               class="form-control form-control-sm"
                               value="@((Model.FilterDateFrom ?? DateTime.Today).ToString("yyyy-MM-dd"))" />
                    </div>

                    <div class="col-md-3 d-flex flex-column gap-1">
                        <label for="filter-date-to" class="form-label small fw-semibold">DateTo</label>
                        <input id="filter-date-to"
                               name="dateTo"
                               type="date"
                               class="form-control form-control-sm"
                               value="@((Model.FilterDateTo ?? DateTime.Today).ToString("yyyy-MM-dd"))" />
                    </div>

                    <div class="col-md-2 d-flex gap-2 align-self-end">
                        <button type="submit" class="btn btn-sm btn-primary w-100">Apply</button>
                        <a class="btn btn-sm btn-outline-secondary w-100"
                              href="@BuildReportUrl(Model.ReportId, null, Model.PageSize, null, false)">Clear</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="card mb-3 shadow-sm">
            <div class="card-header fw-semibold d-flex align-items-center justify-content-between">
                <span>Export</span>
                <button class="btn btn-sm btn-link p-0 text-decoration-none text-muted"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#export-card-body"
                        aria-expanded="false"
                        aria-controls="export-card-body">
                    &#9660;
                </button>
            </div>
            <div id="export-card-body" class="collapse">
            <div class="card-body">
                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold" for="export-format-csv">Formats</label>
                        <div id="export-format" class="d-flex flex-column gap-1">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="export-format-csv" value="csv" checked />
                                <label class="form-check-label" for="export-format-csv">CSV</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="export-format-excel" value="excel" />
                                <label class="form-check-label" for="export-format-excel">Excel (.xlsx)</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="export-format-pdf" value="pdf" />
                                <label class="form-check-label" for="export-format-pdf">PDF</label>
                            </div>
                        </div>
                        <div class="form-text">Select one or more formats.</div>
                    </div>
                    <div class="col-md-8 d-flex gap-2">
                        <button id="btn-export" type="button" class="btn btn-sm btn-success" disabled="@(!Model.CanExport)">Export as Password ZIP</button>
                        <button id="btn-schedule-report" type="button" class="btn btn-sm btn-outline-primary">Schedule Report</button>
                        <span id="export-status" class="small align-self-center"></span>
                    </div>
                </div>
                <div class="text-muted small mt-2">
                    Choose one or more formats, set a strong password, and download the report as a protected ZIP.
                </div>
            </div>
            </div>
        </div>

        <div class="modal fade" id="export-password-modal" tabindex="-1" aria-labelledby="export-password-title" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="export-password-title">Export Password</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <label for="export-password-input" class="form-label small fw-semibold">ZIP Password</label>
                        <input id="export-password-input"
                               type="password"
                               class="form-control"
                               maxlength="128"
                               autocomplete="new-password"
                               placeholder="Enter strong password" />
                        <div class="form-text">
                            Minimum 8 characters with uppercase, lowercase, number, and symbol.
                        </div>
                        <div id="export-password-error" class="text-danger small mt-2" style="display:none;"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button id="btn-export-confirm" type="button" class="btn btn-success">Export</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ════════ COLUMN CUSTOMISER ════════ -->
        <div class="card mb-4 shadow-sm @(Model.SchemaTemplate == "" ? "disabled-div" : "")" aria-disabled=@(Model.SchemaTemplate == "")>
            <div class="card-header fw-semibold d-flex align-items-center justify-content-between">
                Column Customiser
                <span class="text-muted">
                    (Please create or select any template other than Default to adjust column)
                </span>
                <button class="btn btn-sm btn-link p-0 text-decoration-none text-muted"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#column-customiser-card-body"
                        aria-expanded="false"
                        aria-controls="column-customiser-card-body">
                    &#9660;
                </button>
            </div>
            <div id="column-customiser-card-body" class="collapse">
            <div class="card-body">
                <p class="text-muted small mb-3">
                    Drag chips to reorder &nbsp;|&nbsp;
                    The <span class="badge bg-light text-secondary border" style="font-size:.7rem;">grey badge</span>
                    shows the original column name &nbsp;→&nbsp; type in the box to rename it &nbsp;|&nbsp;
                    Use the checkbox to show/hide. Toggle auto-save on/off as needed, or click <strong>Save &amp; Apply</strong>.
                </p>

                <ul id="sortable-columns" class="list-unstyled d-flex flex-wrap gap-2 mb-3" style="min-height:48px;">
                    @{
                        var visible = Model.DisplayColumns.Where(c => c.IsVisible).OrderBy(c => c.Order).ToList();
                        var hiddenCols = Model.AvailableColumns
                        .Where(sys => !visible.Any(v => v.Key == sys.Key))
                        .Select(sys => new DataWarehousePower.Models.ColumnDefinition
            {
                Key = sys.Key,
                DefaultLabel = sys.DefaultLabel,
                DisplayLabel = sys.DefaultLabel,
                IsVisible = false,
                Order = 999
            });
                        var allChips = visible.Concat(hiddenCols).ToList();
                    }
                    @foreach (var col in allChips)
                    {
                        <li class="chip border rounded px-2 py-1 bg-white shadow-sm d-flex align-items-center gap-2 @(col.IsVisible ? "" : "opacity-50")"
                            data-key="@col.Key"
                            data-default-label="@col.DefaultLabel"
                            draggable="true"
                            style="cursor:grab; user-select:none;">
                            <span class="drag-handle text-muted" style="cursor:grab;">&#9776;</span>
                            <span class="badge bg-light text-secondary border"
                                  style="font-size:.7rem; white-space:nowrap;"
                                  title="Original column name">@col.DefaultLabel</span>
                            <span class="text-muted" style="font-size:.8rem;">→</span>
                            <input type="text"
                                   class="form-control form-control-sm label-input border-0 p-0"
                                   style="width:110px; background:transparent;"
                                   value="@col.DisplayLabel"
                                   maxlength="100"
                                   placeholder="@col.DefaultLabel"
                                   title="Display name (original: @col.DefaultLabel)"
                                   aria-label="Display label for @col.DefaultLabel" />
                            <input type="checkbox"
                                   class="form-check-input m-0 col-visible-toggle"
                            @(col.IsVisible ? "checked" : "")
                                   title="Show / hide column"
                                   aria-label="Show @col.DefaultLabel" />
                        </li>
                    }
                </ul>

                <div id="label-error" class="text-danger small mb-2" style="display:none;"></div>
                <div class="d-flex gap-2">
                    <button id="btn-apply" class="btn btn-primary btn-sm">Save &amp; Apply</button>
                    <button id="btn-reset" class="btn btn-outline-secondary btn-sm">Reset to Defaults</button>
                    <div class="form-check form-switch align-self-center ms-2">
                        <input id="auto-save-toggle" class="form-check-input" type="checkbox" />
                        <label class="form-check-label small" for="auto-save-toggle">Auto-save</label>
                    </div>
                    <span id="save-status" class="small align-self-center ms-1"></span>
                </div>
            </div>
        </div>
        </div>
    </div><!-- /col -->

    <div id="report-data-section" class="col-md-12 position-relative" aria-busy="false">
        <!-- ════════ DATA TABLE ════════ -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
            <div class="small text-muted">
                @if (Model.HasAppliedFilters)
                {
                    <span>Showing @Model.StartRow to @Model.EndRow of @Model.TotalRows records</span>
                }
                else
                {
                    <span>No data loaded yet.</span>
                }
            </div>
            <form method="get" action="@Url.Action("Index", "Report", new { id = Model.ReportId })" class="d-flex align-items-center gap-2" data-ajax-pagination-form="true">
                <input type="hidden" name="schemaTemplate" value="@Model.SchemaTemplate" />
                <input type="hidden" name="clientCode" value="@Model.ClientCode" />
                <input type="hidden" name="dateFrom" value="@Model.FilterDateFrom?.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="dateTo" value="@Model.FilterDateTo?.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="loadData" value="@Model.HasAppliedFilters.ToString().ToLowerInvariant()" />
                @foreach (var parameter in Model.RuntimeParameters)
                {
                    <input type="hidden" name="@parameter.QueryKey" value="@parameter.Value" />
                }
                <label for="page-size" class="small text-muted mb-0">Rows per page</label>
                <select id="page-size" name="pageSize" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="10" selected="@(Model.PageSize == 10 ? "selected" : null)">10</option>
                    <option value="25" selected="@(Model.PageSize == 25 ? "selected" : null)">25</option>
                    <option value="50" selected="@(Model.PageSize == 50 ? "selected" : null)">50</option>
                    <option value="100" selected="@(Model.PageSize == 100 ? "selected" : null)">100</option>
                </select>
            </form>
        </div>

        <div class="table-responsive shadow-sm">
            <table class="table table-bordered table-hover align-middle" id="report-table">
                <thead class="table-dark">
                    <tr id="table-header-row">
                        @if (Model.HasAppliedFilters)
                        {
                            @foreach (var col in Model.DisplayColumns.Where(c => c.IsVisible).OrderBy(c => c.Order))
                            {
                                <th data-key="@col.Key">@col.DisplayLabel</th>
                            }
                        }
                    </tr>
                </thead>
                <tbody id="table-body" style="font-size: 0.85rem;">
                    @if (Model.HasAppliedFilters)
                    {
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                @foreach (var col in Model.DisplayColumns.Where(c => c.IsVisible).OrderBy(c => c.Order))
                                {
                                    <td>@(row.ContainsKey(col.Key) ? row[col.Key]?.ToString() : "")</td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@Math.Max(1, Model.DisplayColumns.Count(c => c.IsVisible))" class="text-muted text-center py-4">
                                Select a client code and click Apply to view data.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-2 flex-wrap gap-2">
            <div class="small text-muted">
                Page @Model.Page of @Model.TotalPages
            </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                     <form method="get" action="@Url.Action("Index", "Report", new { id = Model.ReportId })" class="d-flex align-items-center gap-2" data-ajax-pagination-form="true">
                          <input type="hidden" name="schemaTemplate" value="@Model.SchemaTemplate" />
                          <input type="hidden" name="clientCode" value="@Model.ClientCode" />
                          <input type="hidden" name="dateFrom" value="@Model.FilterDateFrom?.ToString("yyyy-MM-dd")" />
                          <input type="hidden" name="dateTo" value="@Model.FilterDateTo?.ToString("yyyy-MM-dd")" />
                          <input type="hidden" name="loadData" value="@Model.HasAppliedFilters.ToString().ToLowerInvariant()" />
                          <input type="hidden" name="pageSize" value="@Model.PageSize" />
                          @foreach (var parameter in Model.RuntimeParameters)
                          {
                                <input type="hidden" name="@parameter.QueryKey" value="@parameter.Value" />
                          }
                          <label for="jump-to-page" class="small text-muted mb-0">Go to</label>
                          <input id="jump-to-page"
                                    name="page"
                                    type="number"
                                    class="form-control form-control-sm"
                                    style="width: 88px;"
                                    min="1"
                                    max="@Math.Max(1, Model.TotalPages)"
                                    value="@Model.Page" />
                          <button type="submit" class="btn btn-sm btn-outline-secondary">Go</button>
                     </form>

                     <div class="btn-group" role="group" aria-label="Pagination">
                          <a class="btn btn-sm btn-outline-secondary @(Model.Page <= 1 ? "disabled" : "")"
                              data-ajax-pagination-link="true"
                              href="@BuildReportUrl(Model.ReportId, 1, Model.PageSize, null, true, Model.HasAppliedFilters)"
                              aria-disabled="@(Model.Page <= 1 ? "true" : "false")">First</a>
                          <a class="btn btn-sm btn-outline-secondary @(Model.Page <= 1 ? "disabled" : "")"
                              data-ajax-pagination-link="true"
                              href="@BuildReportUrl(Model.ReportId, Model.Page - 1, Model.PageSize, null, true, Model.HasAppliedFilters)"
                              aria-disabled="@(Model.Page <= 1 ? "true" : "false")">Previous</a>
                          <a class="btn btn-sm btn-outline-secondary @(Model.Page >= Model.TotalPages ? "disabled" : "")"
                              data-ajax-pagination-link="true"
                              href="@BuildReportUrl(Model.ReportId, Model.Page + 1, Model.PageSize, null, true, Model.HasAppliedFilters)"
                              aria-disabled="@(Model.Page >= Model.TotalPages ? "true" : "false")">Next</a>
                          <a class="btn btn-sm btn-outline-secondary @(Model.Page >= Model.TotalPages ? "disabled" : "")"
                              data-ajax-pagination-link="true"
                              href="@BuildReportUrl(Model.ReportId, Model.TotalPages, Model.PageSize, null, true, Model.HasAppliedFilters)"
                              aria-disabled="@(Model.Page >= Model.TotalPages ? "true" : "false")">Last</a>
                     </div>
            </div>
        </div>

        <div id="report-data-loading-overlay" class="report-data-loading-overlay d-none" role="status" aria-live="polite">
            <div class="d-flex align-items-center gap-2 bg-white border rounded px-3 py-2 shadow-sm">
                <div class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></div>
                <span class="small text-muted">Loading data...</span>
            </div>
        </div>
    </div>

</div><!-- /row -->

<style>
    .disabled-div {
        pointer-events: none; /* blocks clicks, links, buttons inside */
        opacity: 0.5; /* faded look */
        user-select: none; /* prevents text selection */
    }

    #report-data-section.report-data-loading {
        pointer-events: none;
        user-select: none;
    }

    .report-data-loading-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.55);
        z-index: 10;
    }
</style>

@section Scripts {
    <script>
        const reportId = @Model.ReportId;
        const initialSchemaTemplate = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SchemaTemplate));
        const initialPreferenceId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ActivePreferenceId));
        const schemaTemplatePreferenceIds = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SchemaTemplatePreferenceIds));
        let activePreferenceId = initialPreferenceId;
        const schemaTemplateSearchInput = document.getElementById('client-code-search');
        const schemaTemplateDropdownToggle = document.getElementById('client-code-dropdown-toggle');
        const schemaTemplateOptions = document.getElementById('client-code-options');
        const schemaTemplateSelect = document.getElementById('client-code-select');
        const schemaTemplateNewInput = document.getElementById('client-code-new');
        const clientApplyButton = document.getElementById('btn-client-apply');
        const clientClearButton = document.getElementById('btn-client-clear');
        const clientRenameButton = document.getElementById('btn-client-rename');
        const clientDeleteButton = document.getElementById('btn-client-delete');
        const clientCreateButton = document.getElementById('btn-client-create');
        const schemaTemplateError = document.getElementById('client-code-error');
        const schemaTemplateStatus = document.getElementById('client-code-status');
        const reportSidebarFilter = document.getElementById('report-sidebar-filter');
        const reportSidebarEmpty = document.getElementById('report-sidebar-empty');
        const exportButton = document.getElementById('btn-export');
        const scheduleReportButton = document.getElementById('btn-schedule-report');
        const exportFormatContainer = document.getElementById('export-format');
        const exportStatus = document.getElementById('export-status');
        const filterForm = document.getElementById('report-filter-form');
        const filterSchemaTemplateInput = document.getElementById('filter-schema-template');
        const filterClientCodeInput = document.getElementById('filter-client-code');
        const filterDateFromInput = document.getElementById('filter-date-from');
        const filterDateToInput = document.getElementById('filter-date-to');
        const runtimeParameterInputs = [...document.querySelectorAll('[data-runtime-param="true"]')];
        const exportPasswordModalElement = document.getElementById('export-password-modal');
        const exportPasswordInput = document.getElementById('export-password-input');
        const exportPasswordError = document.getElementById('export-password-error');
        const exportConfirmButton = document.getElementById('btn-export-confirm');
        const exportPasswordModal = new bootstrap.Modal(exportPasswordModalElement);
        const autoSaveToggle = document.getElementById('auto-save-toggle');
        const defaultColumnState = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.AvailableColumns
                .OrderBy(column => column.Order)
                .Select((column, index) => new
                {
                    key = column.Key,
                    defaultLabel = column.DefaultLabel,
                    order = column.Order > 0 ? column.Order : index + 1
                })
                .ToList()));
        let autoSaveTimer = null;
        const autoSaveStorageKey = `report:${reportId}:columnAutoSave`;
        let isAutoSaveEnabled = false;

        try {
            const persistedAutoSave = localStorage.getItem(autoSaveStorageKey);
            if (persistedAutoSave !== null) {
                isAutoSaveEnabled = persistedAutoSave === 'true';
            }
        } catch {
            // Ignore storage access issues and keep default setting.
        }

        if (autoSaveToggle) {
            autoSaveToggle.checked = isAutoSaveEnabled;
            autoSaveToggle.addEventListener('change', () => {
                isAutoSaveEnabled = autoSaveToggle.checked;

                if (!isAutoSaveEnabled && autoSaveTimer) {
                    clearTimeout(autoSaveTimer);
                    autoSaveTimer = null;
                }

                try {
                    localStorage.setItem(autoSaveStorageKey, String(isAutoSaveEnabled));
                } catch {
                    // Ignore storage access issues.
                }
            });
        }

        // Embed all rows as JSON for client-side re-render
        const allRows = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Rows));

        clientApplyButton.addEventListener('click', () => {
            hideSchemaTemplateError();
            navigateToSchemaTemplate(getActiveSchemaTemplate());
        });

        clientClearButton.addEventListener('click', () => {
            hideSchemaTemplateError();
            schemaTemplateSelect.value = '';
            schemaTemplateNewInput.value = '';
            navigateToSchemaTemplate('');
        });

        schemaTemplateSearchInput.addEventListener('input', e => {
            hideSchemaTemplateError();
            const searchValue = e.target instanceof HTMLInputElement ? e.target.value : '';
            renderSchemaTemplateOptions(searchValue);
        });

        clientCreateButton.addEventListener('click', async () => {
            await applyNewSchemaTemplateAsync();
        });

        clientRenameButton.addEventListener('click', async () => {
            await renameSchemaTemplateAsync();
        });

        clientDeleteButton.addEventListener('click', async () => {
            await deleteSchemaTemplateAsync();
        });

        schemaTemplateNewInput.addEventListener('keydown', async e => {
            if (e.key === 'Enter') {
                e.preventDefault();
                await applyNewSchemaTemplateAsync();
            }
        });

        exportButton.addEventListener('click', async () => {
            const selectedFormats = getSelectedExportFormats();
            if (!selectedFormats.length) {
                exportStatus.textContent = 'Select at least one format.';
                exportStatus.className = 'small align-self-center text-danger';
                return;
            }

            hideExportPasswordError();
            exportPasswordInput.value = '';
            exportPasswordModal.show();
            exportPasswordInput.focus();
        });

        if (scheduleReportButton) {
            scheduleReportButton.addEventListener('click', () => {
                const scheduleUrl = new URL(`/Report/ScheduleReport/${reportId}`, window.location.origin);
                const schemaTemplate = getActiveSchemaTemplate();
                const clientCode = filterClientCodeInput.value.trim();
                const runtimeParameters = getRuntimeParameterValues();
                const selectedFormats = getSelectedExportFormats();
                const returnUrl = new URL(window.location.href);

                if (schemaTemplate) {
                    scheduleUrl.searchParams.set('schemaTemplate', schemaTemplate);
                    returnUrl.searchParams.set('schemaTemplate', schemaTemplate);
                } else {
                    returnUrl.searchParams.delete('schemaTemplate');
                }

                if (clientCode) {
                    scheduleUrl.searchParams.set('clientCode', clientCode);
                    returnUrl.searchParams.set('clientCode', clientCode);
                } else {
                    returnUrl.searchParams.delete('clientCode');
                }

                if (filterDateFromInput.value) {
                    returnUrl.searchParams.set('dateFrom', filterDateFromInput.value);
                } else {
                    returnUrl.searchParams.delete('dateFrom');
                }

                if (filterDateToInput.value) {
                    returnUrl.searchParams.set('dateTo', filterDateToInput.value);
                } else {
                    returnUrl.searchParams.delete('dateTo');
                }

                Object.entries(runtimeParameters).forEach(([key, value]) => {
                    if (value) {
                        returnUrl.searchParams.set(key, value);
                    } else {
                        returnUrl.searchParams.delete(key);
                    }
                });

                selectedFormats.forEach(format => scheduleUrl.searchParams.append('formats', format));
                scheduleUrl.searchParams.set('returnUrl', `${returnUrl.pathname}${returnUrl.search}`);

                window.location.href = scheduleUrl.toString();
            });
        }

        exportConfirmButton.addEventListener('click', async () => {
            const password = exportPasswordInput.value.trim();
            const passwordValidationError = getPasswordValidationError(password);

            if (passwordValidationError) {
                showExportPasswordError(passwordValidationError);
                return;
            }

            hideExportPasswordError();
            exportPasswordModal.hide();
            await exportReportAsync(getSelectedExportFormats(), password);
        });

        exportPasswordInput.addEventListener('keydown', async e => {
            if (e.key === 'Enter') {
                e.preventDefault();
                exportConfirmButton.click();
            }
        });

        // ── Drag-and-drop ─────────────────────────────────────────────────────────────
        const sortable = document.getElementById('sortable-columns');
        let dragSrc = null;

        sortable.addEventListener('dragstart', e => {
            dragSrc = e.target.closest('li.chip');
            if (dragSrc) e.dataTransfer.effectAllowed = 'move';
        });
        sortable.addEventListener('dragover', e => {
            e.preventDefault();
            const target = e.target.closest('li.chip');
            if (target && target !== dragSrc) {
                const mid = target.getBoundingClientRect().left + target.getBoundingClientRect().width / 2;
                sortable.insertBefore(dragSrc, e.clientX < mid ? target : target.nextSibling);
            }
        });
        sortable.addEventListener('dragend', () => {
            dragSrc = null;
            scheduleAutoSave();
        });

        // ── Visibility toggle ─────────────────────────────────────────────────────────
        sortable.addEventListener('change', e => {
            const chk = e.target.closest('.col-visible-toggle');
            if (!chk) return;
            chk.closest('li.chip').classList.toggle('opacity-50', !chk.checked);
            scheduleAutoSave();
        });

        sortable.addEventListener('input', e => {
            const labelInput = e.target.closest('.label-input');
            if (!labelInput) return;
            scheduleAutoSave();
        });

        // ── Save & Apply ─────────────────────────────────────────────────────────────
        document.getElementById('btn-apply').addEventListener('click', async () => {
            await saveColumnsAsync(false);
        });

        async function saveColumnsAsync(isAutoSave) {
            const errorEl = document.getElementById('label-error');
            const statusEl = document.getElementById('save-status');
            const activeSchemaTemplate = getActiveSchemaTemplate();
            errorEl.style.display = 'none';

            const chips = [...sortable.querySelectorAll('li.chip')];

            let hasError = false;
            chips.forEach(chip => {
                const input = chip.querySelector('.label-input');
                const bad = chip.querySelector('.col-visible-toggle').checked && !input.value.trim();
                input.classList.toggle('border', bad);
                input.classList.toggle('border-danger', bad);
                if (bad) hasError = true;
            });

            if (hasError) {
                errorEl.textContent = 'Column label cannot be blank.';
                errorEl.style.display = 'block';
                return;
            }

            const columns = buildColumnsFromChips(chips);

            statusEl.textContent = isAutoSave ? 'Auto-saving…' : 'Saving…';
            statusEl.className = 'small align-self-center ms-1 text-muted';

            try {
                const resp = await fetch(`/Report/${reportId}/SavePreferences`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ schemaTemplate: activeSchemaTemplate, preferenceId: activePreferenceId, columns })
                });
                const json = await resp.json();
                if (resp.ok && json.success) {
                    if (typeof json.preferenceId === 'number') {
                        activePreferenceId = json.preferenceId;
                        upsertSchemaTemplateOption(activeSchemaTemplate, json.preferenceId);
                    }
                    syncSchemaTemplateUi(activeSchemaTemplate);
                    statusEl.textContent = isAutoSave ? '✓ Auto-saved' : '✓ Saved';
                    statusEl.className = 'small align-self-center ms-1 text-success';
                    renderTable(columns);
                    setTimeout(() => { statusEl.textContent = ''; }, 3000);
                } else {
                    statusEl.textContent = '✗ ' + (json.error || 'Save failed');
                    statusEl.className = 'small align-self-center ms-1 text-danger';
                }
            } catch {
                statusEl.textContent = '✗ Network error';
                statusEl.className = 'small align-self-center ms-1 text-danger';
            }
        }

        function scheduleAutoSave() {
            if (!isAutoSaveEnabled) {
                return;
            }

            if (autoSaveTimer) {
                clearTimeout(autoSaveTimer);
            }

            autoSaveTimer = setTimeout(async () => {
                autoSaveTimer = null;
                await saveColumnsAsync(true);
            }, 500);
        }

        // ── Reset to defaults ─────────────────────────────────────────────────────────
        document.getElementById('btn-reset').addEventListener('click', async () => {
            const statusEl = document.getElementById('save-status');
            const activeSchemaTemplate = getActiveSchemaTemplate();
            const defaultOrderByKey = defaultColumnState.reduce((acc, column) => {
                acc[column.key] = column.order;
                return acc;
            }, {});

            const chips = [...sortable.querySelectorAll('li.chip')];
            chips.forEach(chip => {
                chip.querySelector('.label-input').value = chip.dataset.defaultLabel;
                chip.querySelector('.col-visible-toggle').checked = true;
                chip.classList.remove('opacity-50');
                chip.querySelector('.label-input').classList.remove('border', 'border-danger');
            });

            const chipsByKey = chips.reduce((acc, chip) => {
                acc[chip.dataset.key] = chip;
                return acc;
            }, {});

            const sortedKeys = Object.keys(chipsByKey)
                .sort((left, right) => {
                    const leftOrder = defaultOrderByKey[left] ?? Number.MAX_SAFE_INTEGER;
                    const rightOrder = defaultOrderByKey[right] ?? Number.MAX_SAFE_INTEGER;
                    return leftOrder - rightOrder;
                });

            sortedKeys.forEach(key => {
                const chip = chipsByKey[key];
                if (chip) {
                    sortable.appendChild(chip);
                }
            });

            const defaultColumns = sortedKeys.map((key, index) => {
                const chip = chipsByKey[key];
                return {
                    key,
                    isVisible: true,
                    order: defaultOrderByKey[key] ?? index + 1,
                    displayLabel: chip?.dataset.defaultLabel || key
                };
            });

            statusEl.textContent = 'Resetting…';
            statusEl.className = 'small align-self-center ms-1 text-muted';

            try {
                const resp = await fetch(`/Report/${reportId}/SavePreferences`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ schemaTemplate: activeSchemaTemplate, preferenceId: activePreferenceId, columns: defaultColumns })
                });
                const json = await resp.json();
                if (resp.ok && json.success) {
                    if (typeof json.preferenceId === 'number') {
                        activePreferenceId = json.preferenceId;
                        upsertSchemaTemplateOption(activeSchemaTemplate, json.preferenceId);
                    }
                    syncSchemaTemplateUi(activeSchemaTemplate);
                    statusEl.textContent = '✓ Reset & saved';
                    statusEl.className = 'small align-self-center ms-1 text-success';
                    renderTable(defaultColumns);
                    setTimeout(() => { statusEl.textContent = ''; }, 3000);
                }
            } catch { /* silent */ }
        });

        // ── Re-render table ───────────────────────────────────────────────────────────
        function renderTable(cols) {
            const vis = cols.filter(c => c.isVisible);

            document.getElementById('table-header-row').innerHTML =
                vis.map(c => `<th data-key="${esc(c.key)}">${esc(c.displayLabel)}</th>`).join('');

            document.getElementById('table-body').innerHTML =
                allRows.map(row => {
                    const cells = vis.map(c => {
                        // keys in allRows use original casing from DB
                        const val = Object.entries(row).find(([k]) => k.toLowerCase() === c.key.toLowerCase())?.[1];
                        return `<td>${val != null ? esc(String(val)) : ''}</td>`;
                    }).join('');
                    return `<tr>${cells}</tr>`;
                }).join('');
        }

        function esc(s) {
            return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        function navigateToSchemaTemplate(value) {
            const trimmed = value.trim();
            const url = new URL(window.location.href);

            if (trimmed) {
                url.searchParams.set('schemaTemplate', trimmed);
            } else {
                url.searchParams.delete('schemaTemplate');
            }

            window.location.href = url.toString();
        }

        function applyNewSchemaTemplate() {
            return applyNewSchemaTemplateAsync();
        }

        async function applyNewSchemaTemplateAsync() {
            hideSchemaTemplateError();

            const newSchemaTemplate = schemaTemplateNewInput.value.trim();
            if (!newSchemaTemplate) {
                showSchemaTemplateError('New client code cannot be blank.');
                return;
            }

            const existingOption = [...schemaTemplateSelect.options].find(option =>
                option.value.localeCompare(newSchemaTemplate, undefined, { sensitivity: 'accent' }) === 0);

            if (existingOption) {
                schemaTemplateSelect.value = existingOption.value;
                navigateToSchemaTemplate(existingOption.value);
                return;
            }

            const statusEl = document.getElementById('save-status');
            const chips = [...sortable.querySelectorAll('li.chip')];
            const columns = buildColumnsFromChips(chips);

            statusEl.textContent = 'Creating scope…';
            statusEl.className = 'small align-self-center ms-1 text-muted';

            try {
                const response = await fetch(`/Report/${reportId}/SavePreferences`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ schemaTemplate: newSchemaTemplate, preferenceId: null, columns })
                });

                const json = await response.json();
                if (!response.ok || !json.success) {
                    showSchemaTemplateError(json.error || 'Failed to create client code.');
                    statusEl.textContent = '✗ ' + (json.error || 'Create failed');
                    statusEl.className = 'small align-self-center ms-1 text-danger';
                    return;
                }

                if (typeof json.preferenceId === 'number') {
                    activePreferenceId = json.preferenceId;
                }
                upsertSchemaTemplateOption(newSchemaTemplate, activePreferenceId);
                syncSchemaTemplateUi(newSchemaTemplate);
                statusEl.textContent = '✓ Scope created';
                statusEl.className = 'small align-self-center ms-1 text-success';
                navigateToSchemaTemplate(newSchemaTemplate);
            } catch {
                showSchemaTemplateError('Network error while creating client code.');
                statusEl.textContent = '✗ Network error';
                statusEl.className = 'small align-self-center ms-1 text-danger';
            }
        }

        function getActiveSchemaTemplate() {
            const newSchemaTemplate = schemaTemplateNewInput.value.trim();
            if (newSchemaTemplate.length > 0) {
                return newSchemaTemplate;
            }

            return schemaTemplateSelect.value.trim();
        }

        function buildColumnsFromChips(chips) {
            return chips.map((chip, i) => ({
                key: chip.dataset.key,
                isVisible: chip.querySelector('.col-visible-toggle').checked,
                order: i + 1,
                displayLabel: chip.querySelector('.label-input').value.trim() || chip.dataset.defaultLabel
            }));
        }

        function upsertSchemaTemplateOption(value, preferenceId) {
            const normalizedValue = value.trim();
            if (!normalizedValue) {
                return;
            }

            if (typeof preferenceId === 'number') {
                Object.keys(schemaTemplatePreferenceIds)
                    .filter(key => key.localeCompare(normalizedValue, undefined, { sensitivity: 'accent' }) === 0 && key !== normalizedValue)
                    .forEach(key => delete schemaTemplatePreferenceIds[key]);
                schemaTemplatePreferenceIds[normalizedValue] = preferenceId;
            }

            const existingOption = [...schemaTemplateSelect.options].find(option =>
                option.value.localeCompare(normalizedValue, undefined, { sensitivity: 'accent' }) === 0);

            if (existingOption) {
                existingOption.value = normalizedValue;
                existingOption.textContent = normalizedValue;
                return;
            }

            const newOption = document.createElement('option');
            newOption.value = normalizedValue;
            newOption.textContent = normalizedValue;
            schemaTemplateSelect.appendChild(newOption);
            renderSchemaTemplateOptions(schemaTemplateSearchInput.value);
        }

        function syncSchemaTemplateUi(value) {
            const normalizedValue = value.trim();
            schemaTemplateSelect.value = normalizedValue;
            schemaTemplateNewInput.value = normalizedValue;
            activePreferenceId = getPreferenceIdForSchemaTemplate(normalizedValue);
            schemaTemplateDropdownToggle.textContent = normalizedValue || 'Default';
            renderSchemaTemplateOptions(schemaTemplateSearchInput.value);

            const scopeLabel = normalizedValue || 'Default';
            schemaTemplateStatus.innerHTML = `Preference scope: <strong>${esc(scopeLabel)}</strong>`;
        }

        function getPreferenceIdForSchemaTemplate(schemaTemplate) {
            const normalized = schemaTemplate.trim();
            if (!normalized) {
                return null;
            }

            const exactKey = Object.keys(schemaTemplatePreferenceIds).find(key =>
                key.localeCompare(normalized, undefined, { sensitivity: 'accent' }) === 0);

            return typeof exactKey === 'string' ? schemaTemplatePreferenceIds[exactKey] : null;
        }

        async function renameSchemaTemplateAsync() {
            hideSchemaTemplateError();

            if (typeof activePreferenceId !== 'number') {
                showSchemaTemplateError('Save this client code first before renaming.');
                return;
            }

            const currentSchemaTemplate = schemaTemplateSelect.value.trim();
            const newSchemaTemplate = schemaTemplateNewInput.value.trim();
            if (!newSchemaTemplate) {
                showSchemaTemplateError('New client code cannot be blank.');
                return;
            }

            const existingId = getPreferenceIdForSchemaTemplate(newSchemaTemplate);
            if (typeof existingId === 'number' && existingId !== activePreferenceId) {
                showSchemaTemplateError('Client code already exists.');
                return;
            }

            const statusEl = document.getElementById('save-status');
            statusEl.textContent = 'Renaming…';
            statusEl.className = 'small align-self-center ms-1 text-muted';

            try {
                const response = await fetch(`/Report/${reportId}/UpdateSchemaTemplate`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ preferenceId: activePreferenceId, newSchemaTemplate: newSchemaTemplate })
                });

                const json = await response.json();
                if (!response.ok || !json.success) {
                    showSchemaTemplateError(json.error || 'Failed to rename client code.');
                    statusEl.textContent = '✗ ' + (json.error || 'Rename failed');
                    statusEl.className = 'small align-self-center ms-1 text-danger';
                    return;
                }

                if (currentSchemaTemplate) {
                    delete schemaTemplatePreferenceIds[currentSchemaTemplate];
                    removeSchemaTemplateOption(currentSchemaTemplate);
                }

                activePreferenceId = json.preferenceId;
                upsertSchemaTemplateOption(json.schemaTemplate, activePreferenceId);
                syncSchemaTemplateUi(json.schemaTemplate);
                statusEl.textContent = '✓ Renamed';
                statusEl.className = 'small align-self-center ms-1 text-success';
                navigateToSchemaTemplate(json.schemaTemplate);
            } catch {
                showSchemaTemplateError('Network error while renaming client code.');
                statusEl.textContent = '✗ Network error';
                statusEl.className = 'small align-self-center ms-1 text-danger';
            }
        }

        async function deleteSchemaTemplateAsync() {
            hideSchemaTemplateError();

            if (typeof activePreferenceId !== 'number') {
                showSchemaTemplateError('No saved client code scope selected.');
                return;
            }

            const selectedSchemaTemplate = schemaTemplateSelect.value.trim();
            if (!selectedSchemaTemplate) {
                showSchemaTemplateError('Default scope cannot be deleted.');
                return;
            }

            if (!window.confirm(`Delete preference scope "${selectedSchemaTemplate}"?`)) {
                return;
            }

            const statusEl = document.getElementById('save-status');
            statusEl.textContent = 'Deleting…';
            statusEl.className = 'small align-self-center ms-1 text-muted';

            try {
                const response = await fetch(`/Report/${reportId}/DeleteSchemaTemplate`, {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ preferenceId: activePreferenceId })
                });

                const json = await response.json();
                if (!response.ok || !json.success) {
                    showSchemaTemplateError(json.error || 'Failed to delete client code.');
                    statusEl.textContent = '✗ ' + (json.error || 'Delete failed');
                    statusEl.className = 'small align-self-center ms-1 text-danger';
                    return;
                }

                delete schemaTemplatePreferenceIds[selectedSchemaTemplate];
                removeSchemaTemplateOption(selectedSchemaTemplate);
                activePreferenceId = null;
                statusEl.textContent = '✓ Deleted';
                statusEl.className = 'small align-self-center ms-1 text-success';
                navigateToSchemaTemplate('');
            } catch {
                showSchemaTemplateError('Network error while deleting client code.');
                statusEl.textContent = '✗ Network error';
                statusEl.className = 'small align-self-center ms-1 text-danger';
            }
        }

        function removeSchemaTemplateOption(value) {
            const normalizedValue = value.trim();
            if (!normalizedValue) {
                return;
            }

            const option = [...schemaTemplateSelect.options].find(item =>
                item.value.localeCompare(normalizedValue, undefined, { sensitivity: 'accent' }) === 0);

            if (option) {
                option.remove();
            }
        }

        function renderSchemaTemplateOptions(searchValue) {
            const normalizedSearch = searchValue.trim().toLocaleLowerCase();
            const selectedValue = schemaTemplateSelect.value;
            schemaTemplateOptions.innerHTML = '';

            [...schemaTemplateSelect.options].forEach((option, index) => {
                const isDefault = index === 0;
                const isMatch = !normalizedSearch || option.text.toLocaleLowerCase().includes(normalizedSearch);
                const isSelected = option.value.localeCompare(selectedValue, undefined, { sensitivity: 'accent' }) === 0;
                if (!(isDefault || isMatch || isSelected)) {
                    return;
                }

                const optionButton = document.createElement('button');
                optionButton.type = 'button';
                optionButton.className = `list-group-item list-group-item-action py-1 px-2${isSelected ? ' active' : ''}`;
                optionButton.textContent = option.text;
                optionButton.addEventListener('click', () => {
                    hideSchemaTemplateError();
                    schemaTemplateSelect.value = option.value;
                    syncSchemaTemplateUi(option.value);
                    navigateToSchemaTemplate(option.value);
                });
                schemaTemplateOptions.appendChild(optionButton);
            });

            if (!schemaTemplateOptions.children.length) {
                const empty = document.createElement('div');
                empty.className = 'text-muted small px-2 py-1';
                empty.textContent = 'No matches';
                schemaTemplateOptions.appendChild(empty);
            }
        }

        function showSchemaTemplateError(message) {
            schemaTemplateError.textContent = message;
            schemaTemplateError.style.display = 'block';
        }

        function hideSchemaTemplateError() {
            schemaTemplateError.textContent = '';
            schemaTemplateError.style.display = 'none';
        }

        function showExportPasswordError(message) {
            exportPasswordError.textContent = message;
            exportPasswordError.style.display = 'block';
        }

        function hideExportPasswordError() {
            exportPasswordError.textContent = '';
            exportPasswordError.style.display = 'none';
        }

        function getPasswordValidationError(password) {
            if (!password) {
                return 'Password is required.';
            }

            if (password.length < 8) {
                return 'Password must be at least 8 characters.';
            }

            const hasUpper = /[A-Z]/.test(password);
            const hasLower = /[a-z]/.test(password);
            const hasNumber = /\d/.test(password);
            const hasSymbol = /[^A-Za-z0-9]/.test(password);

            if (!(hasUpper && hasLower && hasNumber && hasSymbol)) {
                return 'Password must include uppercase, lowercase, number, and symbol.';
            }

            return '';
        }

        async function exportReportAsync(format, password) {
            exportStatus.textContent = 'Exporting...';
            exportStatus.className = 'small align-self-center text-muted';
            exportButton.disabled = true;

            const formats = Array.isArray(format) ? format : [format];

            const payload = {
                format: formats[0] || null,
                formats,
                password,
                schemaTemplate: getActiveSchemaTemplate(),
                clientCode: filterClientCodeInput.value.trim() || null,
                dateFrom: filterDateFromInput.value || null,
                    dateTo: filterDateToInput.value || null,
                    parameters: getRuntimeParameterValues()
            };

            try {
                const response = await fetch(`/Report/${reportId}/Export`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (!response.ok) {
                    const errorBody = await response.json().catch(() => ({}));
                    exportStatus.textContent = 'Export failed: ' + (errorBody.error || response.statusText);
                    exportStatus.className = 'small align-self-center text-danger';
                    return;
                }

                const blob = await response.blob();
                const downloadUrl = URL.createObjectURL(blob);
                const anchor = document.createElement('a');
                const contentDisposition = response.headers.get('content-disposition') || '';
                const fileNameMatch = contentDisposition.match(/filename\*?=(?:UTF-8'')?"?([^";]+)"?/i);
                const fileName = fileNameMatch ? decodeURIComponent(fileNameMatch[1]) : 'report_export.zip';

                anchor.href = downloadUrl;
                anchor.download = fileName;
                document.body.appendChild(anchor);
                anchor.click();
                anchor.remove();
                URL.revokeObjectURL(downloadUrl);

                exportStatus.textContent = `ZIP download started (${formats.length} format${formats.length === 1 ? '' : 's'}).`;
                exportStatus.className = 'small align-self-center text-success';
            } catch {
                exportStatus.textContent = 'Network error during export.';
                exportStatus.className = 'small align-self-center text-danger';
            } finally {
                exportButton.disabled = false;
            }
        }

        function getSelectedExportFormats() {
            if (!exportFormatContainer) {
                return [];
            }

            return [...exportFormatContainer.querySelectorAll('input[type="checkbox"]:checked')]
                .map(input => input.value);
        }

        function getRuntimeParameterValues() {
            return runtimeParameterInputs.reduce((acc, input) => {
                const key = input.getAttribute('data-param-key') || '';
                if (!key) {
                    return acc;
                }

                const value = (input.value || '').trim();
                acc[key] = value || null;
                return acc;
            }, {});
        }

        if (filterForm && filterSchemaTemplateInput) {
            filterForm.addEventListener('submit', () => {
                filterSchemaTemplateInput.value = getActiveSchemaTemplate();
            });
        }

        document.querySelectorAll('a[data-target-url]').forEach(link => {
            const targetUrl = link.getAttribute('data-target-url');
            if (targetUrl) {
                link.setAttribute('href', targetUrl);
            }
        });

        function filterSidebarReports() {
            if (!reportSidebarFilter) {
                return;
            }

            const query = reportSidebarFilter.value.trim().toLocaleLowerCase();
            const reportItems = [...document.querySelectorAll('.report-sidebar-item')];
            let visibleCount = 0;

            reportItems.forEach(item => {
                const reportName = (item.getAttribute('data-report-name') || '').toLocaleLowerCase();
                const isVisible = !query || reportName.includes(query);
                item.classList.toggle('d-none', !isVisible);
                if (isVisible) {
                    visibleCount += 1;
                }
            });

            if (reportSidebarEmpty) {
                reportSidebarEmpty.classList.toggle('d-none', visibleCount > 0);
            }
        }

        if (reportSidebarFilter) {
            reportSidebarFilter.value = '';
            reportSidebarFilter.addEventListener('input', filterSidebarReports);
            filterSidebarReports();
        }

        const reportDataSection = document.getElementById('report-data-section');

        function setReportDataLoading(isLoading) {
            if (!reportDataSection) {
                return;
            }

            reportDataSection.classList.toggle('report-data-loading', !!isLoading);
            reportDataSection.setAttribute('aria-busy', isLoading ? 'true' : 'false');

            const loadingOverlay = reportDataSection.querySelector('#report-data-loading-overlay');
            if (loadingOverlay) {
                loadingOverlay.classList.toggle('d-none', !isLoading);
            }
        }

        async function loadReportDataSectionAsync(targetUrl, pushHistory = true) {
            if (!reportDataSection) {
                window.location.href = targetUrl;
                return;
            }

            try {
                setReportDataLoading(true);

                const response = await fetch(targetUrl, {
                    method: 'GET',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                if (!response.ok) {
                    throw new Error('Failed to load report page.');
                }

                const html = await response.text();
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                const nextDataSection = doc.getElementById('report-data-section');

                if (!nextDataSection) {
                    throw new Error('Report data section not found in response.');
                }

                reportDataSection.innerHTML = nextDataSection.innerHTML;

                if (pushHistory) {
                    window.history.pushState({ reportDataUrl: targetUrl }, '', targetUrl);
                }
            } catch {
                window.location.href = targetUrl;
            } finally {
                setReportDataLoading(false);
            }
        }

        document.addEventListener('click', event => {
            const link = event.target.closest('a[data-ajax-pagination-link="true"]');
            if (!link) {
                return;
            }

            if (link.classList.contains('disabled') || link.getAttribute('aria-disabled') === 'true') {
                event.preventDefault();
                return;
            }

            event.preventDefault();
            loadReportDataSectionAsync(link.href, true);
        });

        document.addEventListener('submit', event => {
            const form = event.target.closest('form[data-ajax-pagination-form="true"]');
            if (!form) {
                return;
            }

            event.preventDefault();

            const action = form.getAttribute('action') || window.location.pathname;
            const url = new URL(action, window.location.origin);
            const formData = new FormData(form);

            for (const [key, value] of formData.entries()) {
                const text = String(value ?? '').trim();
                if (text) {
                    url.searchParams.set(key, text);
                } else {
                    url.searchParams.delete(key);
                }
            }

            loadReportDataSectionAsync(url.toString(), true);
        });

        window.addEventListener('popstate', () => {
            loadReportDataSectionAsync(window.location.href, false);
        });

        syncSchemaTemplateUi(initialSchemaTemplate);

        const exportCollapseEl = document.getElementById('export-card-body');
        const exportCollapseToggle = exportCollapseEl?.previousElementSibling?.querySelector('[data-bs-target="#export-card-body"]');
        if (exportCollapseEl && exportCollapseToggle) {
            exportCollapseEl.addEventListener('hide.bs.collapse', () => { exportCollapseToggle.innerHTML = '&#9660;'; });
            exportCollapseEl.addEventListener('show.bs.collapse', () => { exportCollapseToggle.innerHTML = '&#9650;'; });
        }

        const columnCustomiserCollapseEl = document.getElementById('column-customiser-card-body');
        const columnCustomiserCollapseToggle = columnCustomiserCollapseEl?.previousElementSibling?.querySelector('[data-bs-target="#column-customiser-card-body"]');
        if (columnCustomiserCollapseEl && columnCustomiserCollapseToggle) {
            columnCustomiserCollapseEl.addEventListener('hide.bs.collapse', () => { columnCustomiserCollapseToggle.innerHTML = '&#9660;'; });
            columnCustomiserCollapseEl.addEventListener('show.bs.collapse', () => { columnCustomiserCollapseToggle.innerHTML = '&#9650;'; });
        }
    </script>
}
