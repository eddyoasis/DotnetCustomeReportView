@model List<DepartmentConnection>
@{
    ViewData["Title"] = "Manage Department Connections";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Manage Department Connections</h4>
    <a asp-action="Create" class="btn btn-primary btn-sm">+ New Department Connection</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No department connections defined yet. Click <strong>+ New Department Connection</strong> to get started.</div>
}
else
{
    <div class="table-responsive shadow-sm">
        <table class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th style="width:40px;">#</th>
                    <th>Department</th>
                    <th>Connection</th>
                    <th>Created By</th>
                    <th>Created At</th>
                    <th style="width:160px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (DepartmentConnection item in Model)
                {
                    <tr>
                        <td class="text-muted small">@item.Id</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="fw-semibold text-decoration-none">
                                @(item.Department?.Name ?? "-")
                            </a>
                        </td>
                        <td>@(item.ReportConnectionString?.Name ?? "-")</td>
                        <td class="small">@item.CreatedBy</td>
                        <td class="small">@item.CreatedAt.ToString("MM/dd/yyyy HH:mm")</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info">Edit</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;"
                                  onsubmit="return confirm('Are you sure you want to delete this department connection?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
