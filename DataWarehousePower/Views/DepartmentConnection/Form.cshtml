@model DepartmentConnection
@{
    ViewData["Title"] = Model.Id == 0 ? "Create Department Connection" : "Edit Department Connection";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">@ViewData["Title"]</h4>
    <a asp-action="Index" class="btn btn-secondary btn-sm">Back to List</a>
</div>

<div class="row">
    <div class="col-md-10 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Save" method="post" class="needs-validation" novalidate>
                    @if (Model.Id > 0)
                    {
                        <input type="hidden" asp-for="Id" />
                    }

                    <div class="mb-3">
                        <label asp-for="DepartmentId" class="form-label">Department <span class="text-danger">*</span></label>
                        <select asp-for="DepartmentId" asp-items="ViewBag.Departments" class="form-select">
                            <option value="">Select a department</option>
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ReportConnectionStringId" class="form-label">Connection String <span class="text-danger">*</span></label>
                        <select asp-for="ReportConnectionStringId" asp-items="ViewBag.ReportConnectionStrings" class="form-select">
                            <option value="">Select a connection string</option>
                        </select>
                        <span asp-validation-for="ReportConnectionStringId" class="text-danger small"></span>
                    </div>

                    @if (Model.Id > 0)
                    {
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Created By</label>
                                    <p class="form-control-plaintext">@Model.CreatedBy</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Created At</label>
                                    <p class="form-control-plaintext">@Model.CreatedAt.ToString("MM/dd/yyyy HH:mm")</p>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Modified By</label>
                                    <p class="form-control-plaintext">@(string.IsNullOrWhiteSpace(Model.ModifiedBy) ? "N/A" : Model.ModifiedBy)</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Modified At</label>
                                    <p class="form-control-plaintext">@(Model.ModifiedAt?.ToString("MM/dd/yyyy HH:mm") ?? "N/A")</p>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">@(Model.Id == 0 ? "Create" : "Update") Department Connection</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
