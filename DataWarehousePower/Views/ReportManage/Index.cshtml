@model DataWarehousePower.Models.ReportManageListViewModel
@{
    ViewData["Title"] = "Manage Reports";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Manage Reports</h4>
    <a asp-action="Create" class="btn btn-primary btn-sm">+ New Report</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Reports.Any())
{
    <div class="alert alert-info">No reports defined yet. Click <strong>+ New Report</strong> to get started.</div>
}
else
{
    <div class="table-responsive shadow-sm">
        <table class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th style="width:40px;">#</th>
                    <th>Report Name</th>
                    <th>Source Table</th>
                    <th>Source SP</th>
                    <th>Columns</th>
                    <th style="width:140px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Reports)
                {
                    <tr>
                        <td class="text-muted small">@r.Id</td>
                        <td>
                            <a asp-controller="Report" asp-action="Index" asp-route-id="@r.Id"
                               class="fw-semibold text-decoration-none">@r.ReportName</a>
                        </td>
                        <td>@(string.IsNullOrEmpty(r.SourceTable) ? "—" : r.SourceTable)</td>
                        <td>@(string.IsNullOrEmpty(r.SourceSP) ? "—" : r.SourceSP)</td>
                        <td>
                            @foreach (var col in r.Columns.OrderBy(c => c.DisplayOrder))
                            {
                                <span class="badge bg-light text-secondary border me-1">@col.PropertyName</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@r.Id"
                               class="btn btn-outline-primary btn-sm me-1">Edit</a>
                            <form asp-action="Delete" asp-route-id="@r.Id"
                                  method="post" class="d-inline"
                                  onsubmit="return confirm('Delete report \'@r.ReportName\'? This cannot be undone.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
