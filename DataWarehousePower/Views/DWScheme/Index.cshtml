@model List<DWScheme>
@{
    ViewData["Title"] = "Manage DW Schemes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Manage DW Schemes</h4>
    <a asp-action="Create" class="btn btn-primary btn-sm">+ New DW Scheme</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No DW schemes defined yet. Click <strong>+ New DW Scheme</strong> to get started.</div>
}
else
{
    <div class="table-responsive shadow-sm">
        <table class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th style="width:40px;">#</th>
                    <th>SP</th>
                    <th>Display</th>
                    <th>Filter Date Column</th>
                    <th>Inserted By</th>
                    <th>Inserted At</th>
                    <th style="width:160px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (DWScheme item in Model)
                {
                    <tr>
                        <td class="text-muted small">@item.Id</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="fw-semibold text-decoration-none">@item.SP</a>
                        </td>
                        <td>@item.Display</td>
                        <td>@item.FilterDateColumnName</td>
                        <td class="small">@item.InsertedBy</td>
                        <td class="small">@item.InsertedDatetime.ToString("MM/dd/yyyy HH:mm")</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info">Edit</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;"
                                  onsubmit="return confirm('Are you sure you want to delete this DW scheme?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
