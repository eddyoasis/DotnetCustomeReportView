@model DataWarehousePower.Models.ReportFolderViewModel

@{
    ViewData["Title"] = "Report Folder";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-9">
        <h2 class="mb-3">Report Folder</h2>

        @if (TempData["Success"] is string successMessage)
        {
            <div class="alert alert-success" role="alert">@successMessage</div>
        }

        @if (TempData["Error"] is string errorMessage)
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }

        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Index" method="get" class="d-grid gap-3" id="reportFolderFilterForm">
                    <input type="hidden" name="page" value="1" />
                    <input type="hidden" name="sortBy" value="@Model.SortBy" />
                    <input type="hidden" name="sortDirection" value="@Model.SortDirection" />

                    <div>
                        <label for="selectedDate" class="form-label">Date</label>
                        <input id="selectedDate"
                               name="selectedDate"
                               type="date"
                               lang="en-GB"
                               class="form-control"
                               onchange="document.getElementById('reportFolderFilterForm').submit();"
                               value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                    </div>

                    <div>
                        <label class="form-label">User ID</label>
                        <input type="text" class="form-control" value="@Model.UserId" readonly />
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="searchText" class="form-label">Filter by file name</label>
                            <input id="searchText"
                                   name="searchText"
                                   type="text"
                                   class="form-control"
                                   value="@Model.SearchText"
                                   placeholder="Type part of a file name" />
                        </div>
                        <div class="col-md-6">
                            <label for="selectedType" class="form-label">Filter by type</label>
                            <select id="selectedType" name="selectedType" class="form-select">
                                <option value="">All types</option>
                                @foreach (var type in Model.AvailableTypes)
                                {
                                    <option value="@type" selected="@(string.Equals(type, Model.SelectedType, StringComparison.OrdinalIgnoreCase))">@type</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center">
                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-primary">Apply Filters</button>
                            <a asp-action="Index"
                               asp-route-selectedDate="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                               class="btn btn-outline-secondary">
                                Clear Filters
                            </a>
                        </div>
                        <a asp-action="DownloadAll"
                           asp-route-selectedDate="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                           asp-route-searchText="@Model.SearchText"
                           asp-route-selectedType="@Model.SelectedType"
                           asp-route-sortBy="@Model.SortBy"
                           asp-route-sortDirection="@Model.SortDirection"
                           class="btn btn-outline-success @(Model.Files.Any() ? "" : "disabled")"
                           aria-disabled="@(!Model.Files.Any())">
                            Download All Files
                        </a>
                    </div>
                </form>

                <hr />

                @if (!Model.Files.Any())
                {
                    <div class="alert alert-info mb-0" role="alert">No files found for the selected date.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-striped align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">
                                        <a asp-action="Index"
                                           asp-route-selectedDate="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                                           asp-route-searchText="@Model.SearchText"
                                           asp-route-selectedType="@Model.SelectedType"
                                           asp-route-sortBy="name"
                                           asp-route-sortDirection="@(Model.SortBy == "name" && Model.SortDirection == "asc" ? "desc" : "asc")">
                                            File Name
                                        </a>
                                    </th>
                                    <th scope="col">
                                        <a asp-action="Index"
                                           asp-route-selectedDate="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                                           asp-route-searchText="@Model.SearchText"
                                           asp-route-selectedType="@Model.SelectedType"
                                           asp-route-sortBy="type"
                                           asp-route-sortDirection="@(Model.SortBy == "type" && Model.SortDirection == "asc" ? "desc" : "asc")">
                                            Type
                                        </a>
                                    </th>
                                    <th scope="col">
                                        <a asp-action="Index"
                                           asp-route-selectedDate="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                                           asp-route-searchText="@Model.SearchText"
                                           asp-route-selectedType="@Model.SelectedType"
                                           asp-route-sortBy="size"
                                           asp-route-sortDirection="@(Model.SortBy == "size" && Model.SortDirection == "asc" ? "desc" : "asc")">
                                            Size
                                        </a>
                                    </th>
                                    <th scope="col">
                                        <a asp-action="Index"
                                           asp-route-selectedDate="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                                           asp-route-searchText="@Model.SearchText"
                                           asp-route-selectedType="@Model.SelectedType"
                                           asp-route-sortBy="date"
                                           asp-route-sortDirection="@(Model.SortBy == "date" && Model.SortDirection == "asc" ? "desc" : "asc")">
                                            Date Modified
                                        </a>
                                    </th>
                                    <th scope="col" class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var file in Model.Files)
                                {
                                    <tr>
                                        <td>@file.FileName</td>
                                        <td>@file.Type</td>
                                        <td>@FormatFileSize(file.SizeBytes)</td>
                                        <td>@file.DateModified.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                        <td class="text-end">
                                            <a asp-action="Download"
                                               asp-route-selectedDate="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                                               asp-route-fileName="@file.FileName"
                                               class="btn btn-outline-primary btn-sm">
                                                Download
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <span class="text-muted small">
                            Showing page @Model.Page of @Model.TotalPages (@Model.TotalCount files)
                        </span>
                        <div class="btn-group" role="group" aria-label="Pagination">
                            <a asp-action="Index"
                               asp-route-selectedDate="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                               asp-route-searchText="@Model.SearchText"
                               asp-route-selectedType="@Model.SelectedType"
                               asp-route-sortBy="@Model.SortBy"
                               asp-route-sortDirection="@Model.SortDirection"
                               asp-route-page="@(Model.Page - 1)"
                               class="btn btn-outline-secondary btn-sm @(Model.HasPreviousPage ? "" : "disabled")"
                               aria-disabled="@(!Model.HasPreviousPage)">
                                Previous
                            </a>
                            <a asp-action="Index"
                               asp-route-selectedDate="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                               asp-route-searchText="@Model.SearchText"
                               asp-route-selectedType="@Model.SelectedType"
                               asp-route-sortBy="@Model.SortBy"
                               asp-route-sortDirection="@Model.SortDirection"
                               asp-route-page="@(Model.Page + 1)"
                               class="btn btn-outline-secondary btn-sm @(Model.HasNextPage ? "" : "disabled")"
                               aria-disabled="@(!Model.HasNextPage)">
                                Next
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@functions {
    private static string FormatFileSize(long bytes)
    {
        string[] suffixes = ["B", "KB", "MB", "GB", "TB"];
        double size = bytes;
        int index = 0;

        while (size >= 1024 && index < suffixes.Length - 1)
        {
            size /= 1024;
            index++;
        }

        return index == 0 ? $"{bytes} {suffixes[index]}" : $"{size:0.##} {suffixes[index]}";
    }
}