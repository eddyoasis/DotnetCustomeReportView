@model DataWarehousePower.Models.ReportFolderViewModel

@{
    ViewData["Title"] = "Report Folder";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h2 class="mb-3">Report Folder</h2>

        @if (TempData["Success"] is string successMessage)
        {
            <div class="alert alert-success" role="alert">@successMessage</div>
        }

        @if (TempData["Error"] is string errorMessage)
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }

        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Index" method="get" class="d-grid gap-3" id="reportFolderFilterForm">
                    <input type="hidden" name="page" value="1" />

                    <div>
                        <label for="selectedDate" class="form-label">Date</label>
                        <input id="selectedDate"
                               name="selectedDate"
                               type="date"
                               class="form-control"
                               onchange="document.getElementById('reportFolderFilterForm').submit();"
                               value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                    </div>

                    <div>
                        <label class="form-label">User ID</label>
                        <input type="text" class="form-control" value="@Model.UserId" readonly />
                    </div>
                </form>

                <hr />

                @if (!Model.Files.Any())
                {
                    <div class="alert alert-info mb-0" role="alert">No files found for the selected date.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-striped align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">File Name</th>
                                    <th scope="col">Date Modified</th>
                                    <th scope="col" class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var file in Model.Files)
                                {
                                    <tr>
                                        <td>@file.FileName</td>
                                        <td>@file.DateModified.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        <td class="text-end">
                                            <a asp-action="Download"
                                               asp-route-selectedDate="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                                               asp-route-fileName="@file.FileName"
                                               class="btn btn-outline-primary btn-sm">
                                                Download
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <span class="text-muted small">
                            Showing page @Model.Page of @Model.TotalPages (@Model.TotalCount files)
                        </span>
                        <div class="btn-group" role="group" aria-label="Pagination">
                            <a asp-action="Index"
                               asp-route-selectedDate="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                               asp-route-page="@(Model.Page - 1)"
                               class="btn btn-outline-secondary btn-sm @(Model.HasPreviousPage ? "" : "disabled")"
                               aria-disabled="@(!Model.HasPreviousPage)">
                                Previous
                            </a>
                            <a asp-action="Index"
                               asp-route-selectedDate="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                               asp-route-page="@(Model.Page + 1)"
                               class="btn btn-outline-secondary btn-sm @(Model.HasNextPage ? "" : "disabled")"
                               aria-disabled="@(!Model.HasNextPage)">
                                Next
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>