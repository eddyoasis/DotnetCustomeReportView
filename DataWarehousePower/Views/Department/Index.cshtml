@model List<Department>
@{
    ViewData["Title"] = "Manage Departments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Manage Departments</h4>
    <a asp-action="Create" class="btn btn-primary btn-sm">+ New Department</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No departments defined yet. Click <strong>+ New Department</strong> to get started.</div>
}
else
{
    <div class="table-responsive shadow-sm">
        <table class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th style="width:40px;">#</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Created By</th>
                    <th>Created At</th>
                    <th style="width:90px;" class="text-center">Active</th>
                    <th style="width:160px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var dept in Model)
                {
                    <tr class="@(dept.IsActive ? "" : "table-secondary text-muted")">
                        <td class="text-muted small">@dept.Id</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@dept.Id"
                               class="fw-semibold text-decoration-none">@dept.Name</a>
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(dept.Description) ? "-" : dept.Description)</td>
                        <td class="small">@dept.CreatedBy</td>
                        <td class="small">@dept.CreatedAt.ToString("MM/dd/yyyy HH:mm")</td>
                        <td class="text-center">
                            <form asp-action="ToggleActive" asp-route-id="@dept.Id" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(dept.IsActive ? "btn-success" : "btn-secondary")">
                                    @(dept.IsActive ? "Active" : "Inactive")
                                </button>
                            </form>
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@dept.Id" class="btn btn-sm btn-info">Edit</a>
                            <form asp-action="Delete" asp-route-id="@dept.Id" method="post" style="display:inline;" 
                                  onsubmit="return confirm('Are you sure you want to delete this department?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
