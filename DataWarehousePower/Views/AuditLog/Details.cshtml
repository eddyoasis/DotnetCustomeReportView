@model AuditLogDetailViewModel
@{
    ViewData["Title"] = "Audit Log Details";

    string FormatValue(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "—";
        }

        return value;
    }
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h4 class="mb-1">Audit Log Details</h4>
        <div class="text-muted">Record #@Model.Id</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-controller="AuditLog" asp-action="Index">Back to list</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-8">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-dark text-white">
                <strong>Change Summary</strong>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="p-3 rounded border bg-light h-100">
                            <div class="text-muted small text-uppercase">Username</div>
                            <div class="fw-semibold fs-5">@Model.Username</div>
                            <div class="text-muted small">@Model.UserId</div>
                            <div class="mt-3 text-muted small text-uppercase">Timestamp (UTC)</div>
                            <div class="fw-semibold">@Model.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss")</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded border bg-light h-100">
                            <div class="text-muted small text-uppercase">Action</div>
                            <div class="fw-semibold fs-5">@Model.ActionType</div>
                            <div class="mt-2 text-muted small text-uppercase">Description</div>
                            <div class="fw-semibold">@Model.Description</div>
                            <div class="mt-3 text-muted small text-uppercase">Entity</div>
                            <div class="fw-semibold">@Model.EntityName</div>
                            <div class="text-muted">@FormatValue(Model.EntityId)</div>
                        </div>
                    </div>
                </div>

                <div class="mt-3 p-3 rounded border">
                    <div class="text-muted small text-uppercase mb-2">What changed</div>
                    @if (Model.IsUpdateAction && Model.HasComparisonData)
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 20%;">Field</th>
                                        <th style="width: 35%;">Old Value</th>
                                        <th style="width: 35%;">New Value</th>
                                        <th style="width: 10%;">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (AuditLogFieldComparisonViewModel row in Model.Comparisons)
                                    {
                                        <tr class="@(row.IsChanged ? "table-warning" : "")">
                                            <td class="fw-semibold">@row.FieldName</td>
                                            <td><pre class="mb-0 small text-wrap">@FormatValue(row.OldValue)</pre></td>
                                            <td><pre class="mb-0 small text-wrap">@FormatValue(row.NewValue)</pre></td>
                                            <td>
                                                @if (row.IsChanged)
                                                {
                                                    <span class="badge bg-danger">Changed</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">Same</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else if (Model.ActionType.Contains("Delete", StringComparison.OrdinalIgnoreCase) && Model.OldValues.Any())
                    {
                        <div class="alert alert-warning mb-0">This record was deleted. The old values below show the removed data.</div>
                    }
                    else if (Model.ActionType.Contains("Create", StringComparison.OrdinalIgnoreCase) && Model.NewValues.Any())
                    {
                        <div class="alert alert-success mb-0">This record was created. The new values below show the inserted data.</div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">No field comparison data is available for this audit entry.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-dark text-white">
                <strong>Audit Metadata</strong>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="text-muted small text-uppercase">Correlation Id</div>
                    <div class="fw-semibold text-break">@FormatValue(Model.CorrelationId)</div>
                </div>
                <div class="mb-3">
                    <div class="text-muted small text-uppercase">Description</div>
                    <div class="fw-semibold text-break">@FormatValue(Model.Description)</div>
                </div>
                <div class="mb-3">
                    <div class="text-muted small text-uppercase">Changed Columns</div>
                    @if (Model.ChangedColumnsList.Any())
                    {
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (string column in Model.ChangedColumnsList)
                            {
                                <span class="badge bg-primary">@column</span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">—</div>
                    }
                </div>
                <div class="mb-3">
                    <div class="text-muted small text-uppercase">Raw Old Values</div>
                    <pre class="small bg-light border rounded p-2 mb-0 text-wrap">@FormatValue(Model.OldValuesJson)</pre>
                </div>
                <div>
                    <div class="text-muted small text-uppercase">Raw New Values</div>
                    <pre class="small bg-light border rounded p-2 mb-0 text-wrap">@FormatValue(Model.NewValuesJson)</pre>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-dark text-white">
        <strong>Metadata</strong>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(Model.Metadata))
        {
            <pre class="mb-0 bg-light border rounded p-3 text-wrap">@Model.Metadata</pre>
        }
        else
        {
            <div class="text-muted">No metadata was captured for this audit entry.</div>
        }
    </div>
</div>
