@model List<ReportConnectionString>
@{
    ViewData["Title"] = "Manage Connection Strings";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Manage Connection Strings</h4>
    <a asp-action="Create" class="btn btn-primary btn-sm">+ New Connection String</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No connection strings defined yet. Click <strong>+ New Connection String</strong> to get started.</div>
}
else
{
    <div class="table-responsive shadow-sm">
        <table class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th style="width:40px;">#</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Connection String</th>
                    <th>Created By</th>
                    <th>Created At</th>
                    <th style="width:160px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (ReportConnectionString item in Model)
                {
                    string maskedConnectionString = item.ConnectionString.Length <= 8
                        ? item.ConnectionString
                        : $"{item.ConnectionString[..4]}{new string('*', item.ConnectionString.Length - 8)}{item.ConnectionString[^4..]}";

                    <tr>
                        <td class="text-muted small">@item.Id</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="fw-semibold text-decoration-none">@item.Name</a>
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(item.Description) ? "-" : item.Description)</td>
                        <td class="small"><code>@maskedConnectionString</code></td>
                        <td class="small">@item.CreatedBy</td>
                        <td class="small">@item.CreatedAt.ToString("MM/dd/yyyy HH:mm")</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info">Edit</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;"
                                  onsubmit="return confirm('Are you sure you want to delete this connection string?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
