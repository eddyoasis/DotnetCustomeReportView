@using DataWarehousePower.Authorization
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DataWarehousePower</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DataWarehousePower.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        string? displayName = Context.Session.GetString("UserDisplayName");
        string? department = Context.Session.GetString("UserDepartment");
        string? role = Context.Session.GetString("UserRole");

        string userLabel = string.IsNullOrWhiteSpace(displayName)
            ? (User?.Identity?.Name ?? "Unknown")
            : displayName;

        string departmentLabel = string.IsNullOrWhiteSpace(department) ? "N/A" : department;
        string roleLabel = string.IsNullOrWhiteSpace(role) ? "N/A" : role;

        bool canViewReports = false;
        bool canManageReports = false;
        bool canViewAudilog = false;

        if (User?.Identity?.IsAuthenticated == true)
        {
            canViewReports = (await AuthorizationService.AuthorizeAsync(User, DepartmentAuthorizationPolicies.ReportAccess)).Succeeded;
            canManageReports = (await AuthorizationService.AuthorizeAsync(User, DepartmentAuthorizationPolicies.ReportManageAccess)).Succeeded;
            canViewAudilog = (await AuthorizationService.AuthorizeAsync(User, DepartmentAuthorizationPolicies.AuditlogAccess)).Succeeded;
        }
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">DataWarehousePower</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if (canViewReports)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Report" asp-action="List">Reports</a>
                            </li>
                        }
                        @if (canManageReports)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="ReportManage" asp-action="Index">Manage Reports</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="ScheduledJob" asp-action="Index">Scheduled Jobs</a>
                            </li>
                        }
                        @if (canViewAudilog)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="AuditLog" asp-action="Index">Audit Logs</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="~/hangfire" target="_blank" rel="noopener noreferrer">Scheduler Dashboard</a>
                            </li>
                        }
                    </ul>
                    <div class="navbar-text ms-auto text-end text-dark">
                        <div>User: @userLabel</div>
                        <small>Department: @departmentLabel | Role: @roleLabel</small>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - DataWarehousePower - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
