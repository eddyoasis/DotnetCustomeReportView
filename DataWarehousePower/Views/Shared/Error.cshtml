@model ErrorViewModel
@{
    ViewData["Title"] = "Something Went Wrong";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9">
            <div class="card border-danger shadow-sm">
                <div class="card-body p-4 p-md-5">
                    <h1 class="h3 text-danger mb-3">Something went wrong</h1>
                    <p class="mb-4">@Model.FriendlyMessage</p>

                    @if (!string.IsNullOrWhiteSpace(Model.RequestPath))
                    {
                        <p class="mb-2"><strong>Page:</strong> @Model.RequestPath</p>
                    }

                    @if (Model.ShowRequestId)
                    {
                        <p class="mb-4">
                            <strong>Request ID:</strong>
                            <span class="font-monospace">@Model.RequestId</span>
                        </p>
                    }

                    <div class="d-flex gap-2 flex-wrap">
                        <a class="btn btn-primary" asp-controller="Dashboard" asp-action="Index">Go to Dashboard</a>
                        <button type="button" class="btn btn-outline-secondary" onclick="window.history.back();">Go Back</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
