            const schemaTemplateGroup = document.getElementById('schemaTemplateGroup');
            const clientCodeGroup = document.getElementById('clientCodeGroup');
            const columnsFilterGroup = document.getElementById('columnsFilterGroup');
            const filterColumnDataJsonHiddenInput = document.getElementById('FilterColumnDataJson');
            const clientCodeFieldInput = document.getElementById('ClientCode');
            const isCustomToggle = document.getElementById('isCustomToggle');
            const isUseRecurringDataDateColumnToggle = document.getElementById('isUseRecurringDataDateColumnToggle');
            const recurringDataDateColumn = document.getElementById('RecurringDataDateColumn');
            const autoDateIntervalUnitWholeGroup = document.getElementById('autoDateIntervalUnitWholeGroup');
            const dateFromGroup = document.getElementById('dateFromGroup');
            const dateToGroup = document.getElementById('dateToGroup');
            const dateFromInput = document.getElementById('DateFrom');
            const dateToInput = document.getElementById('DateTo');
            const autoDateIntervalUnitGroup = document.getElementById('autoDateIntervalUnitGroup');
            const autoDateIntervalValueGroup = document.getElementById('autoDateIntervalValueGroup');
            const autoDateIntervalHintGroup = document.getElementById('autoDateIntervalHintGroup');
            const autoDateIntervalUnitSelect = document.getElementById('autoDateIntervalUnitSelect');
            const autoDateIntervalValueInput = document.getElementById('autoDateIntervalValueInput');
            const exportLocationHiddenInput = document.getElementById('ExportLocation');
            const exportLocationSubfolderHiddenInput = document.getElementById('ExportLocationSubfolder');
            const exportLocationBasePathSelect = document.getElementById('exportLocationBasePathSelect');
            const exportLocationSubfolderInput = document.getElementById('exportLocationSubfolderInput');
            const exportToLocalFolderToggle = document.getElementById('exportToLocalFolderToggle');
            const noAnyExportLocationfolderError = document.getElementById('noAnyExportLocationfolderError');
            const exportToLocalFolderHint = document.getElementById('exportToLocalFolderHint');
            const openExportLocationButton = document.getElementById('openExportLocationButton');
            const openExportLocationUrl = '@Url.Action("OpenExportLocation", "ScheduledJob")';
            const scheduledFilterValuesUrl = '@Url.Action("FilterValues", "ScheduledJob")';
            const previewUrl = '@Url.Action("Preview", "ScheduledJob")';
            const previewButton = document.getElementById('btn-preview');
            const previewTakeSelect = document.getElementById('preview-take');
            const previewStatus = document.getElementById('preview-status');
            const previewTableWrap = document.getElementById('preview-table-wrap');
            const previewTableHead = document.getElementById('preview-table-head');
            const previewTableBody = document.getElementById('preview-table-body');
            const clientCodeSelect = document.getElementById('scheduled-client-code-select');
            const clientCodeSearchInput = document.getElementById('scheduled-client-code-search');
            const clientCodeDropdownToggle = document.getElementById('scheduled-client-code-dropdown-toggle');
            const clientCodeOptions = document.getElementById('scheduled-client-code-options');
            const clientCodeClearButton = document.getElementById('scheduled-client-code-clear');
            const availableReports = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AvailableReports));
            const availableDataFiles = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AvailableDataFiles));
            const availableSchemaTemplatesByReportId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AvailableSchemaTemplatesByReportId));
            const parametersHiddenInput = document.getElementById('scheduled-job-parameters');
            const scheduledParametersContainer = document.getElementById('scheduled-parameters-container');
            const scheduledParametersEmpty = document.getElementById('scheduled-parameters-empty');
            const availableParametersByReportId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AvailableParametersByReportId));
            let suppressExportLocationSubfolderConfirm = false;
            let lastConfirmedExportLocationSubfolder = (exportLocationSubfolderInput?.value || '').trim();

            if (!scheduleTypeSelect || !everyMinutesGroup || !dailyTimeGroup || !customDaysGroup || !cronGroup) {
                return;
            }

            function requiresSchemaAndClientCode() {             
                return true;

                // if (!requiresSchemaAndClientCodeInput) {
                //     return true;
                // }

                // return (requiresSchemaAndClientCodeInput.value || '').toLowerCase() === 'true';
            }

            function getSourceMode() {
                return sourceModeSelect?.value === 'datafile' ? 'datafile' : 'report';
            }

            function setSourceMode(mode) {
                const isReportMode = mode !== 'datafile';

                if (isReport) {
                    isReport.value = isReportMode ? 'true' : 'false';
                }

                if (requiresSchemaAndClientCodeInput) {
                    requiresSchemaAndClientCodeInput.value = isReportMode ? 'true' : 'false';
                }

                if (reportDefinitionLabel) {
                    reportDefinitionLabel.textContent = isReportMode ? 'Report' : 'Data File';
                }

                const isUseRecurringDataDateColumn = isUseRecurringDataDateColumnToggle.checked;

                console.log('setSourceMode');
                console.log('isReportMode:' + isReportMode);
                console.log('isUseRecurringDataDateColumn:' + isUseRecurringDataDateColumn);
                console.log('(isReportMode || (!isReportMode && isUseRecurringDataDateColumn):' + isReportMode || (!isReportMode && isUseRecurringDataDateColumn));

                //clientCodeGroup.style.display = isReportMode ? '' : 'none';
                //isUseRecurringDataDateColumnGroup.style.display = !isReportMode ? '' : 'none';

                clientCodeGroup.classList.toggle('d-none', !isReportMode);
                isUseRecurringDataDateColumnGroup.classList.toggle('d-none', isReportMode);
                recurringDataDateColumnGroup.classList.toggle('d-none', !(!isReportMode && isUseRecurringDataDateColumn));
                isCustomGroup.classList.toggle('d-none', !isReportMode);
                autoDateIntervalUnitGroup.classList.toggle('d-none', !(isReportMode || (!isReportMode && isUseRecurringDataDateColumn)));
                autoDateIntervalValueGroup.classList.toggle('d-none', !(isReportMode || (!isReportMode && isUseRecurringDataDateColumn)));
                autoDateIntervalHintGroup.classList.toggle('d-none', !(isReportMode || (!isReportMode && isUseRecurringDataDateColumn)));
                
                // autoDateIntervalUnitGroup.classList.toggle('d-none', !isReportMode || (!isUseRecurringDataDateColumn));
                // autoDateIntervalValueGroup.classList.toggle('d-none', !isReportMode && !isUseRecurringDataDateColumn);
                // autoDateIntervalHintGroup.classList.toggle('d-none', !isReportMode && !isUseRecurringDataDateColumn);


                //(Model.IsReport || (!Model.IsReport && Model.IsUseRecurringDataDateColumn)

                //autoDateIntervalUnitGroup.hidden = !isReportMode
                //autoDateIntervalValueGroup.hidden = !isReportMode
                //autoDateIntervalHintGroup.hidden = !isReportMode
            }

            function renderSourceOptions(clearSelection) {
                if (!reportDefinitionSelect) {
                    return;
                }

                const mode = getSourceMode();
                const isReportMode = mode === 'report';
                const options = isReportMode ? availableReports : availableDataFiles;
                const selectedValue = clearSelection ? '' : reportDefinitionSelect.value;
                const placeholder = isReportMode ? '-- Select report --' : '-- Select data file --';

                reportDefinitionSelect.innerHTML = '';

                const defaultOption = document.createElement('option');
                defaultOption.value = '';
                defaultOption.textContent = placeholder;
                reportDefinitionSelect.appendChild(defaultOption);

                options.forEach(option => {
                    const item = document.createElement('option');
                    item.value = String(option.id ?? option.Id ?? '');
                    item.textContent = String(option.reportName ?? option.ReportName ?? '');
                    const hasFilterClientCode = option.hasFilterClientCodeColumn ?? option.HasFilterClientCodeColumn;
                    item.dataset.hasFilterClientCode = hasFilterClientCode ? 'true' : 'false';
                    reportDefinitionSelect.appendChild(item);
                });

                if (!clearSelection && selectedValue) {
                    reportDefinitionSelect.value = selectedValue;
                }
            }

            function updateSchemaAndClientCodeFields() {
                const isRequired = requiresSchemaAndClientCode();

                if (schemaTemplateGroup) {
                    schemaTemplateGroup.style.display = isRequired ? '' : 'none';
                }

                if (clientCodeGroup) {

                    const isReportMode = getSourceMode() === 'report';

                    const selectedOption = reportDefinitionSelect.options[reportDefinitionSelect.selectedIndex];

                    const hasFilterClientCodeColumn =
                        (selectedOption?.dataset?.hasFilterClientCode || '').toLowerCase() === 'true';

                    if (isReportMode) {
                        clientCodeGroup.style.display = isRequired ? '' : 'none';
                    } else {
                        clientCodeGroup.style.display = (isRequired && hasFilterClientCodeColumn) ? '' : 'none';
                    }
                }

                if (clientCodeFieldInput) {
                    clientCodeFieldInput.required = (isReport?.value || '').toLowerCase() === 'true' && isRequired;
                    clientCodeFieldInput.disabled = !isRequired;

                    console.log(clientCodeFieldInput);

                    if (!isRequired) {
                        clientCodeFieldInput.value = '';
                    }
                }

                // if (clientCodeFieldInput) {
                //     clientCodeFieldInput.required = isRequired;
                //     clientCodeFieldInput.disabled = !isRequired;
                //     if (!isRequired) {
                //         clientCodeFieldInput.value = '';
                //     }
                // }

                // Preserve SchemaTemplate value for round-trip scenarios even when source mode is datafile.
            }

            function renderColumnsFilterGroup() {
                if (!columnsFilterGroup) {
                    return;
                }

                const existingFilterValuesByKey = new Map(
                    [...columnsFilterGroup.querySelectorAll('.column-filter-input[data-filter-key]')]
                        .map(input => [
                            normalizeColumnFilterKey(input.getAttribute('data-filter-key')),
                            (input.value || '').trim()
                        ])
                        .filter(([key]) => key)
                );

                const persistedFilterValuesByKey = parsePersistedColumnFilterValues();

                columnsFilterGroup.innerHTML = '';

                const isReportMode = getSourceMode() === 'report';
                const hasSelectedSource = !!(reportDefinitionSelect?.value || '').trim();

                if (isReportMode || !hasSelectedSource) {
                    columnsFilterGroup.style.display = 'none';
                    return;
                }

                columnsFilterGroup.style.display = '';

                const title = document.createElement('label');
                title.className = 'form-label';
                title.textContent = 'Column Filters';
                columnsFilterGroup.appendChild(title);

                const columnsContainer = document.createElement('div');
                columnsContainer.className = 'row g-2';

                const selectedSourceId = parseInt((reportDefinitionSelect?.value || '').trim(), 10);
                const sourceOptions = getSourceMode() === 'report' ? (availableReports || []) : (availableDataFiles || []);
                const selectedSource = Number.isFinite(selectedSourceId)
                    ? sourceOptions.find(option => parseInt(option?.id ?? option?.Id ?? '', 10) === selectedSourceId)
                    : null;
                const selectedColumns = selectedSource?.columns || selectedSource?.Columns || [];

                function supportsRangeFilterByType(propertyType) {
                    const normalizedPropertyType = String(propertyType || '').trim().toLowerCase();
                    return normalizedPropertyType.includes('date')
                        || normalizedPropertyType.includes('time')
                        || normalizedPropertyType.includes('decimal')
                        || normalizedPropertyType.includes('numeric')
                        || normalizedPropertyType.includes('real')
                        || normalizedPropertyType.includes('float')
                        || normalizedPropertyType.includes('money')
                        || normalizedPropertyType.includes('smallmoney')
                        || normalizedPropertyType.includes('int')
                        || normalizedPropertyType.includes('number');
                }

                const seenColumns = new Set();
                const distinctColumns = [];

                selectedColumns.forEach(column => {
                    const propertyName = String(column?.propertyName || column?.PropertyName || column?.key || column?.Key || '').trim();
                    if (!propertyName) {
                        return;
                    }

                    const dedupeKey = propertyName.toLowerCase();
                    if (seenColumns.has(dedupeKey)) {
                        return;
                    }

                    seenColumns.add(dedupeKey);
                    distinctColumns.push({
                        key: String(column?.key || column?.Key || '').trim(),
                        propertyName,
                        displayLabel: String(column?.displayLabel || column?.DisplayLabel || column?.defaultLabel || column?.DefaultLabel || propertyName).trim() || propertyName,
                        mappingParameter: String(column?.mappingParameter || column?.MappingParameter || '').trim(),
                        propertyType: String(column?.propertyType || column?.PropertyType || '').trim()
                    });
                });

                distinctColumns
                    .sort((left, right) => left.displayLabel.localeCompare(right.displayLabel, undefined, { sensitivity: 'accent' }))
                    .forEach((column, index) => {
                        const filterKey = column.mappingParameter || column.propertyName;
                        const initialFilterValue = resolvePersistedFilterValue(column, filterKey, existingFilterValuesByKey, persistedFilterValuesByKey);
                        const filterInputId = `scheduled-column-filter-${index + 1}-${column.propertyName}`;
                        const useRangeFilter = supportsRangeFilterByType(column.propertyType);
                        const rangeInputType = column.propertyType.toLowerCase().includes('date') || column.propertyType.toLowerCase().includes('time')
                            ? 'date'
                            : 'number';

                        const columnWrap = document.createElement('div');
                        columnWrap.className = 'col-12 col-md-6 col-xl-4';

                        const card = document.createElement('div');
                        card.className = 'border rounded-3 bg-light-subtle p-2 h-100';

                        const columnLabel = document.createElement('label');
                        columnLabel.className = 'form-label small fw-semibold mb-1';
                        columnLabel.setAttribute('for', filterInputId);
                        columnLabel.textContent = column.displayLabel;

                        card.appendChild(columnLabel);

                        if (useRangeFilter) {
                            const rangeContainer = document.createElement('div');
                            rangeContainer.className = 'column-filter-range d-flex flex-column gap-1';
                            rangeContainer.dataset.rangeType = rangeInputType;

                            const hiddenInput = document.createElement('input');
                            hiddenInput.id = filterInputId;
                            hiddenInput.name = `columnFilters[${filterKey}]`;
                            hiddenInput.type = 'hidden';
                            hiddenInput.className = 'column-filter-input';
                            hiddenInput.value = initialFilterValue;
                            hiddenInput.dataset.filterKey = filterKey;
                            hiddenInput.dataset.columnKey = column.propertyName;
                            hiddenInput.dataset.columnType = (column.propertyType || '').trim().toLowerCase();

                            const fromInput = document.createElement('input');
                            fromInput.type = rangeInputType;
                            fromInput.className = 'form-control form-control-sm column-filter-range-from';
                            fromInput.placeholder = 'From';

                            const toInput = document.createElement('input');
                            toInput.type = rangeInputType;
                            toInput.className = 'form-control form-control-sm column-filter-range-to';
                            toInput.placeholder = 'To';

                            const [fromPersistedValue, toPersistedValue] = initialFilterValue.includes('|')
                                ? initialFilterValue.split('|', 2)
                                : [initialFilterValue, ''];
                            fromInput.value = (fromPersistedValue || '').trim();
                            toInput.value = (toPersistedValue || '').trim();

                            const syncHidden = () => {
                                const fromValue = (fromInput.value || '').trim();
                                const toValue = (toInput.value || '').trim();
                                hiddenInput.value = fromValue || toValue
                                    ? `${fromValue}|${toValue}`
                                    : '';
                            };

                            fromInput.addEventListener('input', syncHidden);
                            toInput.addEventListener('input', syncHidden);
                            syncHidden();

                            rangeContainer.appendChild(hiddenInput);
                            rangeContainer.appendChild(fromInput);
                            rangeContainer.appendChild(toInput);
                            card.appendChild(rangeContainer);
                        } else {
                            const suggestContainer = document.createElement('div');
                            suggestContainer.className = 'column-filter-suggest position-relative';

                            const hiddenInput = document.createElement('input');
                            hiddenInput.id = filterInputId;
                            hiddenInput.name = `columnFilters[${filterKey}]`;
                            hiddenInput.type = 'hidden';
                            hiddenInput.className = 'column-filter-input column-filter-suggest-hidden';
                            hiddenInput.value = initialFilterValue;
                            hiddenInput.dataset.filterKey = filterKey;
                            hiddenInput.dataset.columnKey = column.propertyName;
                            hiddenInput.dataset.columnType = (column.propertyType || '').trim().toLowerCase();
                            hiddenInput.dataset.dataFileId = String(selectedSourceId || '');
                            hiddenInput.dataset.filterValuesUrl = scheduledFilterValuesUrl;

                            const box = document.createElement('div');
                            box.className = 'column-filter-suggest-box form-control form-control-sm';

                            const summary = document.createElement('div');
                            summary.className = 'column-filter-suggest-summary small text-muted d-none';

                            const selectedValues = document.createElement('div');
                            selectedValues.className = 'column-filter-suggest-selected d-flex flex-wrap gap-1';

                            const textInput = document.createElement('input');
                            textInput.id = `${filterInputId}-search`;
                            textInput.type = 'text';
                            textInput.className = 'column-filter-suggest-input border-0 p-0';
                            textInput.autocomplete = 'off';
                            textInput.dataset.columnKey = column.propertyName;
                            textInput.dataset.dataFileId = String(selectedSourceId || '');
                            textInput.dataset.filterValuesUrl = scheduledFilterValuesUrl;
                            textInput.placeholder = 'Select or enter value';

                            const list = document.createElement('div');
                            list.className = 'list-group column-filter-suggest-list position-absolute w-100 d-none';

                            box.appendChild(summary);
                            box.appendChild(selectedValues);
                            box.appendChild(textInput);
                            suggestContainer.appendChild(hiddenInput);
                            suggestContainer.appendChild(box);
                            suggestContainer.appendChild(list);
                            card.appendChild(suggestContainer);
                        }

                        columnWrap.appendChild(card);
                        columnsContainer.appendChild(columnWrap);
                    });

                if (!columnsContainer.children.length) {
                    const emptyText = document.createElement('div');
                    emptyText.className = 'text-muted small';
                    emptyText.textContent = 'No data file columns available.';
                    columnsFilterGroup.appendChild(emptyText);
                    return;
                }

                columnsFilterGroup.appendChild(columnsContainer);
                initializeColumnFilterSuggestions();
            }

            function initializeColumnFilterSuggestions() {
                const suggestInputs = [...columnsFilterGroup.querySelectorAll('.column-filter-suggest-input')]
                    .filter(input => input instanceof HTMLInputElement);

                if (!suggestInputs.length) {
                    return;
                }

                const states = new WeakMap();
                const debounceMs = 700;

                const getState = input => {
                    let state = states.get(input);
                    if (!state) {
                        state = { timer: null, requestId: 0, cache: new Map(), selectedValues: [] };
                        states.set(input, state);
                    }

                    return state;
                };

                const getContainer = input => input.closest('.column-filter-suggest');
                const getList = input => getContainer(input)?.querySelector('.column-filter-suggest-list') ?? null;
                const getHiddenInput = input => getContainer(input)?.querySelector('.column-filter-suggest-hidden') ?? null;
                const getSelectedContainer = input => getContainer(input)?.querySelector('.column-filter-suggest-selected') ?? null;
                const getSummary = input => getContainer(input)?.querySelector('.column-filter-suggest-summary') ?? null;
                const getBox = input => getContainer(input)?.querySelector('.column-filter-suggest-box') ?? null;

                const hideList = input => {
                    const list = getList(input);
                    if (!list) {
                        return;
                    }

                    list.classList.add('d-none');
                    list.innerHTML = '';
                };

                const parseSelectedValues = raw => {
                    const normalized = String(raw || '').trim();
                    if (!normalized) {
                        return [];
                    }

                    try {
                        const parsed = JSON.parse(normalized);
                        if (Array.isArray(parsed)) {
                            return parsed
                                .map(value => String(value || '').trim())
                                .filter(Boolean)
                                .filter((value, index, values) =>
                                    values.findIndex(item => item.localeCompare(value, undefined, { sensitivity: 'accent' }) === 0) === index);
                        }
                    } catch {
                        // Fallback for legacy single-string filters.
                    }

                    return [normalized];
                };

                const syncHiddenValue = input => {
                    const state = getState(input);
                    const hiddenInput = getHiddenInput(input);
                    if (!(hiddenInput instanceof HTMLInputElement)) {
                        return;
                    }

                    hiddenInput.value = state.selectedValues.length ? JSON.stringify(state.selectedValues) : '';
                };

                const renderSelectedValues = input => {
                    const state = getState(input);
                    const selectedContainer = getSelectedContainer(input);
                    const summary = getSummary(input);
                    if (!(selectedContainer instanceof HTMLElement) || !(summary instanceof HTMLElement)) {
                        return;
                    }

                    selectedContainer.innerHTML = '';
                    selectedContainer.classList.toggle('is-empty', state.selectedValues.length === 0);

                    if (!state.selectedValues.length) {
                        summary.textContent = '';
                        summary.classList.add('d-none');
                        input.placeholder = 'Select or enter value';
                        return;
                    }

                    summary.textContent = `${state.selectedValues.length} selected`;
                    summary.classList.remove('d-none');
                    input.placeholder = 'Add another value';

                    state.selectedValues.forEach(value => {
                        const chip = document.createElement('span');
                        chip.className = 'column-filter-suggest-chip';

                        const label = document.createElement('span');
                        label.className = 'column-filter-suggest-chip-label';
                        label.textContent = value;

                        const removeButton = document.createElement('button');
                        removeButton.type = 'button';
                        removeButton.className = 'column-filter-suggest-chip-remove';
                        removeButton.setAttribute('aria-label', `Remove ${value}`);
                        removeButton.textContent = 'x';
                        removeButton.addEventListener('click', () => {
                            state.selectedValues = state.selectedValues.filter(item =>
                                item.localeCompare(value, undefined, { sensitivity: 'accent' }) !== 0);
                            syncHiddenValue(input);
                            renderSelectedValues(input);
                            requestOptions(input);
                            serializeFilterColumnDataJson();
                            input.focus();
                        });

                        chip.appendChild(label);
                        chip.appendChild(removeButton);
                        selectedContainer.appendChild(chip);
                    });
                };

                const addSelectedValue = (input, value) => {
                    const normalized = String(value || '').trim();
                    if (!normalized) {
                        return;
                    }

                    const state = getState(input);
                    const exists = state.selectedValues.some(item =>
                        item.localeCompare(normalized, undefined, { sensitivity: 'accent' }) === 0);
                    if (!exists) {
                        state.selectedValues.push(normalized);
                    }

                    input.value = '';
                    syncHiddenValue(input);
                    renderSelectedValues(input);
                    requestOptions(input);
                    serializeFilterColumnDataJson();
                };

                const showLoading = input => {
                    const list = getList(input);
                    if (!(list instanceof HTMLElement)) {
                        return;
                    }

                    list.innerHTML = '';
                    const item = document.createElement('div');
                    item.className = 'list-group-item py-1 px-2 text-muted small';
                    item.textContent = 'Loading values...';
                    list.appendChild(item);
                    list.classList.remove('d-none');
                };

                const renderOptionList = (input, options) => {
                    const list = getList(input);
                    if (!(list instanceof HTMLElement)) {
                        return;
                    }

                    list.innerHTML = '';
                    if (!options.length) {
                        hideList(input);
                        return;
                    }

                    options.forEach(option => {
                        const item = document.createElement('button');
                        item.type = 'button';
                        item.className = 'list-group-item list-group-item-action py-1 px-2';
                        item.textContent = option;
                        item.addEventListener('mousedown', event => event.preventDefault());
                        item.addEventListener('click', () => {
                            addSelectedValue(input, option);
                            input.focus();
                        });
                        list.appendChild(item);
                    });

                    list.classList.remove('d-none');
                };

                const requestOptions = async input => {
                    const state = getState(input);
                    const hiddenInput = getHiddenInput(input);
                    if (!(hiddenInput instanceof HTMLInputElement)) {
                        return;
                    }

                    const endpoint = (input.dataset.filterValuesUrl || hiddenInput.dataset.filterValuesUrl || '').trim();
                    const dataFileId = (input.dataset.dataFileId || hiddenInput.dataset.dataFileId || '').trim();
                    const columnKey = (input.dataset.columnKey || hiddenInput.dataset.columnKey || '').trim();
                    const search = (input.value || '').trim();

                    if (!endpoint || !dataFileId || !columnKey) {
                        hideList(input);
                        return;
                    }

                    const cacheKey = `${dataFileId}|${columnKey}|${search.toLowerCase()}`;
                    if (state.cache.has(cacheKey)) {
                        const options = state.cache.get(cacheKey)
                            .filter(option => !state.selectedValues.some(item => item.localeCompare(option, undefined, { sensitivity: 'accent' }) === 0));
                        renderOptionList(input, options);
                        return;
                    }

                    state.requestId += 1;
                    const currentRequestId = state.requestId;
                    showLoading(input);

                    const url = new URL(endpoint, window.location.origin);
                    url.searchParams.set('dataFileId', dataFileId);
                    url.searchParams.set('columnKey', columnKey);
                    url.searchParams.set('take', '50');
                    if (search) {
                        url.searchParams.set('search', search);
                    }

                    try {
                        const response = await fetch(url.toString(), { cache: 'no-store' });
                        const payload = await response.json().catch(() => []);
                        if (currentRequestId !== state.requestId) {
                            return;
                        }

                        const options = Array.isArray(payload)
                            ? payload
                                .map(value => String(value || '').trim())
                                .filter(Boolean)
                                .filter((value, index, values) =>
                                    values.findIndex(item => item.localeCompare(value, undefined, { sensitivity: 'accent' }) === 0) === index)
                            : [];

                        state.cache.set(cacheKey, options);

                        const availableOptions = options
                            .filter(option => !state.selectedValues.some(item => item.localeCompare(option, undefined, { sensitivity: 'accent' }) === 0));
                        renderOptionList(input, availableOptions);
                    } catch {
                        if (currentRequestId === state.requestId) {
                            hideList(input);
                        }
                    }
                };

                suggestInputs.forEach(input => {
                    const hiddenInput = getHiddenInput(input);
                    const box = getBox(input);
                    const state = getState(input);
                    state.selectedValues = parseSelectedValues(hiddenInput?.value || '');
                    syncHiddenValue(input);
                    renderSelectedValues(input);

                    box?.addEventListener('click', event => {
                        if (!(event.target instanceof Element) || event.target.closest('.column-filter-suggest-chip-remove')) {
                            return;
                        }

                        input.focus();
                    });

                    input.addEventListener('focus', () => {
                        requestOptions(input);
                    });

                    input.addEventListener('input', () => {
                        if (state.timer) {
                            clearTimeout(state.timer);
                        }

                        state.timer = setTimeout(() => {
                            state.timer = null;
                            requestOptions(input);
                        }, debounceMs);
                    });

                    input.addEventListener('blur', () => {
                        window.setTimeout(() => hideList(input), 120);
                    });

                    input.addEventListener('keydown', event => {
                        if (event.key === 'Enter') {
                            event.preventDefault();
                            addSelectedValue(input, input.value);
                            return;
                        }

                        if (event.key === 'Backspace' && !input.value.trim()) {
                            const latest = state.selectedValues.at(-1);
                            if (latest) {
                                state.selectedValues.pop();
                                syncHiddenValue(input);
                                renderSelectedValues(input);
                                requestOptions(input);
                                serializeFilterColumnDataJson();
                            }
                            return;
                        }

                        if (event.key === 'Escape') {
                            hideList(input);
                        }
                    });
                });
            }

            function normalizeColumnFilterKey(value) {
                return String(value || '')
                    .trim()
                    .replace(/^@@+/, '')
                    .toLowerCase();
            }

            function getColumnFilterLookupKeys(value) {
                const normalized = normalizeColumnFilterKey(value);
                if (!normalized) {
                    return [];
                }

                const compact = normalized.replace(/[^a-z0-9]/g, '');
                return compact && compact !== normalized
                    ? [normalized, compact]
                    : [normalized];
            }

            function resolvePersistedFilterValue(column, filterKey, existingFilterValuesByKey, persistedFilterValuesByKey) {
                const candidateKeys = [
                    filterKey,
                    column?.mappingParameter,
                    column?.MappingParameter,
                    column?.propertyName,
                    column?.PropertyName,
                    column?.displayLabel,
                    column?.DisplayLabel,
                    column?.defaultLabel,
                    column?.DefaultLabel,
                    column?.key,
                    column?.Key
                ]
                    .flatMap(getColumnFilterLookupKeys)
                    .filter((value, index, allValues) => value && allValues.indexOf(value) === index);

                const existingCandidateValues = candidateKeys
                    .filter(candidateKey => existingFilterValuesByKey.has(candidateKey))
                    .map(candidateKey => (existingFilterValuesByKey.get(candidateKey) || '').trim());

                const persistedCandidateValues = candidateKeys
                    .filter(candidateKey => persistedFilterValuesByKey.has(candidateKey))
                    .map(candidateKey => (persistedFilterValuesByKey.get(candidateKey) || '').trim());

                const firstNonEmptyExisting = existingCandidateValues.find(Boolean);
                if (firstNonEmptyExisting) {
                    return firstNonEmptyExisting;
                }

                const firstNonEmptyPersisted = persistedCandidateValues.find(Boolean);
                if (firstNonEmptyPersisted) {
                    return firstNonEmptyPersisted;
                }

                if (existingCandidateValues.length) {
                    return existingCandidateValues[0] || '';
                }

                if (persistedCandidateValues.length) {
                    return persistedCandidateValues[0] || '';
                }

                return '';
            }

            function parsePersistedColumnFilterValues() {
                const valuesByKey = new Map();
                const raw = (filterColumnDataJsonHiddenInput?.value || '').trim();
                if (!raw) {
                    return valuesByKey;
                }

                try {
                    const parsed = parseFilterColumnDataJsonRaw(raw);

                    if (!parsed.length) {
                        return valuesByKey;
                    }

                    const setFilterValueIfBetter = (rawKey, rawValue) => {
                        const nextValue = String(rawValue || '').trim();
                        getColumnFilterLookupKeys(rawKey).forEach(lookupKey => {
                            const existingValue = valuesByKey.get(lookupKey);
                            if (existingValue === undefined || (!existingValue && nextValue)) {
                                valuesByKey.set(lookupKey, nextValue);
                            }
                        });
                    };

                    parsed.forEach(column => {
                        const filterValue = String(
                            column?.mappingParameterFilter
                            ?? column?.MappingParameterFilter
                            ?? ''
                        ).trim();

                        setFilterValueIfBetter(column?.mappingParameter, filterValue);
                        setFilterValueIfBetter(column?.MappingParameter, filterValue);
                        setFilterValueIfBetter(column?.propertyName, filterValue);
                        setFilterValueIfBetter(column?.PropertyName, filterValue);
                        setFilterValueIfBetter(column?.displayLabel, filterValue);
                        setFilterValueIfBetter(column?.DisplayLabel, filterValue);
                        setFilterValueIfBetter(column?.defaultLabel, filterValue);
                        setFilterValueIfBetter(column?.DefaultLabel, filterValue);
                        setFilterValueIfBetter(column?.key, filterValue);
                        setFilterValueIfBetter(column?.Key, filterValue);
                    });
                } catch {
                    return valuesByKey;
                }

                return valuesByKey;
            }

            function parseFilterColumnDataJsonRaw(raw) {
                const normalizeToArray = value => {
                    if (Array.isArray(value)) {
                        return value;
                    }

                    if (value && typeof value === 'object') {
                        return [value];
                    }

                    return [];
                };

                const tryParseJson = value => {
                    try {
                        return JSON.parse(value);
                    } catch {
                        return null;
                    }
                };

                const decodeHtmlEntities = value => {
                    const textarea = document.createElement('textarea');
                    textarea.innerHTML = value;
                    return textarea.value;
                };

                const directParsed = tryParseJson(raw);
                if (directParsed !== null) {
                    if (typeof directParsed === 'string') {
                        const nestedParsed = tryParseJson(directParsed);
                        return nestedParsed !== null ? normalizeToArray(nestedParsed) : [];
                    }

                    return normalizeToArray(directParsed);
                }

                const decodedRaw = decodeHtmlEntities(raw);
                if (decodedRaw !== raw) {
                    const decodedParsed = tryParseJson(decodedRaw);
                    if (decodedParsed !== null) {
                        if (typeof decodedParsed === 'string') {
                            const nestedDecodedParsed = tryParseJson(decodedParsed);
                            return nestedDecodedParsed !== null ? normalizeToArray(nestedDecodedParsed) : [];
                        }

                        return normalizeToArray(decodedParsed);
                    }
                }

                return [];
            }

            function serializeFilterColumnDataJson() {
                if (!filterColumnDataJsonHiddenInput) {
                    return;
                }

                const isReportMode = getSourceMode() === 'report';
                const selectedSourceId = parseInt((reportDefinitionSelect?.value || '').trim(), 10);
                const hasSelectedSource = Number.isFinite(selectedSourceId);

                if (isReportMode || !hasSelectedSource) {
                    filterColumnDataJsonHiddenInput.value = '';
                    return;
                }

                const sourceOptions = getSourceMode() === 'report' ? (availableReports || []) : (availableDataFiles || []);
                const selectedSource = sourceOptions.find(option => parseInt(option?.id ?? option?.Id ?? '', 10) === selectedSourceId);
                const selectedColumns = selectedSource?.columns || selectedSource?.Columns || [];

                const seenColumns = new Set();
                const distinctColumns = [];

                selectedColumns.forEach(column => {
                    const propertyName = String(column?.propertyName || column?.PropertyName || column?.key || column?.Key || '').trim();
                    if (!propertyName) {
                        return;
                    }

                    const dedupeKey = propertyName.toLowerCase();
                    if (seenColumns.has(dedupeKey)) {
                        return;
                    }

                    seenColumns.add(dedupeKey);
                    distinctColumns.push(column);
                });

                const filterValuesByKey = new Map(
                    [...(columnsFilterGroup?.querySelectorAll('.column-filter-input[data-filter-key]') || [])]
                        .map(input => [
                            (input.getAttribute('data-filter-key') || '').trim(),
                            (input.value || '').trim()
                        ])
                        .filter(([key]) => key)
                );

                const payload = distinctColumns.map(column => {
                    const propertyName = String(column?.propertyName || column?.PropertyName || column?.key || column?.Key || '').trim();
                    const mappingParameter = String(column?.mappingParameter || column?.MappingParameter || '').trim();
                    const filterKey = mappingParameter || propertyName;

                    return {
                        Key: String(column?.key || column?.Key || propertyName).trim(),
                        DefaultLabel: String(column?.defaultLabel || column?.DefaultLabel || propertyName).trim(),
                        DisplayLabel: String(column?.displayLabel || column?.DisplayLabel || column?.defaultLabel || column?.DefaultLabel || propertyName).trim(),
                        IsVisible: !!(column?.isVisible ?? column?.IsVisible ?? true),
                        Order: parseInt(column?.order ?? column?.Order ?? '0', 10) || 0,
                        PropertyName: propertyName,
                        PropertyType: String(column?.propertyType || column?.PropertyType || '').trim(),
                        MappingParameter: mappingParameter,
                        MappingParameterFilter: filterValuesByKey.get(filterKey) || ''
                    };
                });

                filterColumnDataJsonHiddenInput.value = payload.length ? JSON.stringify(payload) : '';
            }

            function setPreviewStatus(message, isError) {
                if (!(previewStatus instanceof HTMLElement)) {
                    return;
                }

                previewStatus.textContent = message;
                previewStatus.classList.toggle('text-danger', !!isError);
                previewStatus.classList.toggle('text-muted', !isError);
            }

            function clearPreviewTable() {
                if (previewTableHead instanceof HTMLElement) {
                    previewTableHead.innerHTML = '';
                }

                if (previewTableBody instanceof HTMLElement) {
                    previewTableBody.innerHTML = '';
                }

                if (previewTableWrap instanceof HTMLElement) {
                    previewTableWrap.style.display = 'none';
                }
            }

            function renderPreviewTable(columnDefinitions, rows) {
                if (!(previewTableHead instanceof HTMLElement) || !(previewTableBody instanceof HTMLElement) || !(previewTableWrap instanceof HTMLElement)) {
                    return;
                }

                previewTableHead.innerHTML = '';
                previewTableBody.innerHTML = '';

                if (!Array.isArray(columnDefinitions) || columnDefinitions.length === 0) {
                    previewTableWrap.style.display = 'none';
                    return;
                }

                const headRow = document.createElement('tr');
                columnDefinitions.forEach(column => {
                    const th = document.createElement('th');
                    th.textContent = column.label;
                    headRow.appendChild(th);
                });
                previewTableHead.appendChild(headRow);

                (Array.isArray(rows) ? rows : []).forEach(row => {
                    const tr = document.createElement('tr');
                    columnDefinitions.forEach(column => {
                        const td = document.createElement('td');
                        const value = row?.[column.key];
                        td.textContent = value === null || value === undefined ? '' : String(value);
                        tr.appendChild(td);
                    });
                    previewTableBody.appendChild(tr);
                });

                previewTableWrap.style.display = 'block';
            }

            function getSelectedSourceForPreview() {
                const sourceId = parseInt((reportDefinitionSelect?.value || '').trim(), 10);
                if (!Number.isFinite(sourceId)) {
                    return null;
                }

                const mode = getSourceMode();
                const sourceOptions = mode === 'report' ? (availableReports || []) : (availableDataFiles || []);
                const selectedSource = sourceOptions.find(option => parseInt(option?.id ?? option?.Id ?? '', 10) === sourceId);
                if (!selectedSource) {
                    return null;
                }

                return { mode, sourceId, selectedSource };
            }

            function getPreviewColumnRequests(selectedSource) {
                const selectedColumns = selectedSource?.columns || selectedSource?.Columns || [];
                const seenColumns = new Set();

                return selectedColumns
                    .map(column => {
                        const propertyName = String(column?.propertyName || column?.PropertyName || column?.key || column?.Key || '').trim();
                        if (!propertyName) {
                            return null;
                        }

                        const dedupeKey = propertyName.toLowerCase();
                        if (seenColumns.has(dedupeKey)) {
                            return null;
                        }

                        seenColumns.add(dedupeKey);
                        const mappingParameter = String(column?.mappingParameter || column?.MappingParameter || '').trim();
                        const defaultLabel = String(column?.displayLabel || column?.DisplayLabel || column?.defaultLabel || column?.DefaultLabel || propertyName).trim() || propertyName;
                        return {
                            propertyName,
                            mappingParameter,
                            defaultLabel
                        };
                    })
                    .filter(Boolean);
            }

            function getPreviewParameters(mode) {
                const parameters = {};

                if (mode === 'datafile') {
                    const filterInputs = [...(columnsFilterGroup?.querySelectorAll('.column-filter-input[data-filter-key]') || [])]
                        .filter(input => input instanceof HTMLInputElement);

                    filterInputs.forEach(input => {
                        const key = (input.getAttribute('data-filter-key') || '').trim();
                        const value = (input.value || '').trim();
                        if (key && value) {
                            parameters[key] = value;
                        }
                    });
                } else {
                    parseScheduledJobParameters().forEach(parameter => {
                        const key = normalizeParameterName(parameter?.name || '');
                        const value = (parameter?.value || '').trim();
                        if (key && value) {
                            parameters[key] = value;
                        }
                    });
                }

                if (dateFromInput instanceof HTMLInputElement) {
                    const dateFromValue = (dateFromInput.value || '').trim();
                    if (dateFromValue) {
                        parameters.FilterDateFrom = dateFromValue;
                    }
                }

                if (dateToInput instanceof HTMLInputElement) {
                    const dateToValue = (dateToInput.value || '').trim();
                    if (dateToValue) {
                        parameters.FilterDateTo = dateToValue;
                    }
                }

                return parameters;
            }

            async function previewData() {
                const selectedSource = getSelectedSourceForPreview();
                if (!selectedSource) {
                    setPreviewStatus('Please select a source before preview.', true);
                    clearPreviewTable();
                    return;
                }

                const take = Number.parseInt(previewTakeSelect?.value || '10', 10) || 10;
                const columns = getPreviewColumnRequests(selectedSource.selectedSource);
                if (!columns.length) {
                    setPreviewStatus('No columns are available for the selected source.', true);
                    clearPreviewTable();
                    return;
                }

                const parameters = getPreviewParameters(selectedSource.mode);
                const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                const scheduledJobClientCodeValueInput = document.getElementById('scheduled-job-client-code-value');
                const clientCodeValue = (clientCodeFieldInput?.value || scheduledJobClientCodeValueInput?.value || '').trim();

                setPreviewStatus('Loading preview...', false);
                if (previewButton instanceof HTMLButtonElement) {
                    previewButton.disabled = true;
                }

                try {
                    const response = await fetch(previewUrl, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': antiForgeryToken
                        },
                        body: JSON.stringify({
                            sourceMode: selectedSource.mode,
                            sourceId: selectedSource.sourceId,
                            take,
                            clientCode: clientCodeValue || null,
                            columns: columns.map(column => ({
                                propertyName: column.propertyName,
                                mappingParameter: column.mappingParameter || null
                            })),
                            parameters
                        })
                    });

                    const payload = await response.json().catch(() => ({}));
                    if (!response.ok) {
                        setPreviewStatus(payload?.message || 'Failed to load preview data.', true);
                        clearPreviewTable();
                        return;
                    }

                    const previewColumns = Array.isArray(payload?.columns) ? payload.columns : [];
                    const previewRows = Array.isArray(payload?.rows) ? payload.rows : [];
                    const totalCount = Number.isFinite(Number(payload?.count))
                        ? Number(payload.count)
                        : previewRows.length;

                    const labelLookup = new Map(
                        columns
                            .filter(column => (column.propertyName || '').trim())
                            .map(column => [column.propertyName.trim().toLowerCase(), column.defaultLabel])
                    );

                    const previewColumnDefinitions = previewColumns.map(columnName => {
                        const key = (columnName || '').toString();
                        const label = labelLookup.get(key.trim().toLowerCase()) || key;
                        return { key, label };
                    });

                    renderPreviewTable(previewColumnDefinitions, previewRows);
                    setPreviewStatus(`Showing ${previewRows.length} of ${totalCount} row(s).`, false);
                } catch {
                    setPreviewStatus('Failed to load preview data.', true);
                    clearPreviewTable();
                } finally {
                    if (previewButton instanceof HTMLButtonElement) {
                        previewButton.disabled = false;
                    }
                }
            }

            function updateScheduleFields() {
                const mode = scheduleTypeSelect.value;
                everyMinutesGroup.style.display = mode === '@ScheduledJobFormViewModel.ScheduleTypeEveryMinutes' ? '' : 'none';
                dailyTimeGroup.style.display = mode === '@ScheduledJobFormViewModel.ScheduleTypeDailyTime' ? '' : 'none';
                customDaysGroup.style.display = mode === '@ScheduledJobFormViewModel.ScheduleTypeCustomDays' ? '' : 'none';
                cronGroup.style.display = mode === '@ScheduledJobFormViewModel.ScheduleTypeAdvancedCron' ? '' : 'none';

                const isCustomDays = mode === '@ScheduledJobFormViewModel.ScheduleTypeCustomDays';
                if (customDaysTimeInput) {
                    customDaysTimeInput.disabled = !isCustomDays;
                    customDaysTimeInput.required = isCustomDays;
                }

                selectedWeekdayInputs.forEach(input => {
                    input.disabled = !isCustomDays;
                    input.required = false;
                });
            }

            function updateJobActionFields() {
                if (!jobActionSelect || !recipientEmailGroup || !recipientEmailInput) {
                    return;
                }

                const requiresEmail = jobActionSelect.value === '@ScheduledJobActions.ExportFileAndEmailToUser' || jobActionSelect.value === '@ScheduledJobActions.EmailToUser';
                const requiresExportFolder = jobActionSelect.value === '@ScheduledJobActions.ExportFile' || jobActionSelect.value === '@ScheduledJobActions.ExportFileAndEmailToUser';
                recipientEmailGroup.style.display = requiresEmail ? '' : 'none';
                exportFolderGroup.style.display = requiresExportFolder ? '' : 'none';
                recipientEmailInput.required = requiresEmail;

                if (!requiresEmail) {
                    recipientEmailInput.value = '';
                }
            }

            function updatePasswordFields() {
                if (!passwordInput) {
                    return;
                }

                const isUpdateEnabled = !updatePasswordToggle || updatePasswordToggle.checked;
                passwordInput.disabled = !isUpdateEnabled;
                passwordInput.required = isUpdateEnabled;

                if (!isUpdateEnabled) {
                    passwordInput.value = '';
                }
            }

            function updateDateFields() {
                if (!isCustomToggle) {
                    return;
                }

                const isCustom = isCustomToggle.checked;

                if (dateFromGroup) {
                    dateFromGroup.style.display = isCustom ? '' : 'none';
                }

                if (dateToGroup) {
                    dateToGroup.style.display = isCustom ? '' : 'none';
                }

                if (dateFromInput) {
                    dateFromInput.disabled = !isCustom;
                }

                if (dateToInput) {
                    dateToInput.disabled = !isCustom;
                }

                if (autoDateIntervalUnitGroup) {
                    autoDateIntervalUnitGroup.style.display = isCustom ? 'none' : '';
                }

                if (autoDateIntervalValueGroup) {
                    autoDateIntervalValueGroup.style.display = isCustom ? 'none' : '';
                }

                if (autoDateIntervalHintGroup) {
                    autoDateIntervalHintGroup.style.display = isCustom ? 'none' : '';
                }

                if (autoDateIntervalUnitSelect) {
                    autoDateIntervalUnitSelect.disabled = isCustom;
                    autoDateIntervalUnitSelect.required = !isCustom;
                }

                if (autoDateIntervalValueInput) {
                    autoDateIntervalValueInput.disabled = isCustom;
                    autoDateIntervalValueInput.required = !isCustom;
                }
            }

            function normalizeWindowsPath(path) {
                return (path || '').trim().replaceAll('/', '\\');
            }

            function normalizeWindowsFolderName(path) {
                return normalizeWindowsPath(path).replace(/^\\+/, '').replace(/\\+$/, '');
            }

            function updateOpenExportLocationButtonState() {
                if (!openExportLocationButton || !exportLocationHiddenInput) {
                    return;
                }

                openExportLocationButton.disabled = !normalizeWindowsPath(exportLocationHiddenInput.value);
            }

            function ensureTrailingSlash(path) {
                const normalizedPath = normalizeWindowsPath(path);
                if (!normalizedPath) {
                    return '';
                }

                return normalizedPath.endsWith('\\') ? normalizedPath : `${normalizedPath}\\`;
            }

            function trySplitExportLocation(fullPath, availableBasePaths) {
                const normalizedFullPath = normalizeWindowsPath(fullPath);
                if (!normalizedFullPath) {
                    return { basePath: '', subfolder: '' };
                }

                const matchedBasePath = availableBasePaths
                    .map(basePath => ensureTrailingSlash(basePath))
                    .filter(basePath => normalizedFullPath.toLowerCase().startsWith(basePath.toLowerCase()))
                    .sort((left, right) => right.length - left.length)[0];

                if (!matchedBasePath) {
                    return { basePath: '', subfolder: '' };
                }

                const subfolder = normalizedFullPath.slice(matchedBasePath.length).replace(/^\\+/, '');
                return { basePath: matchedBasePath, subfolder };
            }

            function updateExportLocationValue() {
                if (!exportLocationHiddenInput || !exportLocationBasePathSelect || !exportLocationSubfolderInput) {
                    return;
                }

                const selectedBasePath = ensureTrailingSlash(exportLocationBasePathSelect.value);
                const exportLocationSubfolderError = document.getElementById('exportLocationSubfolderError');
                exportLocationBasePathSelect.disabled = false;
                exportLocationSubfolderInput.disabled = !selectedBasePath;

                if (!selectedBasePath) {
                    exportLocationSubfolderInput.value = '';
                    if (exportLocationSubfolderHiddenInput) {
                        exportLocationSubfolderHiddenInput.value = '';
                    }
                    exportLocationHiddenInput.value = '';
                    if (exportLocationSubfolderError) {
                        exportLocationSubfolderError.classList.add('d-none');
                    }
                    if (exportToLocalFolderHint) {
                        exportToLocalFolderHint.textContent = 'If enabled, an extra copy will be saved to the User Remote Folder and can be opened via Menu > Report/Data File Folder.';
                    }
                    updateOpenExportLocationButtonState();
                    return;
                }

                const normalizedSubfolder = normalizeWindowsFolderName(exportLocationSubfolderInput.value);
                if (exportLocationSubfolderHiddenInput) {
                    exportLocationSubfolderHiddenInput.value = normalizedSubfolder;
                }

                exportLocationHiddenInput.value = normalizedSubfolder
                    ? `${selectedBasePath}${normalizedSubfolder}`
                    : '';

                if (exportToLocalFolderHint) {
                    exportToLocalFolderHint.textContent = normalizedSubfolder
                        // ? `When enabled, an additional copy is saved to: %temp%\\${normalizedSubfolder}`
                        ? 'If enabled, an extra copy will be saved to the User Remote Folder and can be opened via Menu > Report/Data File Folder.'
                        : 'If enabled, an extra copy will be saved to the User Remote Folder and can be opened via Menu > Report/Data File Folder.';
                }

                updateOpenExportLocationButtonState();
            }

            function initializeExportLocationFields() {
                if (!exportLocationHiddenInput || !exportLocationBasePathSelect || !exportLocationSubfolderInput) {
                    return;
                }

                const exportLocationBasePathError = document.getElementById('exportLocationBasePathError');
                const exportLocationSubfolderError = document.getElementById('exportLocationSubfolderError');
                const availableBasePaths = [...exportLocationBasePathSelect.options]
                    .map(option => option.value)
                    .filter(optionValue => optionValue);

                function syncExportLocationValidationFeedback(forceShow) {
                    const hasBasePath = !!exportLocationBasePathSelect.value;
                    const hasSubfolder = !!normalizeWindowsFolderName(exportLocationSubfolderInput.value);
                    const hasExistingValidationState =
                        exportLocationBasePathSelect.classList.contains('is-invalid')
                        || exportLocationSubfolderInput.classList.contains('is-invalid')
                        || !!(exportLocationBasePathError && !exportLocationBasePathError.classList.contains('d-none'))
                        || !!(exportLocationSubfolderError && !exportLocationSubfolderError.classList.contains('d-none'));

                    if (!forceShow && !hasExistingValidationState) {
                        return;
                    }

                    exportLocationBasePathSelect.classList.toggle('is-invalid', !hasBasePath);
                    exportLocationSubfolderInput.classList.toggle('is-invalid', !hasSubfolder);

                    if (exportLocationBasePathError) {
                        exportLocationBasePathError.classList.toggle('d-none', hasBasePath);
                    }

                    if (exportLocationSubfolderError) {
                        exportLocationSubfolderError.classList.toggle('d-none', hasSubfolder);
                    }
                }

                const { basePath, subfolder } = trySplitExportLocation(exportLocationHiddenInput.value, availableBasePaths);
                exportLocationBasePathSelect.value = basePath || (availableBasePaths[0] || '');
                const initialSubfolder = normalizeWindowsFolderName((exportLocationSubfolderHiddenInput?.value || '').trim()) || subfolder;
                let initialSubfolderOptionValue = '';
                if (initialSubfolder) {
                    const existingOption = [...exportLocationSubfolderInput.options]
                        .find(option => normalizeWindowsFolderName(option.value).localeCompare(initialSubfolder, undefined, { sensitivity: 'accent' }) === 0);

                    if (existingOption) {
                        initialSubfolderOptionValue = existingOption.value;
                    } else {
                        const option = document.createElement('option');
                        option.value = initialSubfolder;
                        option.textContent = initialSubfolder;
                        exportLocationSubfolderInput.appendChild(option);
                        initialSubfolderOptionValue = option.value;
                    }
                }

                exportLocationSubfolderInput.value = initialSubfolderOptionValue;
                if (exportLocationSubfolderHiddenInput) {
                    exportLocationSubfolderHiddenInput.value = initialSubfolder;
                }
                lastConfirmedExportLocationSubfolder = initialSubfolderOptionValue;
                updateExportLocationValue();

                exportLocationBasePathSelect.addEventListener('change', () => {
                    updateExportLocationValue();
                    syncExportLocationValidationFeedback(false);
                });
                exportLocationSubfolderInput.addEventListener('input', () => {
                    updateExportLocationValue();
                    syncExportLocationValidationFeedback(false);
                });
                exportLocationSubfolderInput.addEventListener('change', () => {
                    if (suppressExportLocationSubfolderConfirm) {
                        suppressExportLocationSubfolderConfirm = false;
                        updateExportLocationValue();
                        syncExportLocationValidationFeedback(false);
                        return;
                    }

                    const selectedOptionValue = exportLocationSubfolderInput.value;
                    const selectedValue = normalizeWindowsFolderName(exportLocationSubfolderInput.value);
                    if (!selectedValue) {
                        lastConfirmedExportLocationSubfolder = '';
                        updateExportLocationValue();
                        syncExportLocationValidationFeedback(false);
                        return;
                    }

                    const confirmed = window.confirm(`Confirm select export subfolder "${selectedValue}"?`);
                    if (!confirmed) {
                        suppressExportLocationSubfolderConfirm = true;
                        exportLocationSubfolderInput.value = lastConfirmedExportLocationSubfolder;
                        updateExportLocationValue();
                        syncExportLocationValidationFeedback(false);
                        return;
                    }

                    lastConfirmedExportLocationSubfolder = selectedOptionValue;
                    updateExportLocationValue();
                    syncExportLocationValidationFeedback(false);
                });

                if (exportToLocalFolderToggle) {
                    exportToLocalFolderToggle.addEventListener('change', () => {
                        ProcessHasAnyExportLocationfolderError();
                        updateExportLocationValue();
                    });
                }

                if (isExportToClientFolderToggle) {
                    isExportToClientFolderToggle.addEventListener('change', () => {
                        ProcessHasAnyExportLocationfolderError();
                        exportLocationSubfolderInput.hidden = !exportLocationSubfolderInput.hidden;
                        exportLocationSubfolderError.hidden = !isExportToClientFolderToggle.checked;
                    });
                }

                function ProcessHasAnyExportLocationfolderError() {
                    const isExportFolder = jobActionSelect.value === '@ScheduledJobActions.ExportFileAndEmailToUser' || jobActionSelect.value === '@ScheduledJobActions.ExportFile';
                    noAnyExportLocationfolderError.hidden = !isExportFolder || exportToLocalFolderToggle.checked || isExportToClientFolderToggle.checked;
                }

                if (openExportLocationButton) {
                    openExportLocationButton.addEventListener('click', () => {
                        const targetPath = normalizeWindowsPath(exportLocationHiddenInput.value);
                        if (!targetPath) {
                            return;
                        }

                        const url = `${openExportLocationUrl}?exportLocation=${encodeURIComponent(targetPath)}`;
                        window.open(url, '_blank', 'noopener,noreferrer');
                    });
                }

                const form = exportLocationBasePathSelect.closest('form');
                if (form && availableBasePaths.length > 0) {
                    form.addEventListener('submit', event => {
                        const hasBasePath = !!exportLocationBasePathSelect.value;
                        // const hasSubfolder = !!normalizeWindowsFolderName(exportLocationSubfolderInput.value);
                        const isExportFolder = jobActionSelect.value === '@ScheduledJobActions.ExportFileAndEmailToUser' || jobActionSelect.value === '@ScheduledJobActions.ExportFile';
                        const isExportToClientFolder = isExportToClientFolderToggle.checked;
                        const isExportToLocalFolder = exportToLocalFolderToggle.checked;
                        const hasSubfolder = !isExportToClientFolder ||
                            (isExportToClientFolder && !!normalizeWindowsFolderName(exportLocationSubfolderInput.value));
                        const hasAnyExportLocationfolder = !isExportFolder || (isExportFolder && (isExportToClientFolder || isExportToLocalFolder));

                        if (hasAnyExportLocationfolder) {
                            noAnyExportLocationfolderError.hidden = true;
                        } else {
                            noAnyExportLocationfolderError.hidden = false;
                            isExportToClientFolderToggle.focus();
                            return;
                        }

                        const isValid = hasBasePath && hasSubfolder && hasAnyExportLocationfolder;

                        if(!isValid){
                            syncExportLocationValidationFeedback(true);
                        }
                        // syncExportLocationValidationFeedback(true);

                        if (!isValid) {
                            event.preventDefault();
                            event.stopImmediatePropagation();
                            if (!hasBasePath) {
                                exportLocationBasePathSelect.focus();
                            } else if (!hasSubfolder) {
                                exportLocationSubfolderInput.focus();
                            }
                        }
                    }, true);
                }

                updateOpenExportLocationButtonState();
            }

            function updateClientCodeSelectOptions() {
                if (!reportDefinitionSelect || !clientCodeSelect) {
                    return;
                }

                if (!requiresSchemaAndClientCode()) {
                    clientCodeSelect.innerHTML = '';
                    const defaultOption = document.createElement('option');
                    defaultOption.value = '';
                    defaultOption.textContent = 'Default';
                    clientCodeSelect.appendChild(defaultOption);
                    syncClientCodeUi('');
                    return;
                }             

                const selectedReportId = parseInt(reportDefinitionSelect.value, 10);
                const reportSchemaTemplates = Number.isFinite(selectedReportId)
                    ? (availableSchemaTemplatesByReportId[selectedReportId] || [])
                    : [];

                const distinctClientCodes = [...new Set(reportSchemaTemplates
                    .map(clientCode => (clientCode || '').trim())
                    .filter(clientCode => clientCode.length > 0)
                    .sort((left, right) => left.localeCompare(right, undefined, { sensitivity: 'accent' })))];

                const currentValue = (clientCodeHiddenInput?.value || '').trim();

                clientCodeSelect.innerHTML = '';
                const defaultOption = document.createElement('option');
                defaultOption.value = '';
                defaultOption.textContent = 'Default';
                clientCodeSelect.appendChild(defaultOption);

                distinctClientCodes.forEach(clientCode => {
                    const option = document.createElement('option');
                    option.value = clientCode;
                    option.textContent = clientCode;
                    clientCodeSelect.appendChild(option);
                });

                if (currentValue && !distinctClientCodes.some(value => value.localeCompare(currentValue, undefined, { sensitivity: 'accent' }) === 0)) {
                    const option = document.createElement('option');
                    option.value = currentValue;
                    option.textContent = currentValue;
                    clientCodeSelect.appendChild(option);
                }

                syncClientCodeUi(currentValue);
            }

            function normalizeParameterName(name) {
                return (name || '').trim().replace(/^@@+/, '');
            }

            function escapeHtmlAttribute(value) {
                return String(value || '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            function parseScheduledJobParameters() {
                const raw = (parametersHiddenInput?.value || '').trim();
                if (!raw) {
                    return [];
                }

                try {
                    const parsed = JSON.parse(raw);
                    if (!Array.isArray(parsed)) {
                        return [];
                    }

                    return parsed
                        .map(item => ({
                            name: normalizeParameterName(item?.name || item?.Name || ''),
                            value: (item?.value || item?.Value || '').toString().trim()
                        }))
                        .filter(item => item.name);
                } catch {
                    return [];
                }
            }

            function getSelectedReportParameters() {
                if (!reportDefinitionSelect) {
                    return [];
                }

                const selectedReportId = parseInt(reportDefinitionSelect.value, 10);
                return Number.isFinite(selectedReportId)
                    ? (availableParametersByReportId[selectedReportId] || [])
                    : [];
            }

            function getScheduledParameterState() {
                const existingValues = new Map(
                    parseScheduledJobParameters().map(item => [normalizeParameterName(item.name), item.value || ''])
                );

                return getSelectedReportParameters()
                    .map(parameter => {
                        const queryKey = normalizeParameterName(parameter.queryKey || parameter.QueryKey || '');
                        if (!queryKey) {
                            return null;
                        }

                        const name = (parameter.name || parameter.Name || '').toString().trim() || `@@${queryKey}`;
                        const defaultValue = (parameter.defaultValue || parameter.DefaultValue || '').toString().trim();
                        const value = existingValues.has(queryKey)
                            ? (existingValues.get(queryKey) || '')
                            : defaultValue;

                        return {
                            queryKey,
                            name,
                            defaultValue,
                            value,
                            isRequired: !!(parameter.isRequired || parameter.IsRequired)
                        };
                    })
                    .filter(Boolean);
            }

            function serializeScheduledJobParameters() {
                if (!parametersHiddenInput || !scheduledParametersContainer) {
                    return;
                }

                const visibleValuesByQueryKey = new Map(
                    [...scheduledParametersContainer.querySelectorAll('[data-scheduled-param-row]')].map(row => {
                        const queryKey = normalizeParameterName(row.getAttribute('data-param-query-key') || '');
                        const input = row.querySelector('input[data-scheduled-param-value]');
                        return [queryKey, (input?.value || '').trim()];
                    })
                );

                const payload = getScheduledParameterState()
                    .map(parameter => ({
                        Name: `@@${parameter.queryKey}`,
                        Value: (visibleValuesByQueryKey.has(parameter.queryKey)
                            ? visibleValuesByQueryKey.get(parameter.queryKey)
                            : parameter.value) || null
                    }))
                    .filter(Boolean);

                parametersHiddenInput.value = payload.length ? JSON.stringify(payload) : '';
            }

            function renderScheduledParameterInputs() {
                if (!reportDefinitionSelect || !scheduledParametersContainer || !scheduledParametersEmpty) {
                    return;
                }

                const reportParameters = getScheduledParameterState();
                const visibleParameters = reportParameters.filter(parameter => !parameter.defaultValue);

                scheduledParametersContainer.querySelectorAll('[data-scheduled-param-row]').forEach(row => row.remove());

                if (!Array.isArray(reportParameters) || reportParameters.length === 0) {
                    scheduledParametersEmpty.textContent = 'No parameters for the selected report.';
                    scheduledParametersEmpty.style.display = 'block';
                    if (parametersHiddenInput) {
                        parametersHiddenInput.value = '';
                    }
                    return;
                }

                if (visibleParameters.length === 0) {
                    scheduledParametersEmpty.textContent = 'All parameters for the selected report already have default values.';
                    scheduledParametersEmpty.style.display = 'block';
                    serializeScheduledJobParameters();
                    return;
                }

                scheduledParametersEmpty.style.display = 'none';

                visibleParameters.forEach(parameter => {
                    const labelText = parameter.isRequired ? `${parameter.name} *` : parameter.name;
                    const placeholder = parameter.isRequired ? 'Required' : 'Optional';

                    const row = document.createElement('div');
                    row.className = 'row g-2 align-items-center mb-2';
                    row.setAttribute('data-scheduled-param-row', 'true');
                    row.setAttribute('data-param-query-key', parameter.queryKey);
                    row.innerHTML = `
                        <div class="col-md-4">
                            <span class="bg-secondary-subtle text-secondary-emphasis border">${labelText}</span>
                        </div>
                        <div class="col-md-8">
                            <input type="text" class="form-control form-control-sm" data-scheduled-param-value="true" placeholder="${placeholder}" value="${escapeHtmlAttribute(parameter.value)}" />
                        </div>`;

                    scheduledParametersContainer.appendChild(row);
                });

                serializeScheduledJobParameters();
            }

            function syncClientCodeUi(value) {
                if (!clientCodeHiddenInput || !clientCodeSelect || !clientCodeDropdownToggle) {
                    return;
                }

                const normalizedValue = (value || '').trim();
                clientCodeHiddenInput.value = normalizedValue;
                clientCodeSelect.value = normalizedValue;
                clientCodeDropdownToggle.textContent = normalizedValue || 'Default';
                renderClientCodeOptions(clientCodeSearchInput?.value || '');
            }

            function renderClientCodeOptions(searchValue) {
                if (!clientCodeOptions || !clientCodeSelect) {
                    return;
                }

                const normalizedSearch = (searchValue || '').trim().toLocaleLowerCase();
                const selectedValue = clientCodeSelect.value;
                clientCodeOptions.innerHTML = '';

                [...clientCodeSelect.options].forEach((option, index) => {
                    const isDefault = index === 0;
                    const isMatch = !normalizedSearch || option.text.toLocaleLowerCase().includes(normalizedSearch);
                    const isSelected = option.value.localeCompare(selectedValue, undefined, { sensitivity: 'accent' }) === 0;
                    if (!(isDefault || isMatch || isSelected)) {
                        return;
                    }

                    const optionButton = document.createElement('button');
                    optionButton.type = 'button';
                    optionButton.className = `list-group-item list-group-item-action py-1 px-2${isSelected ? ' active' : ''}`;
                    optionButton.textContent = option.text;
                    optionButton.addEventListener('click', () => {
                        syncClientCodeUi(option.value);
                    });
                    clientCodeOptions.appendChild(optionButton);
                });

                if (!clientCodeOptions.children.length) {
                    const empty = document.createElement('div');
                    empty.className = 'text-muted small px-2 py-1';
                    empty.textContent = 'No matches';
                    clientCodeOptions.appendChild(empty);
                }
            }

            scheduleTypeSelect.addEventListener('change', updateScheduleFields);

            if (jobActionSelect) {
                jobActionSelect.addEventListener('change', updateJobActionFields);
            }

            if (clientCodeSearchInput) {
                clientCodeSearchInput.addEventListener('input', event => {
                    const searchValue = event.target instanceof HTMLInputElement ? event.target.value : '';
                    renderClientCodeOptions(searchValue);
                });
            }

            if (clientCodeClearButton) {
                clientCodeClearButton.addEventListener('click', () => {
                    syncClientCodeUi('');
                });
            }

            if (reportDefinitionSelect) {
                reportDefinitionSelect.addEventListener('change', () => {
                    updateSchemaAndClientCodeFields();
                    updateClientCodeSelectOptions();
                    renderScheduledParameterInputs();
                    renderColumnsFilterGroup();
                    setPreviewStatus('Click Preview to load sample rows from the selected source.', false);
                    clearPreviewTable();
                });
            }

            if (sourceModeSelect) {
                sourceModeSelect.addEventListener('change', () => {

                    setSourceMode(getSourceMode());
                    renderSourceOptions(true);
                    updateSchemaAndClientCodeFields();
                    updateClientCodeSelectOptions();
                    renderScheduledParameterInputs();
                    renderColumnsFilterGroup();
                    setPreviewStatus('Click Preview to load sample rows from the selected source.', false);
                    clearPreviewTable();
                });
            }

            if (previewButton) {
                previewButton.addEventListener('click', previewData);
            }

            if (scheduledParametersContainer) {
                scheduledParametersContainer.addEventListener('input', event => {
                    if (event.target instanceof HTMLInputElement && event.target.matches('[data-scheduled-param-value]')) {
                        serializeScheduledJobParameters();
                    }
                });
            }

            if (columnsFilterGroup) {
                columnsFilterGroup.addEventListener('input', () => {
                    serializeFilterColumnDataJson();
                });
            }

            if (updatePasswordToggle) {
                updatePasswordToggle.addEventListener('change', () => {
                    updatePasswordFields();
                });
            }

            if (toggleExistingPasswordVisibility && existingPasswordInput) {
                toggleExistingPasswordVisibility.addEventListener('click', () => {
                    const isHidden = existingPasswordInput.type === 'password';
                    existingPasswordInput.type = isHidden ? 'text' : 'password';
                    toggleExistingPasswordVisibility.textContent = isHidden ? 'Hide' : 'Show';
                });
            }

            if (isCustomToggle) {
                isCustomToggle.addEventListener('change', updateDateFields);
            }

            if (isUseRecurringDataDateColumnToggle) {
                isUseRecurringDataDateColumnToggle.addEventListener('change', () => {
                    const isUseRecurringDataDateColumn = isUseRecurringDataDateColumnToggle.checked
                    const isReportMode = getSourceMode() === 'report';

                    console.log('isUseRecurringDataDateColumnToggle');
                    console.log('isReportMode:' + isReportMode);
                    console.log('isUseRecurringDataDateColumn:' + isUseRecurringDataDateColumn);

                    recurringDataDateColumnGroup.classList.toggle('d-none', !(!isReportMode && isUseRecurringDataDateColumn));
                    autoDateIntervalUnitGroup.classList.toggle('d-none', !(isReportMode || (!isReportMode && isUseRecurringDataDateColumn)));
                    autoDateIntervalValueGroup.classList.toggle('d-none', !(isReportMode || (!isReportMode && isUseRecurringDataDateColumn)));
                    autoDateIntervalHintGroup.classList.toggle('d-none', !(isReportMode || (!isReportMode && isUseRecurringDataDateColumn)));

                    if(isUseRecurringDataDateColumnToggle.checked){
                        refreshProcessDataColumnOptions();
                    }
                });
            }

            const scheduledJobForm = scheduleTypeSelect.closest('form');
            if (scheduledJobForm) {
                scheduledJobForm.addEventListener('submit', () => {
                    serializeFilterColumnDataJson();
                }, true);
            }

            function refreshProcessDataColumnOptions() {
                const select = document.getElementById('process-data-column-select');
                if (!(select instanceof HTMLSelectElement)) {
                    return;
                }

                const currentValue = (select.value || '').trim();
                const options = [...new Set(
                    [...document.querySelectorAll('#columnsFilterGroup .column-filter-input[data-column-key]')]
                        .filter(input => ((input.getAttribute('data-column-type') || '').trim().toLowerCase() === 'date'))
                        .map(input => (input.getAttribute('data-column-key') || '').trim())
                        .filter(Boolean)
                )];

                select.innerHTML = '';

                options.forEach(value => {
                    const option = document.createElement('option');
                    option.value = value;
                    option.textContent = value;
                    if (value === currentValue) {
                        option.selected = true;
                    }
                    select.appendChild(option);
                });

                if (select.options.length > 0 && !options.includes(currentValue)) {
                    select.selectedIndex = 0;
                }
            }

            // Initialize searchable client code dropdown
            const scheduledJobClientCodeValueInput = document.getElementById('scheduled-job-client-code-value');
            const scheduledJobClientCodeToggle = document.getElementById('scheduled-job-client-code-toggle');
            const scheduledJobClientCodeSearchInput = document.getElementById('scheduled-job-client-code-search');
            const scheduledJobClientCodeOptions = document.getElementById('scheduled-job-client-code-options');
            const scheduledJobClientCodeError = document.getElementById('scheduled-job-client-code-error');
            const scheduledJobClientCodeSelect = document.getElementById('scheduled-job-client-code-select');
            //const clientCodeFieldInput = document.getElementById('ClientCode');

            function renderScheduledJobClientCodeOptions(searchText = '') {
                if (!scheduledJobClientCodeOptions || !scheduledJobClientCodeSelect) {
                    return;
                }

                scheduledJobClientCodeOptions.innerHTML = '';
                const filterLower = (searchText || '').toLowerCase();
                let hasMatches = false;

                const options = Array.from(scheduledJobClientCodeSelect.options || [])
                    .filter(opt => opt.value !== '')
                    .filter(opt => !filterLower || opt.textContent.toLowerCase().includes(filterLower));

                options.forEach(opt => {
                    hasMatches = true;
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = `list-group-item list-group-item-action ${opt.value === (scheduledJobClientCodeValueInput?.value || '') ? 'active' : ''}`;
                    button.textContent = opt.textContent;
                    button.dataset.value = opt.value;

                    button.addEventListener('click', (e) => {
                        e.preventDefault();
                        scheduledJobClientCodeValueInput.value = opt.value;
                        if (clientCodeFieldInput) {
                            clientCodeFieldInput.value = opt.value;
                        }
                        scheduledJobClientCodeToggle.textContent = opt.textContent;
                        scheduledJobClientCodeSearchInput.value = '';
                        renderScheduledJobClientCodeOptions();

                        const bsDropdown = bootstrap.Dropdown.getInstance(scheduledJobClientCodeToggle);
                        if (bsDropdown) {
                            bsDropdown.hide();
                        }
                    });

                    scheduledJobClientCodeOptions.appendChild(button);
                });

                if (!hasMatches) {
                    const emptyMsg = document.createElement('div');
                    emptyMsg.className = 'text-muted small p-2';
                    emptyMsg.textContent = 'No matching client codes';
                    scheduledJobClientCodeOptions.appendChild(emptyMsg);
                }
            }

            if (scheduledJobClientCodeSearchInput) {
                scheduledJobClientCodeSearchInput.addEventListener('input', () => {
                    renderScheduledJobClientCodeOptions(scheduledJobClientCodeSearchInput.value);
                });
            }

            renderScheduledJobClientCodeOptions();

            updateScheduleFields();
            updateJobActionFields();
            setSourceMode(getSourceMode());
            renderSourceOptions(false);
            updateClientCodeSelectOptions();
            updateSchemaAndClientCodeFields();
            renderScheduledParameterInputs();
            renderColumnsFilterGroup();
            updatePasswordFields();
            updateDateFields();
            initializeExportLocationFields();
        })();
    </script>
}
