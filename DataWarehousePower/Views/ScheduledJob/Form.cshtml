@model DataWarehousePower.Models.ScheduledJobFormViewModel
@{
    bool isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Scheduled Job" : "Create Scheduled Job";
}

<div class="mb-3 d-flex justify-content-between align-items-center">
    <h4 class="mb-0">@ViewData["Title"]</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Save" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <input asp-for="ReturnUrl" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                @* <div class="col-12">
                    <div class="form-text">Job name is generated automatically from the user ID, report name, client code, and filter client code.</div>
                    @if (isEdit)
                    {
                        <label class="form-label mt-2">Generated Job Name</label>
                        <input type="text" class="form-control" value="@Model.JobName" readonly />
                    }
                </div> *@
                <div class="col-md-3">
                    <label asp-for="ReportDefinitionId" class="form-label"></label>
                    <select asp-for="ReportDefinitionId" class="form-select">
                        <option value="">-- Select report --</option>
                        @foreach (ReportDefinitionLookupItem report in Model.AvailableReports)
                        {
                            <option value="@report.Id">@report.ReportName</option>
                        }
                    </select>
                    <span asp-validation-for="ReportDefinitionId" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="Formats" class="form-label"></label>
                    <div id="scheduled-formats" class="d-flex flex-column gap-1 text-uppercase">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="scheduled-format-csv" name="Formats" value="csv" checked="@Model.Formats.Contains("csv", StringComparer.OrdinalIgnoreCase)" />
                            <label class="form-check-label" for="scheduled-format-csv">CSV</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="scheduled-format-excel" name="Formats" value="excel" checked="@Model.Formats.Contains("excel", StringComparer.OrdinalIgnoreCase)" />
                            <label class="form-check-label" for="scheduled-format-excel">EXCEL</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="scheduled-format-pdf" name="Formats" value="pdf" checked="@Model.Formats.Contains("pdf", StringComparer.OrdinalIgnoreCase)" />
                            <label class="form-check-label" for="scheduled-format-pdf">PDF</label>
                        </div>
                    </div>
                    <div class="form-text">Select one or more formats.</div>
                    <span asp-validation-for="Formats" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="JobAction" class="form-label"></label>
                    <select asp-for="JobAction" class="form-select" id="jobActionSelect">
                        <option value="@ScheduledJobActions.ExportFile">Export file</option>
                        <option value="@ScheduledJobActions.ExportFileAndEmailToUser">Export file and email to user</option>
                    </select>
                    <span asp-validation-for="JobAction" class="text-danger"></span>
                </div>

                <div class="col-md-6" id="recipientEmailGroup">
                    <label asp-for="RecipientEmail" class="form-label"></label>
                    <textarea asp-for="RecipientEmail" class="form-control" rows="3" placeholder="user@company.com; other@company.com"></textarea>
                    <div class="form-text">Required only for "Export file and email to user" action. Separate multiple addresses with commas, semicolons, or new lines.</div>
                    <span asp-validation-for="RecipientEmail" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ExportLocation" class="form-label"></label>
                    <input asp-for="ExportLocation" class="form-control" placeholder="Leave blank to use app root folder" />
                    <div class="form-text">Use an absolute path or a path relative to the app root folder.</div>
                    <span asp-validation-for="ExportLocation" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ScheduleType" class="form-label"></label>
                    <select asp-for="ScheduleType" class="form-select" id="scheduleTypeSelect">
                        <option value="@ScheduledJobFormViewModel.ScheduleTypeEveryMinutes">Every N minutes</option>
                        <option value="@ScheduledJobFormViewModel.ScheduleTypeDailyTime">Daily at time</option>
                        <option value="@ScheduledJobFormViewModel.ScheduleTypeCustomDays">Custom dates</option>
                        @* <option value="@ScheduledJobFormViewModel.ScheduleTypeAdvancedCron">Advanced (Cron)</option> *@
                    </select>
                </div>

                <div class="col-md-6" id="everyMinutesGroup">
                    <label asp-for="EveryMinutes" class="form-label"></label>
                    <input asp-for="EveryMinutes" type="number" min="1" max="1440" class="form-control" placeholder="5" />
                    <div class="form-text">Example: every 5 minutes.</div>
                    <span asp-validation-for="EveryMinutes" class="text-danger"></span>
                </div>

                <div class="col-md-6" id="dailyTimeGroup">
                    <label asp-for="DailyTime" class="form-label"></label>
                    <input asp-for="DailyTime" type="time" class="form-control" />
                    <div class="form-text">Example: 08:30 means every day at 8:30 AM.</div>
                    <span asp-validation-for="DailyTime" class="text-danger"></span>
                </div>

                <div class="col-md-12" id="customDaysGroup">
                    <label class="form-label">Custom dates</label>
                    <div class="border rounded p-3">
                        <div class="row g-2 mb-3">
                            <div class="col-md-3 col-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="weekdayMonday" name="SelectedWeekdays" value="1" checked="@Model.SelectedWeekdays.Contains(1)" />
                                    <label class="form-check-label" for="weekdayMonday">Monday</label>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="weekdayTuesday" name="SelectedWeekdays" value="2" checked="@Model.SelectedWeekdays.Contains(2)" />
                                    <label class="form-check-label" for="weekdayTuesday">Tuesday</label>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="weekdayWednesday" name="SelectedWeekdays" value="3" checked="@Model.SelectedWeekdays.Contains(3)" />
                                    <label class="form-check-label" for="weekdayWednesday">Wednesday</label>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="weekdayThursday" name="SelectedWeekdays" value="4" checked="@Model.SelectedWeekdays.Contains(4)" />
                                    <label class="form-check-label" for="weekdayThursday">Thursday</label>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="weekdayFriday" name="SelectedWeekdays" value="5" checked="@Model.SelectedWeekdays.Contains(5)" />
                                    <label class="form-check-label" for="weekdayFriday">Friday</label>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="weekdaySaturday" name="SelectedWeekdays" value="6" checked="@Model.SelectedWeekdays.Contains(6)" />
                                    <label class="form-check-label" for="weekdaySaturday">Saturday</label>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="weekdaySunday" name="SelectedWeekdays" value="0" checked="@Model.SelectedWeekdays.Contains(0)" />
                                    <label class="form-check-label" for="weekdaySunday">Sunday</label>
                                </div>
                            </div>
                        </div>

                        <div class="row g-2 align-items-end">
                            <div class="col-md-4">
                                <label asp-for="CustomDaysTime" class="form-label"></label>
                                <input asp-for="CustomDaysTime" type="time" class="form-control" />
                                <span asp-validation-for="CustomDaysTime" class="text-danger"></span>
                            </div>
                            <div class="col-md-8">
                                <div class="form-text mb-2">Select one or more days and one execution time that applies to all selected days.</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6" id="cronGroup">
                    <label asp-for="CronExpression" class="form-label"></label>
                    <input asp-for="CronExpression" class="form-control" placeholder="0 8 * * *" />
                    <div class="form-text">Use only for advanced schedules.</div>
                    <span asp-validation-for="CronExpression" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    @if (isEdit)
                    {
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label asp-for="Password" class="form-label mb-0"></label>
                            <div class="form-check mb-0">
                                <input asp-for="UpdatePassword" class="form-check-input" id="updatePasswordToggle" />
                                <label asp-for="UpdatePassword" class="form-check-label"></label>
                            </div>
                        </div>

                        <div class="input-group mb-2">
                            <input id="existingPasswordInput" type="password" class="form-control" value="@Model.ExistingPassword" readonly autocomplete="off" />
                            <button id="toggleExistingPasswordVisibility" type="button" class="btn btn-outline-secondary">Show</button>
                        </div>
                        <div class="form-text mb-2">Current password is shown for reference. Turn on Update Password only when changing it.</div>
                    }
                    else
                    {
                        <label asp-for="Password" class="form-label"></label>
                    }

                    <input asp-for="Password" id="passwordInput" type="password" class="form-control" placeholder="@(isEdit ? "Enter a new password only when updating" : "Required")" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    @* <label asp-for="SchemaTemplate" class="form-label"></label> *@
                    <label class="form-label">Schema Template</label>
                    <input asp-for="SchemaTemplate" type="hidden" />

                    <select id="scheduled-client-code-select" class="d-none" aria-hidden="true">
                        <option value="">Default</option>
                        @foreach (string availableClientCode in Model.AvailableSchemaTemplates)
                        {
                            <option value="@availableClientCode" selected="@(availableClientCode.Equals(Model.SchemaTemplate ?? string.Empty, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@availableClientCode</option>
                        }
                    </select>

                    <div class="d-flex gap-2 align-items-center flex-nowrap">
                        <div class="dropdown flex-grow-1">
                            <button id="scheduled-client-code-dropdown-toggle"
                                    class="btn btn-sm btn-outline-secondary dropdown-toggle w-100 text-start"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    data-bs-auto-close="outside"
                                    aria-expanded="false">
                                Default
                            </button>
                            <div class="dropdown-menu p-2 w-100" style="min-width: 260px;">
                                <input id="scheduled-client-code-search"
                                       type="text"
                                       class="form-control form-control-sm mb-2"
                                       maxlength="128"
                                       placeholder="Search client code"
                                       autocomplete="off" />
                                <div id="scheduled-client-code-options" class="list-group list-group-flush" style="max-height: 220px; overflow-y: auto;"></div>
                            </div>
                        </div>

                        <button id="scheduled-client-code-clear" type="button" class="btn btn-sm btn-outline-secondary">Clear</button>
                    </div>
                    <span asp-validation-for="SchemaTemplate" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ClientCode" class="form-label"></label>
                    @{
                        string selectedClientCode = (Model.ClientCode ?? string.Empty).Trim();
                        bool hasSelectedClientCode = !string.IsNullOrWhiteSpace(selectedClientCode)
                            && Model.AvailableClientCodes.Any(code => code.Equals(selectedClientCode, StringComparison.OrdinalIgnoreCase));
                    }
                    <select asp-for="ClientCode" class="form-select">
                        <option value="">All client codes</option>
                        @foreach (string availableClientCode in Model.AvailableClientCodes)
                        {
                            <option value="@availableClientCode" selected="@(availableClientCode.Equals(Model.ClientCode ?? string.Empty, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@availableClientCode</option>
                        }
                        @if (!hasSelectedClientCode && !string.IsNullOrWhiteSpace(selectedClientCode))
                        {
                            <option value="@selectedClientCode" selected="selected">@selectedClientCode</option>
                        }
                    </select>
                    <span asp-validation-for="ClientCode" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <input asp-for="Parameters" type="hidden" id="scheduled-job-parameters" />
                    <label class="form-label">Parameters</label>
                    <div id="scheduled-parameters-container" class="border rounded p-3">
                        <div id="scheduled-parameters-empty" class="text-muted small">No parameters require input for the selected report.</div>
                    </div>
                    <div class="form-text">These values are used when this scheduled job runs report export. Only parameters without defaults are shown here.</div>
                    <span asp-validation-for="Parameters" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="IsCustom" class="form-check-input" id="isCustomToggle" />
                        <label asp-for="IsCustom" class="form-check-label"></label>
                    </div>
                    <div class="form-text">When disabled, both Date From and Date To are auto-set to the previous business day (Monday/weekend runs use Friday).</div>
                </div>

                <div class="col-md-6" id="dateFromGroup">
                    <label asp-for="DateFrom" class="form-label"></label>
                    <input asp-for="DateFrom" type="date" class="form-control" />
                    <span asp-validation-for="DateFrom" class="text-danger"></span>
                </div>

                <div class="col-md-6" id="dateToGroup">
                    <label asp-for="DateTo" class="form-label"></label>
                    <input asp-for="DateTo" type="date" class="form-control" />
                    <span asp-validation-for="DateTo" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const scheduleTypeSelect = document.getElementById('scheduleTypeSelect');
            const jobActionSelect = document.getElementById('jobActionSelect');
            const recipientEmailGroup = document.getElementById('recipientEmailGroup');
            const recipientEmailInput = document.getElementById('RecipientEmail');
            const everyMinutesGroup = document.getElementById('everyMinutesGroup');
            const dailyTimeGroup = document.getElementById('dailyTimeGroup');
            const customDaysGroup = document.getElementById('customDaysGroup');
            const customDaysTimeInput = document.getElementById('CustomDaysTime');
            const selectedWeekdayInputs = document.querySelectorAll('input[name="SelectedWeekdays"]');
            const cronGroup = document.getElementById('cronGroup');
            const reportDefinitionSelect = document.getElementById('ReportDefinitionId');
            const updatePasswordToggle = document.getElementById('updatePasswordToggle');
            const passwordInput = document.getElementById('passwordInput');
            const existingPasswordInput = document.getElementById('existingPasswordInput');
            const toggleExistingPasswordVisibility = document.getElementById('toggleExistingPasswordVisibility');
            const clientCodeHiddenInput = document.getElementById('SchemaTemplate');
            const isCustomToggle = document.getElementById('isCustomToggle');
            const dateFromGroup = document.getElementById('dateFromGroup');
            const dateToGroup = document.getElementById('dateToGroup');
            const dateFromInput = document.getElementById('DateFrom');
            const dateToInput = document.getElementById('DateTo');
            const clientCodeSelect = document.getElementById('scheduled-client-code-select');
            const clientCodeSearchInput = document.getElementById('scheduled-client-code-search');
            const clientCodeDropdownToggle = document.getElementById('scheduled-client-code-dropdown-toggle');
            const clientCodeOptions = document.getElementById('scheduled-client-code-options');
            const clientCodeClearButton = document.getElementById('scheduled-client-code-clear');
            const availableSchemaTemplatesByReportId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AvailableSchemaTemplatesByReportId));
            const parametersHiddenInput = document.getElementById('scheduled-job-parameters');
            const scheduledParametersContainer = document.getElementById('scheduled-parameters-container');
            const scheduledParametersEmpty = document.getElementById('scheduled-parameters-empty');
            const availableParametersByReportId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AvailableParametersByReportId));

            if (!scheduleTypeSelect || !everyMinutesGroup || !dailyTimeGroup || !customDaysGroup || !cronGroup) {
                return;
            }

            function updateScheduleFields() {
                const mode = scheduleTypeSelect.value;
                everyMinutesGroup.style.display = mode === '@ScheduledJobFormViewModel.ScheduleTypeEveryMinutes' ? '' : 'none';
                dailyTimeGroup.style.display = mode === '@ScheduledJobFormViewModel.ScheduleTypeDailyTime' ? '' : 'none';
                customDaysGroup.style.display = mode === '@ScheduledJobFormViewModel.ScheduleTypeCustomDays' ? '' : 'none';
                cronGroup.style.display = mode === '@ScheduledJobFormViewModel.ScheduleTypeAdvancedCron' ? '' : 'none';

                const isCustomDays = mode === '@ScheduledJobFormViewModel.ScheduleTypeCustomDays';
                if (customDaysTimeInput) {
                    customDaysTimeInput.disabled = !isCustomDays;
                    customDaysTimeInput.required = isCustomDays;
                }

                selectedWeekdayInputs.forEach(input => {
                    input.disabled = !isCustomDays;
                    input.required = false;
                });
            }

            function updateJobActionFields() {
                if (!jobActionSelect || !recipientEmailGroup || !recipientEmailInput) {
                    return;
                }

                const requiresEmail = jobActionSelect.value === '@ScheduledJobActions.ExportFileAndEmailToUser';
                recipientEmailGroup.style.display = requiresEmail ? '' : 'none';
                recipientEmailInput.required = requiresEmail;

                if (!requiresEmail) {
                    recipientEmailInput.value = '';
                }
            }

            function updatePasswordFields() {
                if (!passwordInput) {
                    return;
                }

                const isUpdateEnabled = !updatePasswordToggle || updatePasswordToggle.checked;
                passwordInput.disabled = !isUpdateEnabled;
                passwordInput.required = isUpdateEnabled;

                if (!isUpdateEnabled) {
                    passwordInput.value = '';
                }
            }

            function updateDateFields() {
                if (!isCustomToggle) {
                    return;
                }

                const isCustom = isCustomToggle.checked;

                if (dateFromGroup) {
                    dateFromGroup.style.display = isCustom ? '' : 'none';
                }

                if (dateToGroup) {
                    dateToGroup.style.display = isCustom ? '' : 'none';
                }

                if (dateFromInput) {
                    dateFromInput.disabled = !isCustom;
                }

                if (dateToInput) {
                    dateToInput.disabled = !isCustom;
                }
            }

            function updateClientCodeSelectOptions() {
                if (!reportDefinitionSelect || !clientCodeSelect) {
                    return;
                }

                const selectedReportId = parseInt(reportDefinitionSelect.value, 10);
                const reportSchemaTemplates = Number.isFinite(selectedReportId)
                    ? (availableSchemaTemplatesByReportId[selectedReportId] || [])
                    : [];

                const distinctClientCodes = [...new Set(reportSchemaTemplates
                    .map(clientCode => (clientCode || '').trim())
                    .filter(clientCode => clientCode.length > 0)
                    .sort((left, right) => left.localeCompare(right, undefined, { sensitivity: 'accent' })))];

                const currentValue = (clientCodeHiddenInput?.value || '').trim();

                clientCodeSelect.innerHTML = '';
                const defaultOption = document.createElement('option');
                defaultOption.value = '';
                defaultOption.textContent = 'Default';
                clientCodeSelect.appendChild(defaultOption);

                distinctClientCodes.forEach(clientCode => {
                    const option = document.createElement('option');
                    option.value = clientCode;
                    option.textContent = clientCode;
                    clientCodeSelect.appendChild(option);
                });

                if (currentValue && !distinctClientCodes.some(value => value.localeCompare(currentValue, undefined, { sensitivity: 'accent' }) === 0)) {
                    const option = document.createElement('option');
                    option.value = currentValue;
                    option.textContent = currentValue;
                    clientCodeSelect.appendChild(option);
                }

                syncClientCodeUi(currentValue);
            }

            function normalizeParameterName(name) {
                return (name || '').trim().replace(/^@@+/, '');
            }

            function escapeHtmlAttribute(value) {
                return String(value || '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            function parseScheduledJobParameters() {
                const raw = (parametersHiddenInput?.value || '').trim();
                if (!raw) {
                    return [];
                }

                try {
                    const parsed = JSON.parse(raw);
                    if (!Array.isArray(parsed)) {
                        return [];
                    }

                    return parsed
                        .map(item => ({
                            name: normalizeParameterName(item?.name || item?.Name || ''),
                            value: (item?.value || item?.Value || '').toString().trim()
                        }))
                        .filter(item => item.name);
                } catch {
                    return [];
                }
            }

            function getSelectedReportParameters() {
                if (!reportDefinitionSelect) {
                    return [];
                }

                const selectedReportId = parseInt(reportDefinitionSelect.value, 10);
                return Number.isFinite(selectedReportId)
                    ? (availableParametersByReportId[selectedReportId] || [])
                    : [];
            }

            function getScheduledParameterState() {
                const existingValues = new Map(
                    parseScheduledJobParameters().map(item => [normalizeParameterName(item.name), item.value || ''])
                );

                return getSelectedReportParameters()
                    .map(parameter => {
                        const queryKey = normalizeParameterName(parameter.queryKey || parameter.QueryKey || '');
                        if (!queryKey) {
                            return null;
                        }

                        const name = (parameter.name || parameter.Name || '').toString().trim() || `@@${queryKey}`;
                        const defaultValue = (parameter.defaultValue || parameter.DefaultValue || '').toString().trim();
                        const value = existingValues.has(queryKey)
                            ? (existingValues.get(queryKey) || '')
                            : defaultValue;

                        return {
                            queryKey,
                            name,
                            defaultValue,
                            value,
                            isRequired: !!(parameter.isRequired || parameter.IsRequired)
                        };
                    })
                    .filter(Boolean);
            }

            function serializeScheduledJobParameters() {
                if (!parametersHiddenInput || !scheduledParametersContainer) {
                    return;
                }

                const visibleValuesByQueryKey = new Map(
                    [...scheduledParametersContainer.querySelectorAll('[data-scheduled-param-row]')].map(row => {
                        const queryKey = normalizeParameterName(row.getAttribute('data-param-query-key') || '');
                        const input = row.querySelector('input[data-scheduled-param-value]');
                        return [queryKey, (input?.value || '').trim()];
                    })
                );

                const payload = getScheduledParameterState()
                    .map(parameter => ({
                        Name: `@@${parameter.queryKey}`,
                        Value: (visibleValuesByQueryKey.has(parameter.queryKey)
                            ? visibleValuesByQueryKey.get(parameter.queryKey)
                            : parameter.value) || null
                    }))
                    .filter(Boolean);

                parametersHiddenInput.value = payload.length ? JSON.stringify(payload) : '';
            }

            function renderScheduledParameterInputs() {
                if (!reportDefinitionSelect || !scheduledParametersContainer || !scheduledParametersEmpty) {
                    return;
                }

                const reportParameters = getScheduledParameterState();
                const visibleParameters = reportParameters.filter(parameter => !parameter.defaultValue);

                scheduledParametersContainer.querySelectorAll('[data-scheduled-param-row]').forEach(row => row.remove());

                if (!Array.isArray(reportParameters) || reportParameters.length === 0) {
                    scheduledParametersEmpty.textContent = 'No parameters for the selected report.';
                    scheduledParametersEmpty.style.display = 'block';
                    if (parametersHiddenInput) {
                        parametersHiddenInput.value = '';
                    }
                    return;
                }

                if (visibleParameters.length === 0) {
                    scheduledParametersEmpty.textContent = 'All parameters for the selected report already have default values.';
                    scheduledParametersEmpty.style.display = 'block';
                    serializeScheduledJobParameters();
                    return;
                }

                scheduledParametersEmpty.style.display = 'none';

                visibleParameters.forEach(parameter => {
                    const labelText = parameter.isRequired ? `${parameter.name} *` : parameter.name;
                    const placeholder = parameter.isRequired ? 'Required' : 'Optional';

                    const row = document.createElement('div');
                    row.className = 'row g-2 align-items-center mb-2';
                    row.setAttribute('data-scheduled-param-row', 'true');
                    row.setAttribute('data-param-query-key', parameter.queryKey);
                    row.innerHTML = `
                        <div class="col-md-4">
                            <span class="bg-secondary-subtle text-secondary-emphasis border">${labelText}</span>
                        </div>
                        <div class="col-md-8">
                            <input type="text" class="form-control form-control-sm" data-scheduled-param-value="true" placeholder="${placeholder}" value="${escapeHtmlAttribute(parameter.value)}" />
                        </div>`;

                    scheduledParametersContainer.appendChild(row);
                });

                serializeScheduledJobParameters();
            }

            function syncClientCodeUi(value) {
                if (!clientCodeHiddenInput || !clientCodeSelect || !clientCodeDropdownToggle) {
                    return;
                }

                const normalizedValue = (value || '').trim();
                clientCodeHiddenInput.value = normalizedValue;
                clientCodeSelect.value = normalizedValue;
                clientCodeDropdownToggle.textContent = normalizedValue || 'Default';
                renderClientCodeOptions(clientCodeSearchInput?.value || '');
            }

            function renderClientCodeOptions(searchValue) {
                if (!clientCodeOptions || !clientCodeSelect) {
                    return;
                }

                const normalizedSearch = (searchValue || '').trim().toLocaleLowerCase();
                const selectedValue = clientCodeSelect.value;
                clientCodeOptions.innerHTML = '';

                [...clientCodeSelect.options].forEach((option, index) => {
                    const isDefault = index === 0;
                    const isMatch = !normalizedSearch || option.text.toLocaleLowerCase().includes(normalizedSearch);
                    const isSelected = option.value.localeCompare(selectedValue, undefined, { sensitivity: 'accent' }) === 0;
                    if (!(isDefault || isMatch || isSelected)) {
                        return;
                    }

                    const optionButton = document.createElement('button');
                    optionButton.type = 'button';
                    optionButton.className = `list-group-item list-group-item-action py-1 px-2${isSelected ? ' active' : ''}`;
                    optionButton.textContent = option.text;
                    optionButton.addEventListener('click', () => {
                        syncClientCodeUi(option.value);
                    });
                    clientCodeOptions.appendChild(optionButton);
                });

                if (!clientCodeOptions.children.length) {
                    const empty = document.createElement('div');
                    empty.className = 'text-muted small px-2 py-1';
                    empty.textContent = 'No matches';
                    clientCodeOptions.appendChild(empty);
                }
            }

            scheduleTypeSelect.addEventListener('change', updateScheduleFields);

            if (jobActionSelect) {
                jobActionSelect.addEventListener('change', updateJobActionFields);
            }

            if (clientCodeSearchInput) {
                clientCodeSearchInput.addEventListener('input', event => {
                    const searchValue = event.target instanceof HTMLInputElement ? event.target.value : '';
                    renderClientCodeOptions(searchValue);
                });
            }

            if (clientCodeClearButton) {
                clientCodeClearButton.addEventListener('click', () => {
                    syncClientCodeUi('');
                });
            }

            if (reportDefinitionSelect) {
                reportDefinitionSelect.addEventListener('change', () => {
                    updateClientCodeSelectOptions();
                    renderScheduledParameterInputs();
                });
            }

            if (scheduledParametersContainer) {
                scheduledParametersContainer.addEventListener('input', event => {
                    if (event.target instanceof HTMLInputElement && event.target.matches('[data-scheduled-param-value]')) {
                        serializeScheduledJobParameters();
                    }
                });
            }

            if (updatePasswordToggle) {
                updatePasswordToggle.addEventListener('change', () => {
                    updatePasswordFields();
                });
            }

            if (toggleExistingPasswordVisibility && existingPasswordInput) {
                toggleExistingPasswordVisibility.addEventListener('click', () => {
                    const isHidden = existingPasswordInput.type === 'password';
                    existingPasswordInput.type = isHidden ? 'text' : 'password';
                    toggleExistingPasswordVisibility.textContent = isHidden ? 'Hide' : 'Show';
                });
            }

            if (isCustomToggle) {
                isCustomToggle.addEventListener('change', updateDateFields);
            }

            updateScheduleFields();
            updateJobActionFields();
            updateClientCodeSelectOptions();
            renderScheduledParameterInputs();
            updatePasswordFields();
            updateDateFields();
        })();
    </script>
}
