@model DataWarehousePower.Models.ScheduledJobListViewModel
@{
    ViewData["Title"] = "Scheduled Jobs";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Scheduled Export Jobs</h4>
    <a asp-action="Create" class="btn btn-primary btn-sm">+ New Scheduled Job</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Jobs.Any())
{
    <div class="alert alert-info">No scheduled jobs found. Click <strong>+ New Scheduled Job</strong> to create one.</div>
}
else
{
    <div class="table-responsive shadow-sm">
        <table class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th style="width: 50px;">#</th>
                    <th>Job Name</th>
                    <th>Report</th>
                    <th>Format</th>
                    <th>Schedule</th>
                    <th style="width: 100px;" class="text-center">Active</th>
                    <th style="width: 170px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (ScheduledJobListItemViewModel job in Model.Jobs)
                {
                    <tr class="@(job.IsActive ? string.Empty : "table-secondary text-muted")">
                        <td class="text-muted small">@job.Id</td>
                        <td>
                            <div class="fw-semibold">@job.JobName</div>
                            <div class="small text-muted">@job.HangfireJobId</div>
                        </td>
                        <td>@job.ReportName</td>
                        <td class="text-uppercase">@job.Format</td>
                        <td>
                            <div>@job.ScheduleDisplay</div>
                            <div class="small text-muted"><code>@job.CronExpression</code></div>
                        </td>
                        <td class="text-center">
                            <form asp-action="ToggleActive" asp-route-id="@job.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(job.IsActive ? "btn-success" : "btn-outline-secondary")">
                                    @(job.IsActive ? "Active" : "Inactive")
                                </button>
                            </form>
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@job.Id" class="btn btn-outline-primary btn-sm me-1">Edit</a>
                            <form asp-action="Delete" asp-route-id="@job.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Delete scheduled job &quot;@job.JobName&quot;?');">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="small text-muted mt-3">
    Schedules are interpreted in UTC+8 timezone.
</div>
