@model DataWarehousePower.Models.ScheduledJobListViewModel
@{
    ViewData["Title"] = "Scheduled Jobs";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Scheduled Export Jobs</h4>
    <a asp-action="Create" class="btn btn-primary btn-sm">+ New Scheduled Job</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card mb-3 shadow-sm">
    <div class="card-body pb-2">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-sm-6 col-md-3">
                <label class="form-label small mb-1">Job Name</label>
                <input type="text" name="JobName" value="@Model.Filter.JobName" class="form-control form-control-sm" placeholder="Search job name…" />
            </div>
            <div class="col-sm-6 col-md-3">
                <label class="form-label small mb-1">Report</label>
                <input type="text" name="ReportName" value="@Model.Filter.ReportName" class="form-control form-control-sm" placeholder="Search report…" />
            </div>
            <div class="col-sm-4 col-md-2">
                <label class="form-label small mb-1">Format</label>
                <select name="Format" class="form-select form-select-sm">
                    <option value="">All</option>
                    @foreach (string fmt in Model.AvailableFormats)
                    {
                        <option value="@fmt" selected="@(Model.Filter.Format == fmt ? "selected" : null)">@fmt.ToUpperInvariant()</option>
                    }
                </select>
            </div>
            <div class="col-sm-4 col-md-2">
                <label class="form-label small mb-1">Client Code</label>
                <input type="hidden" name="ClientCode" id="scheduled-job-client-code-value" value="@Model.Filter.ClientCode" />
                <div class="dropdown w-100">
                    <button id="scheduled-job-client-code-toggle"
                            class="btn btn-sm btn-outline-secondary dropdown-toggle w-100 text-start"
                            type="button"
                            data-bs-toggle="dropdown"
                            data-bs-auto-close="outside"
                            aria-expanded="false">
                        @(string.IsNullOrWhiteSpace(Model.Filter.ClientCode) ? "All" : Model.Filter.ClientCode)
                    </button>
                    <div class="dropdown-menu p-2 w-100" style="min-width: 240px;">
                        <input id="scheduled-job-client-code-search"
                               type="text"
                               class="form-control form-control-sm mb-2"
                               maxlength="128"
                               placeholder="Search client code"
                               autocomplete="off" />
                        <div id="scheduled-job-client-code-options" class="list-group list-group-flush" style="max-height: 220px; overflow-y: auto;"></div>
                    </div>
                </div>
            </div>
            <div class="col-sm-4 col-md-2">
                <label class="form-label small mb-1">Filter Client Code</label>
                <input type="hidden" name="FilterClientCode" id="scheduled-job-filter-client-code-value" value="@Model.Filter.FilterClientCode" />
                <div class="dropdown w-100">
                    <button id="scheduled-job-filter-client-code-toggle"
                            class="btn btn-sm btn-outline-secondary dropdown-toggle w-100 text-start"
                            type="button"
                            data-bs-toggle="dropdown"
                            data-bs-auto-close="outside"
                            aria-expanded="false">
                        @(string.IsNullOrWhiteSpace(Model.Filter.FilterClientCode) ? "All" : Model.Filter.FilterClientCode)
                    </button>
                    <div class="dropdown-menu p-2 w-100" style="min-width: 240px;">
                        <input id="scheduled-job-filter-client-code-search"
                               type="text"
                               class="form-control form-control-sm mb-2"
                               maxlength="128"
                               placeholder="Search client code"
                               autocomplete="off" />
                        <div id="scheduled-job-filter-client-code-options" class="list-group list-group-flush" style="max-height: 220px; overflow-y: auto;"></div>
                    </div>
                </div>
            </div>
            <div class="col-sm-4 col-md-2">
                <label class="form-label small mb-1">Status</label>
                <select name="IsActive" class="form-select form-select-sm">
                    <option value="">All</option>
                    <option value="true" selected="@(Model.Filter.IsActive == true ? "selected" : null)">Active</option>
                    <option value="false" selected="@(Model.Filter.IsActive == false ? "selected" : null)">Inactive</option>
                </select>
            </div>
            <div class="col-auto d-flex gap-1">
                <button type="submit" class="btn btn-secondary btn-sm">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Clear</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            function createSearchableDropdown(config) {
                const hiddenInput = document.getElementById(config.hiddenInputId);
                const toggleButton = document.getElementById(config.toggleButtonId);
                const searchInput = document.getElementById(config.searchInputId);
                const optionsContainer = document.getElementById(config.optionsContainerId);

                if (!hiddenInput || !toggleButton || !searchInput || !optionsContainer) {
                    return;
                }

                const items = config.items.map(item => (item || '').trim()).filter(item => item.length > 0);

                function setValue(value) {
                    const normalizedValue = (value || '').trim();
                    hiddenInput.value = normalizedValue;
                    toggleButton.textContent = normalizedValue || 'All';
                    render(searchInput.value);
                }

                function render(searchValue) {
                    const normalizedSearch = (searchValue || '').trim().toLowerCase();
                    const selectedValue = hiddenInput.value.trim();

                    optionsContainer.innerHTML = '';

                    const visibleItems = items.filter(item => !normalizedSearch || item.toLowerCase().includes(normalizedSearch));
                    const currentSelection = visibleItems.some(item => item.localeCompare(selectedValue, undefined, { sensitivity: 'accent' }) === 0);

                    if (!selectedValue || !currentSelection) {
                        visibleItems.unshift('');
                    }

                    visibleItems.forEach(item => {
                        const button = document.createElement('button');
                        button.type = 'button';
                        button.className = `list-group-item list-group-item-action py-1 px-2${item && item.localeCompare(selectedValue, undefined, { sensitivity: 'accent' }) === 0 ? ' active' : ''}`;
                        button.textContent = item || 'All';
                        button.addEventListener('click', () => setValue(item));
                        optionsContainer.appendChild(button);
                    });

                    if (!optionsContainer.children.length) {
                        const empty = document.createElement('div');
                        empty.className = 'text-muted small px-2 py-1';
                        empty.textContent = 'No matches';
                        optionsContainer.appendChild(empty);
                    }
                }

                searchInput.addEventListener('input', event => {
                    const target = event.target;
                    render(target instanceof HTMLInputElement ? target.value : '');
                });

                render('');
                setValue(hiddenInput.value);
            }

            createSearchableDropdown({
                hiddenInputId: 'scheduled-job-client-code-value',
                toggleButtonId: 'scheduled-job-client-code-toggle',
                searchInputId: 'scheduled-job-client-code-search',
                optionsContainerId: 'scheduled-job-client-code-options',
                items: [@foreach (string cc in Model.AvailableClientCodes) { <text>'@cc',</text> }]
            });

            createSearchableDropdown({
                hiddenInputId: 'scheduled-job-filter-client-code-value',
                toggleButtonId: 'scheduled-job-filter-client-code-toggle',
                searchInputId: 'scheduled-job-filter-client-code-search',
                optionsContainerId: 'scheduled-job-filter-client-code-options',
                items: [@foreach (string fcc in Model.AvailableFilterClientCodes) { <text>'@fcc',</text> }]
            });
        })();
    </script>
}

@if (!Model.Jobs.Any())
{
    <div class="alert alert-info">No scheduled jobs found. Click <strong>+ New Scheduled Job</strong> to create one.</div>
}
else
{
    <div class="table-responsive shadow-sm">
        <table class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th style="width: 50px;">#</th>
                    <th>Job Name</th>
                    <th>Report</th>
                    <th>Format</th>
                    <th>Schema Template</th>
                    <th>Filter Client Code</th>
                    <th>Schedule</th>
                    <th style="width: 100px;" class="text-center">Active</th>
                    <th style="width: 170px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (ScheduledJobListItemViewModel job in Model.Jobs)
                {
                    <tr class="@(job.IsActive ? string.Empty : "table-secondary text-muted")">
                        <td class="text-muted small">@job.Id</td>
                        <td>
                            <div class="fw-semibold">@job.JobName</div>
                            <div class="small text-muted">@job.HangfireJobId</div>
                        </td>
                        <td>@job.ReportName</td>
                        <td class="text-uppercase">@job.Format</td>
                        <td>@(string.IsNullOrWhiteSpace(job.ClientCode) ? "-" : job.ClientCode)</td>
                        <td>@(string.IsNullOrWhiteSpace(job.FilterClientCode) ? "-" : job.FilterClientCode)</td>
                        <td>
                            <div>@job.ScheduleDisplay</div>
                            <div class="small text-muted"><code>@job.CronExpression</code></div>
                        </td>
                        <td class="text-center">
                            <form asp-action="ToggleActive" asp-route-id="@job.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(job.IsActive ? "btn-success" : "btn-outline-secondary")">
                                    @(job.IsActive ? "Active" : "Inactive")
                                </button>
                            </form>
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@job.Id" class="btn btn-outline-primary btn-sm me-1">Edit</a>
                            <form asp-action="Delete" asp-route-id="@job.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Delete scheduled job &quot;@job.JobName&quot;?');">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="small text-muted mt-3">
    Schedules are interpreted in UTC+8 timezone.
</div>
