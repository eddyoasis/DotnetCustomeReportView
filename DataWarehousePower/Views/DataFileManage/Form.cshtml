        function renderBooleanMappingEditor(mappingCell, mappingInput) {
            const editor = mappingCell.querySelector('.mapping-parameter-editor');
            if (!editor) {
                return;
            }

            editor.innerHTML = '';

            const wrapper = document.createElement('div');

