        function getDropdownDisplayText(placeholder, value) {
            const trimmed = (value || '').trim();
            return trimmed ? trimmed : placeholder;
        }

        function createDropdownOption(value, text) {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'dropdown-item dropdown-option';
            button.dataset.value = value;
            button.textContent = text;
            return button;
        }

        function setDropdownItems(state, items) {
            state.options = [
                { value: '', text: state.placeholder },
                ...items.map(item => ({ value: item, text: item }))
            ];

            state.optionsContainer.innerHTML = '';
            state.options.forEach(option => {
                state.optionsContainer.appendChild(createDropdownOption(option.value, option.text));
            });

            filterDropdownOptions(state);
        }

        function filterDropdownOptions(state) {
            const keyword = (state.searchInput.value || '').trim().toLowerCase();
            let visibleCount = 0;

            state.optionsContainer.querySelectorAll('.dropdown-option').forEach(optionButton => {
                const value = optionButton.dataset.value || '';
                const text = optionButton.textContent || '';
                const isPlaceholder = value === '';
                const isVisible =
                    isPlaceholder ||
                    keyword === '' ||
                    text.toLowerCase().includes(keyword) ||
                    value.toLowerCase().includes(keyword);

                optionButton.classList.toggle('d-none', !isVisible);
                if (isVisible) {
                    visibleCount++;
                }
            });

            if (!state.noResultElement) {
                state.noResultElement = document.createElement('div');
                state.noResultElement.className = 'dropdown-item-text text-muted small py-2 no-results';
                state.noResultElement.textContent = 'No matches found';
                state.optionsContainer.appendChild(state.noResultElement);
            }

            state.noResultElement.classList.toggle('d-none', visibleCount > 0);
        }

        function updateDropdownSelection(state, value, triggerChange) {
            const normalizedValue = (value || '').trim();
            state.hiddenInput.value = normalizedValue;
            state.toggleButton.textContent = getDropdownDisplayText(state.placeholder, normalizedValue);

            state.optionsContainer.querySelectorAll('.dropdown-option').forEach(optionButton => {
                const selected = (optionButton.dataset.value || '') === normalizedValue;
                optionButton.classList.toggle('active', selected);
            });

            if (triggerChange) {
                state.hiddenInput.dispatchEvent(new Event('change', { bubbles: true }));
            }
        }

        function initializeSearchableDropdown(config) {
            const state = {
                hiddenInput: config.hiddenInput,
                toggleButton: config.toggleButton,
                optionsContainer: config.optionsContainer,
                searchInput: config.searchInput,
                placeholder: config.placeholder,
                options: [],
                noResultElement: null
            };

            searchableDropdownStates.set(config.hiddenInput.id, state);

            const initialItems = Array.from(config.optionsContainer.querySelectorAll('.dropdown-option'))
                .map(btn => ({
                    value: btn.dataset.value || '',
                    text: btn.textContent || ''
                }))
                .filter(option => option.value !== '');

            setDropdownItems(state, initialItems.map(option => option.value));
            updateDropdownSelection(state, config.hiddenInput.value, false);

            config.searchInput.addEventListener('input', () => {
                filterDropdownOptions(state);
            });

            config.optionsContainer.addEventListener('click', e => {
                const optionButton = e.target.closest('.dropdown-option');
                if (!optionButton || optionButton.classList.contains('d-none')) return;

                updateDropdownSelection(state, optionButton.dataset.value || '', true);
                config.searchInput.value = '';
                filterDropdownOptions(state);

                const dropdown = bootstrap.Dropdown.getOrCreateInstance(config.toggleButton);
                dropdown.hide();
            });

            config.toggleButton.addEventListener('shown.bs.dropdown', () => {
                config.searchInput.value = '';
                filterDropdownOptions(state);
                config.searchInput.focus();
            });

            return state;
        }

        function setDropdownItemsByInputId(inputId, items, preferredValue) {
            const state = searchableDropdownStates.get(inputId);
            if (!state) return;

            setDropdownItems(state, items);
            const nextValue = items.includes((preferredValue || '').trim()) ? (preferredValue || '').trim() : '';
            updateDropdownSelection(state, nextValue, false);
        }

        function resetDropdownSelectionByInputId(inputId) {
            const state = searchableDropdownStates.get(inputId);
            if (!state) return;

            updateDropdownSelection(state, '', false);
            state.searchInput.value = '';
            filterDropdownOptions(state);
        }

        function toDefaultLabel(columnName) {
            return (columnName || '')
                .replace(/_/g, ' ')
                .replace(/([a-z0-9])([A-Z])/g, '$1 $2')
                .trim()
                .replace(/\s+/g, ' ')
                .replace(/\b\w/g, c => c.toUpperCase());
        }

        function markAllRowsAsDeleted() {
            document.querySelectorAll('#columns-body tr.col-row:not(.deleted-row)').forEach(tr => {
                const deletedInput = tr.querySelector('.is-deleted-input');
                if (deletedInput) {
                    deletedInput.value = 'true';
                }
                tr.querySelectorAll('input[required]').forEach(i => i.removeAttribute('required'));
                tr.classList.add('deleted-row');
                tr.style.display = 'none';
                syncRowDragHandleState(tr);
            });
        }

        const columnsBody = document.getElementById('columns-body');
        let draggedRow = null;

        function isRowReorderable(tr) {
            return !!tr &&
                tr.classList.contains('col-row') &&
                !tr.classList.contains('deleted-row') &&
                !tr.classList.contains('disabled-row');
        }

        columnsBody.addEventListener('dragstart', e => {
            const handle = e.target.closest('.drag-handle');
            if (!handle) {
                return;
            }

            const tr = handle.closest('tr.col-row');
            if (!isRowReorderable(tr)) {
                e.preventDefault();
                return;
            }

            draggedRow = tr;
            draggedRow.classList.add('table-warning');

            if (e.dataTransfer) {
                e.dataTransfer.effectAllowed = 'move';
                e.dataTransfer.setData('text/plain', tr.dataset.index || '');
            }
        });

        columnsBody.addEventListener('dragover', e => {
            if (!draggedRow) {
                return;
            }

            const targetRow = e.target.closest('tr.col-row');
            if (!isRowReorderable(targetRow) || targetRow === draggedRow) {
                return;
            }

            e.preventDefault();

            const rect = targetRow.getBoundingClientRect();
            const placeAfter = e.clientY > (rect.top + rect.height / 2);

            if (placeAfter) {
                if (targetRow.nextSibling !== draggedRow) {
                    columnsBody.insertBefore(draggedRow, targetRow.nextSibling);
                }
            } else if (draggedRow !== targetRow.previousSibling) {
                columnsBody.insertBefore(draggedRow, targetRow);
            }
        });

        columnsBody.addEventListener('drop', e => {
            if (!draggedRow) {
                return;
            }

            e.preventDefault();
            refreshRowNumbers();
        });

        columnsBody.addEventListener('dragend', () => {
            if (!draggedRow) {
                return;
            }

            draggedRow.classList.remove('table-warning');
            draggedRow = null;
            refreshRowNumbers();
        });

        function normalizeParameterName(name) {
            return (name || '').trim().replace(/^@@+/, '');
        }

        function normalizeMappingAlias(name) {
            const normalized = normalizeParameterName(name || '');
            if (!normalized) {
                return '';
            }
            if (normalized.toLowerCase() === 'datefrom') {
                return 'FilterDateFrom';
            }
            if (normalized.toLowerCase() === 'dateto') {
                return 'FilterDateTo';
            }
            if (normalized.toLowerCase() === 'filterclientcode') {
                return 'ClientCode';
            }
            return normalized;
        }

        function splitMappingAliases(value) {
            return (value || '')
                .split(/[,;|]/)
                .map(token => normalizeMappingAlias(token))
                .filter(Boolean);
        }

        function escapeHtmlAttribute(value) {
            return String(value || '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function buildParameterMappingOptions(selectedValue) {
            const normalized = normalizeParameterName(selectedValue || '');
            const allowedValues = ['ClientCode', 'FilterDateFrom', 'FilterDateTo'];
            return [
                `<option value="">-- None --</option>`,
                ...allowedValues.map(value => {
                    const selected = normalized === value ? ' selected' : '';
                    return `<option value="${value}"${selected}>${value}</option>`;
                })
            ].join('');
        }

        function getVisibleParameterMappingSelects() {
            return [...document.querySelectorAll('#source-parameters-list [data-param-row] select[data-param-mapping]')];
        }

        function parseConfiguredParameters() {
            const raw = (parametersInput.value || '').trim();
            if (!raw) {
                return [];
            }

            try {
                const parsed = JSON.parse(raw);
                if (!Array.isArray(parsed)) {
                    return [];
                }

                return parsed
                    .map(item => ({
                        name: normalizeParameterName(item?.name || item?.Name || ''),
                        defaultValue: (item?.defaultValue || item?.DefaultValue || '').toString().trim(),
                        mappingParameter: normalizeParameterName(item?.mappingParameter || item?.MappingParameter || '')
                    }))
                    .filter(item => item.name);
            } catch {
                return [];
            }
        }

        function serializeParametersFromUi() {
            const rows = [...sourceParametersList.querySelectorAll('[data-param-row]')];
            const payload = rows
                .map(row => {
                    const name = normalizeParameterName(row.getAttribute('data-param-name') || '');
                    const defaultInput = row.querySelector('input[data-param-default]');
                    const mappingInput = row.querySelector('select[data-param-mapping]');
                    const defaultValue = (defaultInput?.value || '').trim();
                    const mappingParameter = normalizeParameterName(mappingInput?.value || '');
                    return name
                        ? {
                            Name: `@@${name}`,
                            DefaultValue: defaultValue || null,
                            MappingParameter: mappingParameter || null
                        }
                        : null;
                })
                .filter(Boolean);

            parametersInput.value = payload.length ? JSON.stringify(payload) : '';
        }

        function renderSourceParameters(parameterNames, existingDefaults) {
            sourceParametersList.querySelectorAll('[data-param-row]').forEach(item => item.remove());

            const defaultsByName = new Map(
                existingDefaults.map(item => [
                    normalizeParameterName(item.name),
                    {
                        defaultValue: item.defaultValue || '',
                        mappingParameter: normalizeParameterName(item.mappingParameter || '')
                    }
                ])
            );

            const uniqueNames = [...new Set((parameterNames || []).map(name => normalizeParameterName(name)).filter(Boolean))];

            if (uniqueNames.length === 0) {
                sourceParametersEmpty.style.display = 'block';
                parametersInput.value = '';
                return;
            }

            sourceParametersEmpty.style.display = 'none';
            uniqueNames.forEach(name => {
                const row = document.createElement('div');
                row.className = 'row g-2 align-items-center mb-2';
                row.setAttribute('data-param-row', 'true');
                row.setAttribute('data-param-name', name);

                const configured = defaultsByName.get(name) || { defaultValue: '', mappingParameter: '' };
                const defaultValue = configured.defaultValue;
                const mappingParameter = configured.mappingParameter;
                row.innerHTML = `
                    <div class="col-md-4">
                        <span class="bg-secondary-subtle text-secondary-emphasis border">@@${name}</span>
                    </div>
                    <div class="col-md-4">
                        <input type="text" class="form-control form-control-sm" data-param-default="true" value="${escapeHtmlAttribute(defaultValue)}" placeholder="Default value (optional)" />
                    </div>
                    <div class="col-md-4">
                        <select class="form-select form-select-sm" data-param-mapping="true">
                            ${buildParameterMappingOptions(mappingParameter)}
                        </select>
                    </div>`;

                sourceParametersList.appendChild(row);
            });

            serializeParametersFromUi();
        }

        async function loadSourceParameters() {
            const requestSeq = ++sourceParametersRequestSeq;
            const dbName = (databaseInput.value || '').trim();
            const sourceSP = (spInput.value || '').trim();

            if (!dbName || !sourceSP) {
                renderSourceParameters([], []);
                return;
            }

            const existingDefaults = parseConfiguredParameters();

            try {
                const response = await fetch(
                    `${sourceParametersUrl}?sourceDatabase=${encodeURIComponent(dbName)}&sourceTable=&sourceSP=${encodeURIComponent(sourceSP)}`,
                    { cache: 'no-store' }
                );

                if (!response.ok) {
                    throw new Error('Failed to load source parameters');
                }

                const items = await response.json();
                if (requestSeq !== sourceParametersRequestSeq) {
                    return;
                }

                renderSourceParameters(Array.isArray(items) ? items : [], existingDefaults);
            } catch {
                if (requestSeq !== sourceParametersRequestSeq) {
                    return;
                }
                renderSourceParameters([], existingDefaults);
            }
        }

        async function loadSourceObjects(selectedValue) {
            const requestSeq = ++sourceObjectsRequestSeq;
            const dbName = (databaseInput.value || '').trim();

            if (!dbName) {
                tableInput.value = '';
                setDropdownItemsByInputId('input-source-table', [], '');
                return;
            }

            try {
                const response = await fetch(`${sourceObjectsUrl}?sourceDatabase=${encodeURIComponent(dbName)}`, { cache: 'no-store' });
                if (!response.ok) throw new Error('Failed to load source objects');

                const items = await response.json();
                if (requestSeq !== sourceObjectsRequestSeq) return;
                setDropdownItemsByInputId('input-source-table', items, selectedValue || '');
            } catch {
                if (requestSeq !== sourceObjectsRequestSeq) return;
                tableInput.value = '';
                setDropdownItemsByInputId('input-source-table', [], '');
            }
        }

        async function loadSourceProcedures(selectedValue) {
            const requestSeq = ++sourceProceduresRequestSeq;
            const dbName = (databaseInput.value || '').trim();

            if (!dbName) {
                spInput.value = '';
                setDropdownItemsByInputId('input-source-sp', [], '');
                return;
            }

            try {
                const response = await fetch(`${sourceProceduresUrl}?sourceDatabase=${encodeURIComponent(dbName)}`, { cache: 'no-store' });
                if (!response.ok) throw new Error('Failed to load stored procedures');

                const items = await response.json();
                if (requestSeq !== sourceProceduresRequestSeq) return;
                setDropdownItemsByInputId('input-source-sp', items, selectedValue || '');
            } catch {
                if (requestSeq !== sourceProceduresRequestSeq) return;
                spInput.value = '';
                setDropdownItemsByInputId('input-source-sp', [], '');
            }
        }

        function normalizeSourceColumnMetadata(items) {
            if (!Array.isArray(items)) {
                return [];
            }

            return items
                .map(item => {
                    if (typeof item === 'string') {
                        return { name: item, dataType: '' };
                    }

                    return {
                        name: (item?.name || item?.Name || '').toString().trim(),
                        dataType: (item?.dataType || item?.DataType || '').toString().trim()
                    };
                })
                .filter(item => item.name);
        }

        async function loadSourceColumnMetadata() {
            const requestSeq = ++sourceColumnMetadataRequestSeq;
            const dbName = (databaseInput.value || '').trim();
            const sourceTable = (tableInput.value || '').trim();
            const sourceSP = (spInput.value || '').trim();

            if (!dbName || ((!sourceTable && !sourceSP) || (sourceTable && sourceSP))) {
                sourceColumnTypeLookup = new Map();
                refreshMappingParameterInputTypes();
                return [];
            }

            try {
                const response = await fetch(
                    `${sourceColumnMetadataUrl}?sourceDatabase=${encodeURIComponent(dbName)}&sourceTable=${encodeURIComponent(sourceTable)}&sourceSP=${encodeURIComponent(sourceSP)}`,
                    { cache: 'no-store' }
                );
                if (!response.ok) {
                    throw new Error('Failed to load source column metadata');
                }

                const payload = await response.json();
                if (requestSeq !== sourceColumnMetadataRequestSeq) {
                    return [];
                }

                const metadataItems = normalizeSourceColumnMetadata(payload);
                sourceColumnTypeLookup = new Map(
                    metadataItems.map(item => [item.name.toLowerCase(), item.dataType || ''])
                );
                refreshMappingParameterInputTypes();
                return metadataItems;
            } catch {
                if (requestSeq !== sourceColumnMetadataRequestSeq) {
                    return [];
                }

                sourceColumnTypeLookup = new Map();
                refreshMappingParameterInputTypes();
                return [];
            }
        }

        function getVisibleColumnRowsForPreview() {
            return [...document.querySelectorAll('#columns-body tr.col-row:not(.deleted-row):not(.disabled-row)')]
                .map(tr => {
                    const propertyInput = tr.querySelector('input[name$=".PropertyName"]');
                    const defaultLabelInput = tr.querySelector('input[name$=".DefaultLabel"]');
                    const mappingInput = tr.querySelector('input[name$=".MappingParameter"]');
                    return {
                        propertyName: (propertyInput?.value || '').trim(),
                        defaultLabel: (defaultLabelInput?.value || '').trim(),
                        mappingParameter: (mappingInput?.value || '').trim()
                    };
                })
                .filter(item => item.propertyName);
        }

        function setPreviewStatus(message, isError) {
            const status = document.getElementById('preview-status');
            status.textContent = message;
            status.classList.toggle('text-danger', !!isError);
            status.classList.toggle('text-muted', !isError);
        }

        function clearPreviewTable() {
            document.getElementById('preview-table-head').innerHTML = '';
            document.getElementById('preview-table-body').innerHTML = '';
            document.getElementById('preview-table-wrap').style.display = 'none';
        }

        function renderPreviewTable(columnDefinitions, rows) {
            const head = document.getElementById('preview-table-head');
            const body = document.getElementById('preview-table-body');
            const wrap = document.getElementById('preview-table-wrap');

            head.innerHTML = '';
            body.innerHTML = '';

            if (!Array.isArray(columnDefinitions) || columnDefinitions.length === 0) {
                wrap.style.display = 'none';
                return;
            }

            const headRow = document.createElement('tr');
            columnDefinitions.forEach(column => {
                const th = document.createElement('th');
                th.textContent = column.label;
                headRow.appendChild(th);
            });
            head.appendChild(headRow);

            (Array.isArray(rows) ? rows : []).forEach(row => {
                const tr = document.createElement('tr');
                columnDefinitions.forEach(column => {
                    const td = document.createElement('td');
                    const value = row?.[column.key];
                    td.textContent = value === null || value === undefined ? '' : String(value);
                    tr.appendChild(td);
                });
                body.appendChild(tr);
            });

            wrap.style.display = 'block';
        }

        async function previewData() {
            const dbName = (databaseInput.value || '').trim();
            const sourceTable = (tableInput.value || '').trim();
            const sourceSP = (spInput.value || '').trim();
            const take = Number.parseInt(document.getElementById('preview-take').value, 10) || 10;
            const columns = getVisibleColumnRowsForPreview();

            if (!dbName || ((!sourceTable && !sourceSP) || (sourceTable && sourceSP))) {
                setPreviewStatus('Please select one source (table or stored procedure) before preview.', true);
                clearPreviewTable();
                return;
            }

            if (columns.length === 0) {
                setPreviewStatus('Please add at least one visible column before preview.', true);
                clearPreviewTable();
                return;
            }

            setPreviewStatus('Loading preview...', false);

            const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            try {
                const response = await fetch(previewUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': antiForgeryToken
                    },
                    body: JSON.stringify({
                        sourceDatabase: dbName,
                        sourceTable,
                        sourceSP,
                        take,
                        columns
                    })
                });

                const payload = await response.json().catch(() => ({}));
                if (!response.ok) {
                    setPreviewStatus(payload?.message || 'Failed to load preview data.', true);
                    clearPreviewTable();
                    return;
                }

                const previewColumns = Array.isArray(payload?.columns) ? payload.columns : [];
                const previewRows = Array.isArray(payload?.rows) ? payload.rows : [];
                const totalCount = Number.isFinite(Number(payload?.count))
                    ? Number(payload.count)
                    : previewRows.length;
                const labelLookup = new Map(
                    columns
                        .filter(column => (column.propertyName || '').trim())
                        .map(column => [
                            column.propertyName.trim().toLowerCase(),
                            (column.defaultLabel || '').trim() || column.propertyName.trim()
                        ])
                );

                const previewColumnDefinitions = previewColumns.map(columnName => {
                    const key = (columnName || '').toString();
                    const label = labelLookup.get(key.trim().toLowerCase()) || key;
                    return { key, label };
                });

                renderPreviewTable(previewColumnDefinitions, previewRows);
                setPreviewStatus(`Showing ${previewRows.length} of ${totalCount} row(s).`, false);
            } catch {
                setPreviewStatus('Failed to load preview data.', true);
                clearPreviewTable();
            }
        }

        async function autoGenerateColumnsFromSource() {
            const dbName = (databaseInput.value || '').trim();
            const sourceTable = (tableInput.value || '').trim();
            const sourceSP = (spInput.value || '').trim();

            if (!dbName || ((!sourceTable && !sourceSP) || (sourceTable && sourceSP))) {
                return;
            }

            const visibleRows = document.querySelectorAll('#columns-body tr.col-row:not(.deleted-row):not(.disabled-row)').length;
            if (visibleRows > 0) {
                const shouldReplace = confirm('Auto-generate will replace current visible column rows. Continue?');
                if (!shouldReplace) return;
            }

            try {
                const metadataItems = await loadSourceColumnMetadata();
                if (!Array.isArray(metadataItems) || metadataItems.length === 0) {
                    alert('No columns were found for the selected source.');
                    return;
                }

                markAllRowsAsDeleted();

                metadataItems.forEach((column, index) => {
                    const name = column.name;
                    const dataType = column.dataType;
                    addColumnRow({
                        propertyName: name,
                        defaultLabel: toDefaultLabel(name),
                        displayOrder: index + 1,
                        columnType: dataType
                    });
                });

                refreshRowNumbers();
                toggleNoColsMessage();
                refreshMappingParameterInputTypes();
            } catch {
                alert('Failed to auto-generate columns from the selected source.');
            }
        }

        async function syncMissingColumnsFromSource() {
            const metadataItems = await loadSourceColumnMetadata();
            if (!Array.isArray(metadataItems) || metadataItems.length === 0) {
                return;
            }

            const existingNames = new Set(
                [...document.querySelectorAll('#columns-body tr.col-row input[name$=".PropertyName"]')]
                    .map(input => (input.value || '').trim().toLowerCase())
                    .filter(Boolean)
            );

            const missingColumns = metadataItems.filter(col => !existingNames.has(col.name.toLowerCase()));
            if (missingColumns.length === 0) {
                return;
            }

            const maxDisplayOrder = Math.max(
                0,
                ...[...document.querySelectorAll('#columns-body tr.col-row input[name$=".DisplayOrder"]')]
                    .map(input => Number.parseInt(input.value, 10) || 0)
            );

            missingColumns.forEach((column, index) => {
                addColumnRow({
                    propertyName: column.name,
                    defaultLabel: toDefaultLabel(column.name),
                    displayOrder: maxDisplayOrder + index + 1,
                    columnType: column.dataType
                });

                const newRow = document.querySelector(`#columns-body tr.col-row[data-index="${rowIndex - 1}"]`);
                if (newRow) {
                    const deletedInput = newRow.querySelector('.is-deleted-input');
                    if (deletedInput) deletedInput.value = 'true';
                    newRow.querySelectorAll('input[required]').forEach(i => i.removeAttribute('required'));
                    newRow.querySelectorAll('input:not([type="hidden"]), select').forEach(i => i.setAttribute('disabled', 'disabled'));
                    newRow.classList.add('disabled-row');
                    newRow.style.opacity = '0.45';
                    syncRowDragHandleState(newRow);
                    const btn = newRow.querySelector('.btn-remove-col');
                    if (btn) {
                        btn.textContent = 'Enable';
                        btn.classList.remove('btn-outline-warning');
                        btn.classList.add('btn-outline-success');
                    }
                }
            });
        }

        databaseInput.addEventListener('change', () => {
            loadSourceObjects('');
            loadSourceProcedures('');
            loadSourceColumnMetadata();
            loadSourceParameters();
        });

        tableInput.addEventListener('change', () => {
            if ((tableInput.value || '').trim()) {
                resetDropdownSelectionByInputId('input-source-sp');
                loadSourceParameters();
                autoGenerateColumnsFromSource();
                return;
            }

            loadSourceColumnMetadata();
        });

        spInput.addEventListener('change', () => {
            if ((spInput.value || '').trim()) {
                resetDropdownSelectionByInputId('input-source-table');
                autoGenerateColumnsFromSource();
                return;
            }

            loadSourceColumnMetadata();
            loadSourceParameters();
        });

        sourceParametersList.addEventListener('input', e => {
            if (e.target instanceof HTMLInputElement && e.target.matches('[data-param-default]')) {
                serializeParametersFromUi();
            }
        });

        sourceParametersList.addEventListener('change', e => {
            if (e.target instanceof HTMLSelectElement && e.target.matches('[data-param-mapping]')) {
                serializeParametersFromUi();
            }
        });

        document.getElementById('btn-auto-cols').addEventListener('click', autoGenerateColumnsFromSource);
        document.getElementById('btn-preview').addEventListener('click', previewData);

        if (scheduleDataFileButton) {
            scheduleDataFileButton.addEventListener('click', () => {
                if (!(dataFileId > 0)) {
                    return;
                }

                const scheduleUrl = new URL(scheduleDataFileUrl, window.location.origin);
                const returnUrl = `${window.location.pathname}${window.location.search}`;

                scheduleUrl.searchParams.set('id', String(dataFileId));
                scheduleUrl.searchParams.set('returnUrl', returnUrl);

                window.location.href = scheduleUrl.toString();
            });
        }

        // document.getElementById('data-file-form').addEventListener('submit', e => {
        //     const validationResult = validateRequiredDateFilterColumn();
        //     if (!validationResult.valid) {
        //         e.preventDefault();
        //         alert(validationResult.message);
        //         getVisibleMappingParameterFilterSelects()[0]?.focus();
        //     }
        // });

        initializeSearchableDropdown({
            hiddenInput: databaseInput,
            toggleButton: document.getElementById('btn-source-database'),
            optionsContainer: document.getElementById('options-source-database'),
            searchInput: document.getElementById('search-source-database'),
            placeholder: '-- Select database --'
        });

        initializeSearchableDropdown({
            hiddenInput: tableInput,
            toggleButton: document.getElementById('btn-source-table'),
            optionsContainer: document.getElementById('options-source-table'),
            searchInput: document.getElementById('search-source-table'),
            placeholder: '-- Select table or view --'
        });

        initializeSearchableDropdown({
            hiddenInput: spInput,
            toggleButton: document.getElementById('btn-source-sp'),
            optionsContainer: document.getElementById('options-source-sp'),
            searchInput: document.getElementById('search-source-sp'),
            placeholder: '-- Select stored procedure --'
        });

        loadSourceObjects(tableInput.value);
        loadSourceProcedures(spInput.value);
        syncMissingColumnsFromSource();
        loadSourceParameters();
        document.querySelectorAll('#columns-body tr.col-row').forEach(syncRowDragHandleState);
        refreshProcessDataColumnOptions();
        refreshProcessDataClientCodeColumnOptions();
        refreshMappingParameterInputTypes();
        syncMappingParameterFilterOptions();

        const departmentCollapseEl = document.getElementById('department-card-body');
        const departmentCollapseToggle = departmentCollapseEl?.previousElementSibling?.querySelector('[data-bs-target="#department-card-body"]');
        if (departmentCollapseEl && departmentCollapseToggle) {
            departmentCollapseEl.addEventListener('hide.bs.collapse', () => { departmentCollapseToggle.innerHTML = '&#9660;'; });
            departmentCollapseEl.addEventListener('show.bs.collapse', () => { departmentCollapseToggle.innerHTML = '&#9650;'; });
        }

    </script>
}
