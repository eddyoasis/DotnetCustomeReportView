@model DataWarehousePower.Models.DataFileManageFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? $"Edit Data File - {Model.DataFileName}" : "New Data File";
}

@* <div class="d-flex align-items-center gap-2 mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><- Back</a>
    <h4 class="mb-0">@(isEdit ? "Edit Data File" : "New Data File")</h4>
</div> *@

<div class="d-flex align-items-center justify-content-between mb-3">
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><- Back</a>
        <h4 class="mb-0">@(isEdit ? "Edit Data File" : "New Data File")</h4>
    </div>

    @if (isEdit)
    {
        <form asp-action="Delete" asp-route-id="@Model.Id"
              method="post" class="d-inline"
              onsubmit="return confirm('Delete data file \'@Model.DataFileName\'? This cannot be undone.');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
        </form>
    }
</div>

<form asp-action="Save" method="post" id="data-file-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="All" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

    <div class="card shadow-sm mb-4">
        <div class="card-header fw-semibold">Data File Details</div>
        <div class="card-body row g-3">

            <div class="col-md-6">
                <label asp-for="DataFileName" class="form-label"></label>
                <input asp-for="DataFileName" class="form-control" placeholder="e.g. Sales Data File" />
                <span asp-validation-for="DataFileName" class="text-danger small"></span>
            </div>

            <div hidden="@(!Model.IsITDepartment)" class="col-md-3">
                <label asp-for="SourceDatabase" class="form-label"></label>
                <div class="dropdown searchable-source-dropdown" id="source-database-dropdown" data-bs-auto-close="outside">
                    <input asp-for="SourceDatabase" type="hidden" class="source-input" id="input-source-database" />
                    <button disabled="@(!Model.IsITDepartment)" class="btn btn-outline-secondary dropdown-toggle w-100 text-start" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="btn-source-database">
                        -- Select database --
                    </button>
                    <div class="dropdown-menu p-2 w-100" aria-labelledby="btn-source-database">
                        <input type="text" class="form-control form-control-sm mb-2 dropdown-search" id="search-source-database" placeholder="Search database..." autocomplete="off" />
                        <div class="dropdown-options" id="options-source-database" style="max-height:220px; overflow:auto;">
                            <button type="button" class="dropdown-item dropdown-option" data-value="">-- Select database --</button>
                            @foreach (var databaseName in Model.SourceDatabaseOptions)
                            {
                                <button type="button" class="dropdown-item dropdown-option" data-value="@databaseName">@databaseName</button>
                            }
                        </div>
                    </div>
                </div>
                <div class="form-text">Loaded from the connected SQL Server database list.</div>
            </div>

            <div class="col-md-3">
                <label asp-for="SourceTable" class="form-label"></label>
                <div class="dropdown searchable-source-dropdown" id="source-table-dropdown" data-bs-auto-close="outside">
                    <input asp-for="SourceTable" type="hidden" class="source-input" id="input-source-table" />
                    <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="btn-source-table">
                        -- Select table or view --
                    </button>
                    <div class="dropdown-menu p-2 w-100" aria-labelledby="btn-source-table">
                        <input type="text" class="form-control form-control-sm mb-2 dropdown-search" id="search-source-table" placeholder="Search table or view..." autocomplete="off" />
                        <div class="dropdown-options" id="options-source-table" style="max-height:220px; overflow:auto;">
                            <button type="button" class="dropdown-item dropdown-option" data-value="">-- Select table or view --</button>
                            @foreach (var sourceObjectName in Model.SourceTableOptions)
                            {
                                <button type="button" class="dropdown-item dropdown-option" data-value="@sourceObjectName">@sourceObjectName</button>
                            }
                        </div>
                    </div>
                </div>
                <div class="form-text">Loaded from the selected source database tables and views.</div>
            </div>

            <div class="col-md-3" hidden>
                <label asp-for="SourceSP" class="form-label"></label>
                <div class="dropdown searchable-source-dropdown" id="source-sp-dropdown" data-bs-auto-close="outside">
                    <input asp-for="SourceSP" type="hidden" class="source-input" id="input-source-sp" />
                    <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="btn-source-sp">
                        -- Select stored procedure --
                    </button>
                    <div class="dropdown-menu p-2 w-100" aria-labelledby="btn-source-sp">
                        <input type="text" class="form-control form-control-sm mb-2 dropdown-search" id="search-source-sp" placeholder="Search stored procedure..." autocomplete="off" />
                        <div class="dropdown-options" id="options-source-sp" style="max-height:220px; overflow:auto;">
                            <button type="button" class="dropdown-item dropdown-option" data-value="">-- Select stored procedure --</button>
                            @foreach (var sourceProcedureName in Model.SourceSPOptions)
                            {
                                <button type="button" class="dropdown-item dropdown-option" data-value="@sourceProcedureName">@sourceProcedureName</button>
                            }
                        </div>
                    </div>
                </div>
                <div class="form-text">Loaded from the selected source database stored procedures.</div>
            </div>

            <div class="col-md-12" hidden>
                <input asp-for="Parameters" type="hidden" id="input-parameters" />
                <label class="form-label">Parameters</label>
                <div id="source-parameters-list" class="border rounded p-2 bg-light-subtle">
                    <div id="source-parameters-empty" class="text-muted small">No required parameters detected for this source.</div>
                </div>
                <div class="form-text">Detected from selected source object. Set defaults and optional mapping keys (ClientCode, FilterDateFrom, FilterDateTo).</div>
            </div>

            <div hidden class="col-md-12">
                <div class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="chk-active" />
                    <label class="form-check-label" for="chk-active">
                        Active <span class="text-muted small">(inactive data files are hidden from lists)</span>
                    </label>
                </div>
            </div>
        </div>
    </div>

     <div hidden class="card shadow-sm mb-4">
        <div class="card-header fw-semibold d-flex align-items-center justify-content-between">
            Departments
            <span class="text-muted">
                (Select departments allowed to view this data file. Leave all unchecked to allow all departments.)
            </span>
            <button class="btn btn-sm btn-link p-0 text-decoration-none text-muted"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#department-card-body"
                    aria-expanded="false"
                    aria-controls="department-card-body">
                &#9660;
            </button>
        </div>
        <div id="department-card-body" class="collapse">
        <div class="card-body row g-3">
            <div class="col-md-12">
                @* <label asp-for="Departments" class="form-label"></label> *@
                <input asp-for="Departments" type="hidden" />

                @if (Model.ActiveDepartmentOptions.Any())
                {
                    <div class="row row-cols-1 row-cols-md-3 g-2">
                        @foreach (var department in Model.ActiveDepartmentOptions)
                        {
                            var isChecked = Model.SelectedDepartmentIds.Contains(department.Id);
                            <div class="col">
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="SelectedDepartmentIds"
                                           id="dept-@department.Id"
                                           value="@department.Id"
                                    @(isChecked ? "checked" : null) />
                                    <label class="form-check-label" for="dept-@department.Id">@department.Name</label>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-muted small">No active departments available.</div>
                }

                @* <div class="form-text">Select departments allowed to view this data file. Leave all unchecked to allow all departments.</div> *@
                <span asp-validation-for="Departments" class="text-danger small"></span>
            </div>
        </div>
        </div>
     </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
            <span>Columns</span>
            <div class="d-flex gap-2 d-none">
                <button type="button" id="btn-auto-cols" class="btn btn-outline-secondary btn-sm">Auto Generate</button>
                <button type="button" id="btn-add-col" class="btn btn-outline-primary btn-sm">+ Add Column</button>
            </div>
        </div>
        <div class="card-body p-0">
            <table class="table table-bordered mb-0" id="columns-table">
                <thead class="table-light">
                    <tr>
                        <th style="width:52px;" class="text-center">Drag</th>
                        <th style="width:36px;" class="text-center">#</th>
                        <th>Property Name <span class="text-muted small">(DB column)</span></th>
                        <th>Default Label <span class="text-muted small">(UI header)</span></th>
                        <th>Mapping Parameter <span class="text-muted small">(optional filter value)</span></th>
                        @* <th>Mapping Parameter Filter <span class="text-muted small">(optional filter value)</span></th> *@
                        @* <th style="width:110px;">Display Order</th> *@
                        @* <th style="width:70px;"></th> *@
                        <th style="width:70px;"></th>
                    </tr>
                </thead>
                <tbody id="columns-body">
                    @for (int i = 0; i < Model.Columns.Count; i++)
                    {
                        <tr class="col-row" data-index="@i">
                            <td class="text-center align-middle">
                                <span class="drag-handle text-muted" draggable="true" title="Drag to reorder">::</span>
                            </td>
                            <td class="text-center text-muted small row-num align-middle">@(i + 1)</td>
                            <td>
                                <input type="hidden" name="Columns[@i].Id" value="@Model.Columns[i].Id" />
                                <input type="hidden" name="Columns[@i].IsDeleted" value="false" class="is-deleted-input" />
                                <input type="hidden" name="Columns[@i].PropertyType" value="@Model.Columns[i].PropertyType" class="property-type-input" />
                                <input name="Columns[@i].PropertyName"
                                       value="@Model.Columns[i].PropertyName"
                                       class="form-control form-control-sm"
                                       placeholder="e.g. SaleAmount" required readonly />
                            </td>
                            <td>
                                <input name="Columns[@i].DefaultLabel"
                                       value="@Model.Columns[i].DefaultLabel"
                                       class="form-control form-control-sm"
                                       placeholder="e.g. Sale Amount" required />
                            </td>
                            <td class="mapping-parameter-cell">
                                <input name="Columns[@i].MappingParameter"
                                       value="@Model.Columns[i].MappingParameter"
                                       type="hidden"
                                       class="mapping-parameter-input" />
                                <div class="mapping-parameter-editor"></div>
                            </td>
                            <td hidden>
                                <select name="Columns[@i].MappingParameterFilter" class="form-select form-select-sm">
                                    <option value="" selected="@(string.IsNullOrWhiteSpace(Model.Columns[i].MappingParameterFilter) ? "selected" : null)">-- None --</option>
                                    <option value="ClientCode" selected="@(Model.Columns[i].MappingParameterFilter == "ClientCode" ? "selected" : null)">ClientCode</option>
                                    <option value="FilterDateFrom,FilterDateTo" selected="@(Model.Columns[i].MappingParameterFilter == "FilterDateFrom,FilterDateTo" ? "selected" : null)">FilterDateRange (From + To)</option>
                                </select>
                            </td>
                            @* <td>
                                <input name="Columns[@i].MappingParameterFilter"
                                       value="@Model.Columns[i].MappingParameterFilter"
                                       class="form-control form-control-sm"
                                       placeholder="e.g. Active" />
                            </td> *@
                            <td hidden>
                                <input name="Columns[@i].DisplayOrder"
                                       value="@Model.Columns[i].DisplayOrder"
                                       type="number" min="1" max="999"
                                       class="form-control form-control-sm" required />
                            </td>
                            <td hidden class="text-center align-middle">
                                <button type="button" class="btn btn-outline-primary btn-sm btn-add-col-inline" aria-label="Add column">+</button>
                            </td>
                            <td class="text-center align-middle">
                                <button type="button" class="btn btn-outline-warning btn-sm btn-remove-col">Disable</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="no-cols-msg" class="text-center text-muted p-3 small"
                 style="display:@(Model.Columns.Any() ? "none" : "block")">
                No columns yet. Click <strong>+ Add Column</strong>.
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
            <span>Process Data Columns</span>
        </div>
        <div class="card-body">
            <div class="d-flex gap-2">
                <div>
                    <label asp-for="FilterDateColumn" class="form-label"></label>
                    <select asp-for="FilterDateColumn" id="process-data-column-select" class="form-select form-select-sm">
                        @for (int i = 0; i < Model.Columns.Count; i++)
                        {
                            @* <option value="">-- None --</option> *@
                            <option value="@Model.Columns[i].PropertyName">@Model.Columns[i].PropertyName</option>
                        }
                    </select>
                </div>
                <div>
                    <label asp-for="FilterClientCodeColumn" class="form-label"></label>
                    <select asp-for="FilterClientCodeColumn" id="process-data-clientcode-column-select" class="form-select form-select-sm">
                        @for (int i = 0; i < Model.Columns.Count; i++)
                        {
                            <option value="">-- None --</option>
                            <option value="@Model.Columns[i].PropertyName">@Model.Columns[i].PropertyName</option>
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
            <span>Preview</span>
            <div class="d-flex align-items-center gap-2">
                <label for="preview-take" class="small text-muted mb-0">Rows</label>
                <select id="preview-take" class="form-select form-select-sm" style="width:90px;">
                    <option value="10" selected>10</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
                <button type="button" id="btn-preview" class="btn btn-outline-success btn-sm">Preview</button>
                <button type="button"
                        id="btn-schedule-data-file"
                        class="btn btn-outline-primary btn-sm"
                        @(!isEdit ? "disabled" : null)
                        title="@(!isEdit ? "Save the data file first to enable scheduling." : "")">
                    Schedule Data File
                </button>
            </div>
        </div>
        <div class="card-body">
            <div id="preview-status" class="text-muted small mb-2">Click Preview to load sample rows from the selected source.</div>
            <div class="table-responsive" id="preview-table-wrap" style="display:none;">
                <table class="table table-sm table-bordered align-middle mb-0" id="preview-table">
                    <thead class="table-light" id="preview-table-head"></thead>
                    <tbody id="preview-table-body"></tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">@(isEdit ? "Save Changes" : "Create Data File")</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <script>
        let rowIndex = @Model.Columns.Count;

        function addColumnRow(seed) {
            const body = document.getElementById('columns-body');
            const tr = document.createElement('tr');
            tr.className = 'col-row';
            tr.dataset.index = rowIndex;
            const currentVisibleRows = body.querySelectorAll('tr.col-row:not(.deleted-row):not(.disabled-row)').length;
            const displayOrder = seed?.displayOrder ?? (currentVisibleRows + 1);
            tr.innerHTML = `
                <td class="text-center align-middle">
                    <span class="drag-handle text-muted" draggable="true" title="Drag to reorder">::</span>
                </td>
                <td class="text-center text-muted small row-num align-middle">${currentVisibleRows + 1}</td>
                <td>
                    <input type="hidden" name="Columns[${rowIndex}].Id" value="0" />
                    <input type="hidden" name="Columns[${rowIndex}].IsDeleted" value="false" class="is-deleted-input" />
                    <input type="hidden" name="Columns[${rowIndex}].PropertyType" value="${seed?.columnType || ''}" class="property-type-input" />
                    <input readonly name="Columns[${rowIndex}].PropertyName" class="form-control form-control-sm" placeholder="e.g. SaleAmount" required />
                </td>
                <td>
                    <input name="Columns[${rowIndex}].DefaultLabel" class="form-control form-control-sm" placeholder="e.g. Sale Amount" required />
                </td>
                <td class="mapping-parameter-cell">
                    <input name="Columns[${rowIndex}].MappingParameter"
                           class="mapping-parameter-input"
                           type="hidden" />
                    <div class="mapping-parameter-editor"></div>
                </td>
                <td hidden>
                    <select name="Columns[${rowIndex}].MappingParameterFilter" class="form-select form-select-sm">
                        <option value="" selected>-- None --</option>
                        <option value="ClientCode">ClientCode</option>
                        <option value="FilterDateFrom,FilterDateTo">FilterDateRange (From + To)</option>
                    </select>
                </td>
                <td hidden>
                    <input name="Columns[${rowIndex}].DisplayOrder" type="number" min="1" max="999" value="${displayOrder}" class="form-control form-control-sm" required />
                </td>
                <td class="text-center align-middle">
                    <button type="button" class="btn btn-outline-warning btn-sm btn-remove-col">Disable</button>
                </td>`;
            body.appendChild(tr);

            const propertyInput = tr.querySelector('input[name$=".PropertyName"]');
            const labelInput = tr.querySelector('input[name$=".DefaultLabel"]');
            const mappingInput = tr.querySelector('input[name$=".MappingParameter"]');
            const mappingFilterInput = tr.querySelector('[name$=".MappingParameterFilter"]');
            if (propertyInput && seed?.propertyName) propertyInput.value = seed.propertyName;
            if (labelInput && seed?.defaultLabel) labelInput.value = seed.defaultLabel;
            if (seed?.columnType) tr.dataset.columnType = seed.columnType;
            if (mappingInput && seed?.mappingParameter) mappingInput.value = seed.mappingParameter;
            if (mappingFilterInput && seed?.mappingParameterFilter) mappingFilterInput.value = seed.mappingParameterFilter;
            syncRowDragHandleState(tr);

            rowIndex++;
            refreshRowNumbers();
            toggleNoColsMessage();
            refreshMappingParameterInputTypes();
            syncMappingParameterFilterOptions();
            if (!seed) {
                tr.querySelector('input[name$=".PropertyName"]').focus();
            }
        }

        function getVisibleMappingParameterFilterSelects() {
            return [...document.querySelectorAll('#columns-body tr.col-row:not(.deleted-row):not(.disabled-row) select[name$=".MappingParameterFilter"]')];
        }

        function canUseRangeFilterForRow(tr) {
            const propertyInput = tr?.querySelector('input[name$=".PropertyName"]');
            const propertyTypeInput = tr?.querySelector('input[name$=".PropertyType"]');
            const propertyName = (propertyInput?.value || '').trim();
            const metadataType = sourceColumnTypeLookup.get(propertyName.toLowerCase()) || '';
            const postedType = propertyTypeInput instanceof HTMLInputElement
                ? (propertyTypeInput.value || '').trim()
                : '';
            const columnType = (tr?.dataset?.columnType || '').trim() || metadataType || postedType;
            const targetType = inferMappingInputType(propertyName, columnType);

            return targetType === 'datetime-local' ||
                targetType === 'decimal-range' ||
                targetType === 'number';
        }

        function syncMappingParameterFilterOptions() {
            const rows = [...document.querySelectorAll('#columns-body tr.col-row:not(.deleted-row):not(.disabled-row)')];
            rows.forEach(tr => {
                const select = tr.querySelector('select[name$=".MappingParameterFilter"]');
                if (!(select instanceof HTMLSelectElement)) {
                    return;
                }

                const rangeOption = [...select.options].find(option => (option.value || '').trim() === 'FilterDateFrom,FilterDateTo');
                if (!rangeOption) {
                    return;
                }

                const canUseRange = canUseRangeFilterForRow(tr);
                rangeOption.disabled = !canUseRange;
                if (!canUseRange && (select.value || '').trim() === 'FilterDateFrom,FilterDateTo') {
                    select.value = '';
                }
            });

            const selects = getVisibleMappingParameterFilterSelects();
            const selectedValues = new Set(
                selects
                    .map(select => (select.value || '').trim())
                    .filter(Boolean)
            );

            selects.forEach(select => {
                const currentValue = (select.value || '').trim();

                [...select.options].forEach(option => {
                    const value = (option.value || '').trim();
                    if (!value) {
                        option.disabled = false;
                        return;
                    }

                    option.disabled = value !== currentValue && selectedValues.has(value);
                });
            });
        }

        document.getElementById('btn-add-col').addEventListener('click', addColumnRow);
        document.getElementById('columns-body').addEventListener('click', e => {
            if (e.target.closest('.btn-add-col-inline')) {
                addColumnRow();
            }
        });

        document.getElementById('columns-body').addEventListener('input', e => {
            if (!(e.target instanceof HTMLInputElement)) return;
            if (!e.target.matches('input[name$=".PropertyName"]')) return;
            refreshProcessDataColumnOptions();
            refreshProcessDataClientCodeColumnOptions();
            refreshMappingParameterInputTypes();
        });

        document.getElementById('columns-body').addEventListener('change', e => {
            if (!(e.target instanceof HTMLSelectElement)) return;
            if (!e.target.matches('select[name$=".MappingParameterFilter"]')) return;
            syncMappingParameterFilterOptions();
        });

        document.getElementById('columns-body').addEventListener('click', e => {
            const btn = e.target.closest('.btn-remove-col');
            if (!btn) return;
            const tr = btn.closest('tr');
            const deletedInput = tr.querySelector('.is-deleted-input');

            const isCurrentlyDisabled = tr.classList.contains('disabled-row');

            if (isCurrentlyDisabled) {
                // Re-enable the row
                if (deletedInput) deletedInput.value = 'false';
                tr.querySelectorAll('input:not([type="hidden"]), select').forEach(i => i.removeAttribute('disabled'));
                tr.querySelectorAll('input[name$=".PropertyName"], input[name$=".DefaultLabel"], input[name$=".DisplayOrder"]').forEach(i => i.setAttribute('required', ''));
                tr.classList.remove('disabled-row');
                tr.style.opacity = '';
                btn.textContent = 'Disable';
                btn.classList.remove('btn-outline-success');
                btn.classList.add('btn-outline-warning');
            } else {
                // Disable the row
                if (deletedInput) deletedInput.value = 'true';
                tr.querySelectorAll('input[required]').forEach(i => i.removeAttribute('required'));
                tr.querySelectorAll('input:not([type="hidden"]), select').forEach(i => i.setAttribute('disabled', 'disabled'));
                tr.classList.add('disabled-row');
                tr.style.opacity = '0.45';
                btn.textContent = 'Enable';
                btn.classList.remove('btn-outline-warning');
                btn.classList.add('btn-outline-success');
            }

            syncRowDragHandleState(tr);
            refreshRowNumbers();
            toggleNoColsMessage();
            refreshMappingParameterInputTypes();
            syncMappingParameterFilterOptions();
        });

        function syncRowDragHandleState(tr) {
            const handle = tr?.querySelector('.drag-handle');
            if (!(handle instanceof HTMLElement)) {
                return;
            }

            const reorderable = !tr.classList.contains('deleted-row') && !tr.classList.contains('disabled-row');
            handle.setAttribute('draggable', reorderable ? 'true' : 'false');
            handle.style.cursor = reorderable ? 'grab' : 'not-allowed';
            handle.classList.toggle('opacity-50', !reorderable);
        }

        function refreshRowNumbers() {
            let n = 1;
            document.querySelectorAll('#columns-body tr.col-row:not(.deleted-row):not(.disabled-row)').forEach(tr => {
                tr.querySelector('.row-num').textContent = n++;

                const displayOrderInput = tr.querySelector('input[name$=".DisplayOrder"]');
                if (displayOrderInput instanceof HTMLInputElement) {
                    displayOrderInput.value = tr.querySelector('.row-num').textContent;
                }
            });

            refreshProcessDataColumnOptions();
            refreshProcessDataClientCodeColumnOptions();
        }

        function toggleNoColsMessage() {
            const visible = document.querySelectorAll('#columns-body tr.col-row:not(.deleted-row):not(.disabled-row)').length;
            document.getElementById('no-cols-msg').style.display = visible === 0 ? 'block' : 'none';
        }

        function refreshProcessDataColumnOptions() {
            const select = document.getElementById('process-data-column-select');
            if (!(select instanceof HTMLSelectElement)) {
                return;
            }

            const currentValue = (select.value || '').trim();
            const visibleRows = [...document.querySelectorAll('#columns-body tr.col-row:not(.deleted-row):not(.disabled-row)')];
            
            // Only include options where columnType === 'date'
            const options = visibleRows
