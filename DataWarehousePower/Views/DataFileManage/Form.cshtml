            textInput.addEventListener('input', () => {
                mappingInput.value = textInput.value;
            });

            editor.appendChild(textInput);
        }

        function renderDateRangeMappingEditor(mappingCell, mappingInput) {
            const editor = mappingCell.querySelector('.mapping-parameter-editor');
            if (!editor) {
                return;
            }

            editor.innerHTML = '';
            const parsed = parseDateRangeMappingValue(mappingInput.value || '');

            const wrapper = document.createElement('div');
            wrapper.className = 'd-flex flex-column gap-1';

            const startInput = document.createElement('input');
            startInput.type = 'datetime-local';
            startInput.className = 'form-control form-control-sm';
            startInput.placeholder = 'Start date and time';
            startInput.value = parsed.start;

            const endInput = document.createElement('input');
            endInput.type = 'datetime-local';
            endInput.className = 'form-control form-control-sm';
            endInput.placeholder = 'End date and time';
            endInput.value = parsed.end;

            const syncValue = () => {
                mappingInput.value = buildDateRangeMappingValue(startInput.value, endInput.value);
            };

            startInput.addEventListener('input', syncValue);
            endInput.addEventListener('input', syncValue);

            wrapper.appendChild(startInput);
            wrapper.appendChild(endInput);
            editor.appendChild(wrapper);
            syncValue();
        }

        function renderDecimalMappingEditor(mappingCell, mappingInput) {
            const editor = mappingCell.querySelector('.mapping-parameter-editor');
            if (!editor) {
                return;
            }

            editor.innerHTML = '';
            const parsed = parseDecimalRangeMappingValue(mappingInput.value || '');

            const wrapper = document.createElement('div');
            wrapper.className = 'd-flex flex-column gap-1';

            const fromInput = document.createElement('input');
            fromInput.type = 'number';
            fromInput.className = 'form-control form-control-sm';
