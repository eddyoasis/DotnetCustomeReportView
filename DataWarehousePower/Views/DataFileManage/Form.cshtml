                opt.textContent = option.text;
                select.appendChild(opt);
            });

            const normalized = (mappingInput.value || '').trim().toLowerCase();
            select.value = normalized === 'true' || normalized === 'false' ? normalized : '';

            const syncValue = () => {
                mappingInput.value = select.value;
            };

            select.addEventListener('change', syncValue);

            wrapper.appendChild(select);
            editor.appendChild(wrapper);
            syncValue();
