        function refreshMappingParameterInputTypes() {
            document.querySelectorAll('#columns-body tr.col-row:not(.deleted-row):not(.disabled-row)').forEach(tr => {
                const propertyInput = tr.querySelector('input[name$=".PropertyName"]');
                const mappingInput = tr.querySelector('input[name$=".MappingParameter"]');
                const mappingCell = tr.querySelector('.mapping-parameter-cell');
                if (!(mappingInput instanceof HTMLInputElement) || !(mappingCell instanceof HTMLElement)) {
                    return;
                }

                const propertyName = (propertyInput?.value || '').trim();
                const metadataType = sourceColumnTypeLookup.get(propertyName.toLowerCase()) || '';
                const propertyTypeInput = tr.querySelector('input[name$=".PropertyType"]');
                const postedType = propertyTypeInput instanceof HTMLInputElement
                    ? (propertyTypeInput.value || '').trim()
                    : '';
                const columnType = (tr.dataset.columnType || '').trim() || metadataType || postedType;
                const targetType = inferMappingInputType(propertyName, columnType);
                const previousEditorType = tr.dataset.mappingEditorType || '';
                if (previousEditorType !== targetType || !mappingCell.querySelector('.mapping-parameter-editor')?.children.length) {
                    if (targetType === 'datetime-local') {
                        renderDateRangeMappingEditor(mappingCell, mappingInput);
                    } else if (targetType === 'decimal-range') {
                        renderDecimalMappingEditor(mappingCell, mappingInput);
                    } else if (targetType === 'number') {
                        renderNumberMappingEditor(mappingCell, mappingInput);
                    } else if (targetType === 'boolean') {
                        renderBooleanMappingEditor(mappingCell, mappingInput);
                    } else {
                        renderTextMappingEditor(mappingCell, mappingInput);
                    }
                    tr.dataset.mappingEditorType = targetType;
                }

                tr.dataset.columnType = columnType;
                if (propertyTypeInput instanceof HTMLInputElement) {
                    propertyTypeInput.value = columnType;
                }
            });
        }

        function validateRequiredMappingParameters() {
            const selectedSourceTable = (document.getElementById('input-source-table')?.value || '').trim();
            const selectedSourceSP = (document.getElementById('input-source-sp')?.value || '').trim();
            if (!selectedSourceTable && !selectedSourceSP) {
                return { valid: true, message: '' };
            }

            const requiredValues = ['ClientCode', 'FilterDateFrom', 'FilterDateTo'];
            const selectedValues = [];

            if (selectedSourceTable) {
                getVisibleMappingInputs().forEach(input => {
                    splitMappingAliases(input.value || '').forEach(value => selectedValues.push(value));
                });
            }

            if (selectedSourceSP) {
                getVisibleParameterMappingSelects().forEach(select => {
                    const value = normalizeMappingAlias(select.value || '');
                    if (value) {
                        selectedValues.push(value);
                    }
                });
            }

            for (const requiredValue of requiredValues) {
                if (!selectedValues.includes(requiredValue)) {
                    return {
                        valid: false,
                        message: 'Please map ClientCode, FilterDateFrom, and FilterDateTo before saving the data file.'
                    };
                }
            }

            return { valid: true, message: '' };
        }

        function validateRequiredDateFilterColumn() {
            const selectedSourceTable = (document.getElementById('input-source-table')?.value || '').trim();
            const selectedSourceSP = (document.getElementById('input-source-sp')?.value || '').trim();
            if (!selectedSourceTable && !selectedSourceSP) {
                return { valid: true, message: '' };
            }

            const selectedFilterValues = new Set(
                getVisibleMappingParameterFilterSelects()
                    .map(select => (select.value || '').trim())
                    .filter(Boolean)
            );

            const hasDateFilterColumn = selectedFilterValues.has('FilterDateFrom,FilterDateTo');
            const hasClientCodeFilterColumn = selectedFilterValues.has('ClientCode');

            if (!hasDateFilterColumn || !hasClientCodeFilterColumn) {
                return {
                    valid: false,
                    message: 'Please select one column for ClientCode and one column for FilterDateFrom/FilterDateTo.'
                };
            }

            return { valid: true, message: '' };
        }

