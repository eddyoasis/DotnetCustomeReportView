            toInput.placeholder = 'To';
            toInput.step = 'any';
            toInput.value = parsed.to;

            const syncValue = () => {
                mappingInput.value = buildDecimalRangeMappingValue(fromInput.value, toInput.value);
            };

            fromInput.addEventListener('input', syncValue);
            toInput.addEventListener('input', syncValue);

            wrapper.appendChild(fromInput);
            wrapper.appendChild(toInput);
            editor.appendChild(wrapper);
            syncValue();
        }

        function renderNumberMappingEditor(mappingCell, mappingInput) {
            const editor = mappingCell.querySelector('.mapping-parameter-editor');
            if (!editor) {
                return;
            }

            editor.innerHTML = '';

            const numberInput = document.createElement('input');
            numberInput.type = 'number';
            numberInput.className = 'form-control form-control-sm';
            numberInput.placeholder = 'Number';
            numberInput.step = '1';
            numberInput.value = parseNumberMappingValue(mappingInput.value || '');

            numberInput.addEventListener('input', () => {
                mappingInput.value = normalizeIntegerValue(numberInput.value);
            });

            editor.appendChild(numberInput);
