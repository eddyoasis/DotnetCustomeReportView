@model DataWarehousePower.Models.DataFileManageListViewModel
@{
    ViewData["Title"] = "Manage Data Files";
    var departmentLookup = ViewData["DepartmentLookup"] as Dictionary<int, string> ?? new Dictionary<int, string>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Manage Data Files</h4>
    <a asp-action="Create" class="btn btn-primary btn-sm">+ New Data File</a>
</div>

<form method="get" asp-action="Index" class="card card-body shadow-sm mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-8">
            <label class="form-label">Search</label>
            <input class="form-control" type="text" name="search" value="@Model.Filter.Search" placeholder="name, source, department, or column" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Status</label>
            <select class="form-select" name="isActive">
                <option value="">All</option>
                <option value="true" selected="@(Model.Filter.IsActive == true)">Active</option>
                <option value="false" selected="@(Model.Filter.IsActive == false)">Inactive</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </div>
</form>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.DataFiles.Any())
{
    @if (string.IsNullOrWhiteSpace(Model.Filter.Search) && !Model.Filter.IsActive.HasValue)
    {
        <div class="alert alert-info">No data files defined yet. Click <strong>+ New Data File</strong> to get started.</div>
    }
    else
    {
        <div class="alert alert-info">No data files match the selected filters.</div>
    }
}
else
{
    <div class="table-responsive shadow-sm">
        <table class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th style="width:40px;">#</th>
                    <th>Data File Name</th>
                    <th>Source Database</th>
                    <th>Source Table</th>
                    <th>Source SP</th>
                    <th>Departments</th>
                    <th>Columns</th>
                    <th style="width:90px;" class="text-center">Active</th>
                    <th style="width:160px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var dataFile in Model.DataFiles)
                {
                    <tr class="@(dataFile.IsActive ? "" : "table-secondary text-muted")">
                        <td class="text-muted small">@dataFile.Id</td>
                        <td>                            
                            <a asp-controller="DataFile" asp-action="Index" asp-route-id="@dataFile.Id"
                               class="fw-semibold text-decoration-none">@dataFile.DataFileName</a>
                        </td>
                        <td>@(string.IsNullOrEmpty(dataFile.SourceDatabase) ? "-" : dataFile.SourceDatabase)</td>
                        <td>@(string.IsNullOrEmpty(dataFile.SourceTable) ? "-" : dataFile.SourceTable)</td>
                        <td>@(string.IsNullOrEmpty(dataFile.SourceSP) ? "-" : dataFile.SourceSP)</td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(dataFile.Departments))
                            {
                                @:All
                            }
                            else
                            {
                                var tokens = dataFile.Departments
                                    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                                var displayNames = tokens
                                    .Select(token => int.TryParse(token, out int id)
                                        ? (departmentLookup.TryGetValue(id, out var name) ? name : $"Unknown ({id})")
                                        : token)
                                    .ToList();

                                @string.Join(", ", displayNames)
                            }
                        </td>
                        <td>
                            @foreach (var column in dataFile.Columns.OrderBy(column => column.DisplayOrder))
                            {
                                <span class="badge bg-light text-secondary border me-1">@column.PropertyName</span>
                            }
                        </td>
                        <td class="text-center">
                            <form asp-action="ToggleActive" asp-route-id="@dataFile.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="btn btn-sm @(dataFile.IsActive ? "btn-success" : "btn-outline-secondary")"
                                        title="@(dataFile.IsActive ? "Click to deactivate" : "Click to activate")">
                                    @(dataFile.IsActive ? "Active" : "Inactive")
                                </button>
                            </form>
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@dataFile.Id" class="btn btn-outline-primary btn-sm me-1">Edit</a>
                            <form asp-action="Delete" asp-route-id="@dataFile.Id"
                                  method="post" class="d-inline"
                                  onsubmit="return confirm('Delete data file \'@dataFile.DataFileName\'? This cannot be undone.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
