{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=DataWarehousePower;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DepartmentAuthorization": {
    "AllowedDepartmentsByPage": {
      "Report": [ "Sales", "Information Technology" ],
      "ReportManage": [ "Sales", "Information Technology" ],
      "Auditlog": [ "Information Technology" ]
    }
  },
  "Hangfire": {
    "TimeZoneId": "Singapore Standard Time",
    "DashboardPath": "/hangfire",
    "AuditLogCleanupCron": "0 2 * * *",
    "AuditLogRetentionDays": 90,
    "ScheduledExportOutputDirectory": "ScheduledExports"
  },
  "AllowedHosts": "*"
}
