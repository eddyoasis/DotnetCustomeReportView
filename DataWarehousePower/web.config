<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
	    <security>
		    <requestFiltering>
			    <requestLimits maxQueryString="4096" />
		    </requestFiltering>
	    </security>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!--
        processPath: "dotnet" for framework-dependent deploy; use the full .exe path for self-contained.
        hostingModel: "inprocess" (recommended for perf); change to "outofprocess" if needed.
      -->
      <!--
        hostingModel="outofprocess": IIS acts as a reverse proxy; Kestrel owns the HTTP pipeline.
        This is required for Windows/Negotiate authentication to work correctly with ASP.NET Core
        middleware — the Negotiate handler adds the WWW-Authenticate challenge header itself,
        so UseStatusCodePages can distinguish a live negotiation from a final auth failure.
        With "inprocess", IIS handles the NTLM/Kerberos handshake at kernel level before
        ASP.NET Core middleware runs, making the WWW-Authenticate header check unreliable.
      -->
      <aspNetCore processPath="dotnet" arguments=".\DataWarehousePower.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="InProcess" />
    </system.webServer>
  </location>
</configuration>